//@version=6
// ORACLE RENDER (probe, not the engine): the E1 zone maps printed on page 3 of Trident_Report_2026W14_Mar30-Apr3.pdf, drawn exactly
// as printed, for the week the report names (Mar 30 - Apr 3, 2026). Every number and word below is the report's.
indicator("W14 report E1 zones (exact)", overlay = true, max_boxes_count = 100, max_labels_count = 100)
string TZ = "America/New_York"
int t0 = timestamp(TZ, 2026, 3, 30, 0, 0)
int t1 = timestamp(TZ, 2026, 4, 3, 17, 0)
f_z(float bot, float top, bool sup, string txt) =>
    color c = sup ? color.rgb(242, 54, 69) : color.rgb(8, 153, 129)
    box.new(t0, top, t1, bot, xloc = xloc.bar_time, bgcolor = color.new(c, 78), border_color = c, border_width = 1)
    label.new(t0, (top + bot) / 2, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = color.white, size = size.small)
if barstate.islast
    if str.contains(syminfo.ticker, "DXY")
        f_z(100.50, 100.65, true,  "R1 100.50-100.65 | Supply | BoM | 0 rx | ZFP 10% | 9/14 | 52-week high 100.64")
        f_z(100.00, 100.25, true,  "R2 100.00-100.25 | Supply | MoM | 2 rx | ZFP 25% | 6/14 | Psychological 100.00")
        f_z(99.30,  99.60,  false, "D1 99.30-99.60 | Demand | MoM | 1 rx | ZFP 30% | 6/14 | Prior week mid-range")
        f_z(98.80,  99.10,  false, "D2 98.80-99.10 | Demand | BoM | 0-1 rx | ZFP 20% | 7/14 | Prior week BoM origin")
    else if str.contains(syminfo.ticker, "EUR")
        f_z(1.1600, 1.1640, true,  "R2 1.1600-1.1640 | Supply | BoM | 1 rx | ZFP 15% | 9/14 | 1.1600 Apr 1 SIG MAG")
        f_z(1.1545, 1.1575, true,  "R1 1.1545-1.1575 | Supply | MoM | 1-2 rx | ZFP 30% | 7/14 | 1.1550 Mar 30 SIG MAG")
        f_z(1.1495, 1.1515, false, "D1 1.1495-1.1515 | Demand | MoM | 1-2 rx | ZFP 35% | 8/14 | 1.1500 Mar 31 CRIT WALL + Apr 2 SIG MAG")
        f_z(1.1430, 1.1460, false, "D2 1.1430-1.1460 | Demand | BoM | 0-1 rx | ZFP 20% | 8/14 | Prior weekly support")
    else if str.contains(syminfo.ticker, "GBP")
        f_z(1.3400, 1.3480, true,  "R2 1.3400-1.3480 | Supply | BoM | 1 rx | ZFP 12% | 8/14")
        f_z(1.3300, 1.3350, true,  "R1 1.3300-1.3350 | Supply | MoM | 1-2 rx | ZFP 28% | 6/14")
        f_z(1.3250, 1.3280, false, "D2 1.3250-1.3280 | Demand | MoM | 2 rx | ZFP 32% | 5/14")
        f_z(1.3150, 1.3200, false, "D1 1.3150-1.3200 | Demand | BoM | 0-1 rx | ZFP 22% | 7/14")

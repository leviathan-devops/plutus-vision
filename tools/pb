#!/usr/bin/env bash
# pb - thin helpers over the pinebox CLI for this build (session plutus-main).
#   pb shot NAME [chart|plot]        capture -> evidence/NAME.png (prints the path)
#   pb goto FROM TO [bt]             frame the IDE (or, with bt, the Backtest) chart on [FROM,TO] (ISO dates/times, UTC) through the page's own renderer
#   pb eval 'JS'                     evaluate JS in the page (returns JSON)
#   pb load FILE [PAIR] [TF]         load + run a .pine in the IDE
#   pb x ...                         raw pinebox verb with the session filled in
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH" XDG_RUNTIME_DIR=/run/user/0
S=plutus-main; ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CDP_PORT="$(pinebox list --session $S | jq -r '.instances[0].ports.cdp')"
CORE="$HOME/.omp/agent/extensions/computer-use-v2/core"
ev() { node "$CORE/cdp.mjs" "$CDP_PORT" evaluate "$1" | jq -c 'select(has("value")) | .value'; }
station_idle() { local p; p="$(ss -ltnp 2>/dev/null | grep ':9741 ' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"; [ -n "$p" ] || return 0; [ "$(top -bn1 -p "$p" | tail -1 | awk '{print int($9)}')" -lt 25 ]; }
case "${1:-}" in
  shot) n="$2"; sec="${3:-chart}"; mkdir -p "$ROOT/evidence"; if [ "$sec" = full ]; then secarg=(); else secarg=(--section "$sec"); fi; pinebox shot --session $S --out "$ROOT/evidence/$n.png" "${secarg[@]}" | jq -r '.path' ;;
  eval) ev "$2" ;;
  load) pinebox load --session $S --pine "$2" ${3:+--pair "$3"} ${4:+--tf "$4"} 2>&1 | tail -1 | jq -c '{ok, status:.load.status_row, counts:.load.result.counts, bars:.load.result.bars, err:(.error // null)}' 2>/dev/null || pinebox load --session $S --pine "$2" ${3:+--pair "$3"} ${4:+--tf "$4"} 2>&1 | tail -3 ;;
  goto)
    f="$(date -u -d "$2" +%s)000"; t="$(date -u -d "$3" +%s)000"
    CH="window.PlutusPineShell?.chart"; [ "${4:-ide}" = bt ] && CH="window.PlutusBacktestChart?.api?.chart"
    ev "(function(){const P={chart:$CH}; const r=P?.chart?.rendererControl?.renderer; if(!r) return {absent:true};
      const b=r.bars, n=b.length; let i0=0,i1=n-1; for(let i=0;i<n;i++){ if(b[i].time<$f) i0=i; if(b[i].time<=$t) i1=i; }
      i0=Math.min(i0+1,n-1); const span=Math.max(i1-i0+1,5); const pad=Math.max(2,Math.round(span*0.04));
      r.animator?.stop(); r.panVelocity=0;
      const rt=-(n-1-i1)+pad; const bs=r.coords.width/((span+2*pad)*r.coords.spacingScale);
      let v; try{ v=r.clampViewport(bs, rt); }catch(e){ return {err:String(e)}; }
      r.coords.setViewport(v); r.targetBarSpacing=v.barSpacing; if(r.applyViewport) r.applyViewport(v); else r.requestRender?.();
      const vr=P.chart.getVisibleRange(); return {n,i0,i1,want:{from:$f,to:$t},got:vr,fromISO:new Date(vr.from).toISOString(),toISO:new Date(vr.to).toISOString(),v};})()" ;;
  export)   # pb export FILE [PAIR] [TF]: load in the IDE, press EXPORT TO BACKTEST, wait for the EXPORTED status
    pinebox tab --session $S --to pine >/dev/null; sleep 2
    pinebox load --session $S --pine "$2" --pair "${3:-DXY}" --tf "${4:-1H}" 2>&1 | grep -E "REFUSED|load  " | cut -c1-260
    ev "(function(){const b=document.querySelector('[data-act=export]'); b.click(); return 'clicked';})()" >/dev/null
    for i in $(seq 1 60); do
      st="$(ev "(function(){return [...document.querySelectorAll('.pine-shell *')].filter(e=>e.children.length==0 && /EXPORTED|EXPORT_/.test(e.textContent)).map(e=>e.textContent.slice(0,140)).join(' | ')})()")"
      case "$st" in *EXPORTED*|*EXPORT_*) echo "$st"; break ;; esac; sleep 2
    done ;;
  bt-apply) # pb bt-apply "Indicator Title": on the Backtest chart remove every on-chart script, then add the named one from My Scripts
    pinebox tab --session $S --to backtest >/dev/null; sleep 1
    ev "(async function(){const sl=ms=>new Promise(r=>setTimeout(r,ms)); const vis=e=>{const r=e.getBoundingClientRect(); return r.width>0&&r.height>0;};
      const open=()=>[...document.querySelectorAll('.vela-dialog-title')].some(e=>e.textContent.trim()==='Indicators'&&vis(e));
      if(!open()){ const b=[...document.querySelectorAll('button')].find(b=>/Indicators/.test(b.textContent)&&vis(b)&&b.getBoundingClientRect().y<140&&b.getBoundingClientRect().y>90); if(!b) return {err:'no Indicators button'}; b.click(); await sl(700); }
      let removed=0; for(let k=0;k<6;k++){ const t=[...document.querySelectorAll('.vela-ip-trash')].find(vis); if(!t) break; t.click(); removed++; await sl(500); }
      const inp=[...document.querySelectorAll('input')].find(i=>vis(i)&&/Search/.test(i.placeholder||'')); if(inp){ inp.focus(); inp.value=$(printf '%s' "$2" | jq -Rs .); inp.dispatchEvent(new Event('input',{bubbles:true})); await sl(700); }
      const row=[...document.querySelectorAll('.vela-ip-name')].find(e=>vis(e)&&e.textContent.trim()===$(printf '%s' "$2" | jq -Rs .)); if(!row) return {err:'script not in list',removed};
      (row.closest('button,[role=button],.vela-ip-row')||row.parentElement).click(); await sl(700);
      const onchart=[...document.querySelectorAll('.vela-ip-trash')].filter(vis).length;
      const c=[...document.querySelectorAll('.vela-dialog-close')].find(vis); if(c) c.click();
      return {removed,onchart};})()" ;;
  wait-engine) # pb wait-engine: block until the station engine has finished computing (bounded: 4 minutes)
    for i in $(seq 1 80); do sleep 3; station_idle && { sleep 2; station_idle && { echo idle; exit 0; }; }; done; echo "still busy"; exit 1 ;;
  x) shift; v="$1"; shift; pinebox "$v" --session $S "$@" ;;
  *) sed -n 2,8p "$0" ;;
esac

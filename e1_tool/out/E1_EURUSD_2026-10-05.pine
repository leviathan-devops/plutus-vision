    if show_e3
        // EU1 Mon SS SHORT E 1.12585 SL 1.12742 TP 1.11725 RRR 5.48 | Swing Scalp / London Open | entry 30m order block bottom + 1 pip (F1-A); SL (a) 3 pips outside the extended sweep range (P533 7.1 Rule 2.5; E3C:1027) [ZR-6B safety, mirror confidence 1.00]; TP bounding sweep zone near edge (rule 5; P533 7.1 Rule 3 LSZ edge)
        e3a0 = not na(e3E0) ? e3E0 - e3bw : 1791180000000
        e3b0 = not na(e3E0) ? (na(e3X0) ? time : e3X0) + e3bw : 1791180000000 + 3 * e3bw
        box.new(e3a0, 1.12742, e3b0, 1.12585, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E0) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)

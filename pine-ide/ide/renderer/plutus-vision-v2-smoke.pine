dailyLevelsColorInput           = input.color(BLUE, '', group = LEVELS_GROUP, inline = 'daily')
showWeeklyLevelsInput           = input.bool(false, 'Weekly', group = LEVELS_GROUP, inline = 'weekly')
weeklyLevelsStyleInput          = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'weekly',  options = [SOLID,DASHED,DOTTED])
weeklyLevelsColorInput          = input.color(BLUE, '', group = LEVELS_GROUP, inline = 'weekly')
showMonthlyLevelsInput          = input.bool(false, 'Monthly', group = LEVELS_GROUP, inline = 'monthly')
monthlyLevelsStyleInput         = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'monthly', options = [SOLID,DASHED,DOTTED])
monthlyLevelsColorInput         = input.color(BLUE, '', group = LEVELS_GROUP, inline = 'monthly')

showPremiumDiscountZonesInput   = input.bool(false, 'Premium/Discount Zones', group = ZONES_GROUP, tooltip = showPremiumDiscountZonesTooltip)
premiumZoneColorInput           = input.color(  RED,        'Premium Zone',             group = ZONES_GROUP)
equilibriumZoneColorInput       = input.color(  GRAY,       'Equilibrium Zone',         group = ZONES_GROUP)
discountZoneColorInput          = input.color(  GREEN,      'Discount Zone',            group = ZONES_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
// @type                            UDT representing pv_alerts as bool fields
// @field internalBullishBOS        internal structure custom alert
// @field internalBearishBOS        internal structure custom alert
// @field internalBullishCHoCH      internal structure custom alert
// @field internalBearishCHoCH      internal structure custom alert
// @field swingBullishBOS           swing structure custom alert
// @field swingBearishBOS           swing structure custom alert
// @field swingBullishCHoCH         swing structure custom alert
// @field swingBearishCHoCH         swing structure custom alert
// @field internalBullishOrderBlock internal order block custom alert
// @field internalBearishOrderBlock internal order block custom alert
// @field swingBullishOrderBlock    swing order block custom alert
// @field swingBearishOrderBlock    swing order block custom alert
// @field equalHighs                equal high low custom alert
// @field equalLows                 equal high low custom alert
// @field bullishFairValueGap       fair value gap custom alert
// @field bearishFairValueGap       fair value gap custom alert
type pv_alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

// @type                            UDT representing last swing extremes (top & bottom)
// @field top                       last top swing price
// @field bottom                    last bottom swing price
// @field barTime                   last swing bar time
// @field barIndex                  last swing bar index
// @field lastTopTime               last top swing time
// @field lastBottomTime            last bottom swing time
type pv_trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

// @type                            UDT representing Fair Value Gaps
// @field top                       top price
// @field bottom                    bottom price
// @field bias                      bias (BULLISH or BEARISH)
// @field topBox                    top box
// @field bottomBox                 bottom box
type pv_fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

// @type                            UDT representing pv_trend bias
// @field bias                      BULLISH or BEARISH
type pv_trend
    int bias    

// @type                            UDT representing Equal Highs Lows display
// @field l_ine                     displayed line
// @field l_abel                    displayed label
type pv_equalDisplay
    line l_ine      = na
    label l_abel    = na

// @type                            UDT representing a pv_pivot point (swing point) 
// @field currentLevel              current price level
// @field lastLevel                 last price level
// @field crossed                   true if price level is crossed
// @field barTime                   bar time
// @field barIndex                  bar index    
type pv_pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

// @type                            UDT representing an order block
// @field barHigh                   bar high
// @field barLow                    bar low
// @field barTime                   bar time
// @field bias                      BULLISH or BEARISH
type pv_orderBlock
    float barHigh
    float barLow
    int barTime    
    int bias

// @variable                        current swing pv_pivot high    
var pv_pivot smc_swingHigh                 = pv_pivot.new(na,na,false)
// @variable                        current swing pv_pivot low
var pv_pivot smc_swingLow                  = pv_pivot.new(na,na,false)
// @variable                        current internal pv_pivot high
var pv_pivot smc_internalHigh              = pv_pivot.new(na,na,false)
// @variable                        current internal pv_pivot low
var pv_pivot smc_internalLow               = pv_pivot.new(na,na,false)
// @variable                        current equal high pv_pivot
var pv_pivot smc_equalHigh                 = pv_pivot.new(na,na,false)
// @variable                        current equal low pv_pivot
var pv_pivot smc_equalLow                  = pv_pivot.new(na,na,false)
// @variable                        swing pv_trend bias
var pv_trend smc_swingTrend                = pv_trend.new(0)
// @variable                        internal pv_trend bias
var pv_trend smc_internalTrend             = pv_trend.new(0)
// @variable                        equal high display
var pv_equalDisplay smc_equalHighDisplay   = pv_equalDisplay.new()
// @variable                        equal low display
var pv_equalDisplay smc_equalLowDisplay    = pv_equalDisplay.new()
// @variable                        storage for pv_fairValueGap UDTs
var array<pv_fairValueGap> smc_fairValueGaps = array.new<pv_fairValueGap>()
// @variable                        storage for parsed smc_highs
var array<float> smc_parsedHighs        = array.new<float>()
// @variable                        storage for parsed smc_lows
var array<float> smc_parsedLows         = array.new<float>()
// @variable                        storage for raw smc_highs
var array<float> smc_highs              = array.new<float>()
// @variable                        storage for raw smc_lows
var array<float> smc_lows               = array.new<float>()
// @variable                        storage for bar time values
var array<int> smc_times                = array.new<int>()
// @variable                        last smc_trailing swing high and low
var pv_trailingExtremes smc_trailing       = pv_trailingExtremes.new()
// @variable                                storage for pv_orderBlock UDTs (swing order blocks)
var array<pv_orderBlock> smc_swingOrderBlocks      = array.new<pv_orderBlock>()
// @variable                                storage for pv_orderBlock UDTs (internal order blocks)
var array<pv_orderBlock> smc_internalOrderBlocks   = array.new<pv_orderBlock>()
// @variable                                storage for swing order blocks boxes
var array<box> smc_swingOrderBlocksBoxes        = array.new<box>()
// @variable                                storage for internal order blocks boxes
var array<box> smc_internalOrderBlocksBoxes     = array.new<box>()
// @variable                        color for swing bullish structures
var smc_swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
// @variable                        color for swing bearish structures
var smc_swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
// @variable                        color for bullish fair value gaps
var smc_fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
// @variable                        color for bearish fair value gaps
var smc_fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
// @variable                        color for premium zone
var smc_premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
// @variable                        color for discount zone
var smc_discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput 
// @variable                        bar index on current script iteration
varip int smc_currentBarIndex           = bar_index
// @variable                        bar index on last script iteration
varip int smc_lastBarIndex              = bar_index
// @variable                        pv_alerts in current bar
pv_alerts smc_currentAlerts                = pv_alerts.new()
// @variable                        time at start of chart
var smc_initialTime                     = time

// we create the needed boxes for displaying order blocks at the first execution
if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            smc_swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            smc_internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))

// @variable                        source to use in bearish order blocks mitigation
smc_bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
// @variable                        source to use in bullish order blocks mitigation
smc_bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
// @variable                        default volatility measure
smc_atrMeasure                          = ta.atr(200)
// @variable                        parsed volatility measure by user settings
smc_volatilityMeasure                   = orderBlockFilterInput == ATR ? smc_atrMeasure : ta.cum(ta.tr)/bar_index
// @variable                        true if current bar is a high volatility bar
smc_highVolatilityBar                   = (high - low) >= (2 * smc_volatilityMeasure)
// @variable                        parsed high
smc_parsedHigh                          = smc_highVolatilityBar ? low : high
// @variable                        parsed low
smc_parsedLow                           = smc_highVolatilityBar ? high : low

// we store current values into the arrays at each bar
smc_parsedHighs.push(smc_parsedHigh)
smc_parsedLows.push(smc_parsedLow)
smc_highs.push(high)
smc_lows.push(low)
smc_times.push(time)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
// @function            Get the value of the current smc_leg, it can be 0 (bearish) or 1 (bullish)
// @returns             int
smc_leg(int size) =>
    var smc_leg     = 0    
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)
    
    if newLegHigh
        smc_leg := BEARISH_LEG
    else if newLegLow
        smc_leg := BULLISH_LEG
    smc_leg

// @function            Identify whether the current value is the start of a new smc_leg (swing)
// @param smc_leg           (int) Current smc_leg value
// @returns             bool
smc_startOfNewLeg(int smc_leg)      => ta.change(smc_leg) != 0

// @function            Identify whether the current level is the start of a new bearish smc_leg (swing)
// @param smc_leg           (int) Current smc_leg value
// @returns             bool
smc_startOfBearishLeg(int smc_leg)  => ta.change(smc_leg) == -1

// @function            Identify whether the current level is the start of a new bullish smc_leg (swing)
// @param smc_leg           (int) Current smc_leg value
// @returns             bool
smc_startOfBullishLeg(int smc_leg)  => ta.change(smc_leg) == +1

// @function            create a new label
// @param labelTime     bar time coordinate
// @param labelPrice    price coordinate
// @param tag           text to display
// @param labelColor    text color
// @param labelStyle    label style
// @returns             label ID
smc_drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

// @function            create a new line and label representing an EQH or EQL
// @param p_ivot        starting pv_pivot
// @param level         price level of current pv_pivot
// @param size          how many bars ago was the current pv_pivot detected
// @param smc_equalHigh     true for EQH, false for EQL
// @returns             label ID
smc_drawEqualHighLow(pv_pivot p_ivot, float level, int size, bool smc_equalHigh) =>
    pv_equalDisplay e_qualDisplay = smc_equalHigh ? smc_equalHighDisplay : smc_equalLowDisplay
    
    string tag          = 'EQL'
    color equalColor    = smc_swingBullishColor
    string labelStyle   = label.style_label_up

    if smc_equalHigh
        tag         := 'EQH'
        equalColor  := smc_swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

// @function            store current structure and smc_trailing swing points, and also display swing points and equal smc_highs/smc_lows
// @param size          (int) structure size
// @param equalHighLow  (bool) true for displaying current smc_highs/smc_lows
// @param internal      (bool) true for getting internal structures
// @returns             label ID
smc_getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>        
    currentLeg              = smc_leg(size)
    newPivot                = smc_startOfNewLeg(currentLeg)
    pivotLow                = smc_startOfBullishLeg(currentLeg)
    pivotHigh               = smc_startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pv_pivot p_ivot    = equalHighLow ? smc_equalLow : internal ? smc_internalLow : smc_swingLow    

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * smc_atrMeasure                
                smc_drawEqualHighLow(p_ivot, low[size], size, false)
                smc_currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                smc_trailing.bottom         := p_ivot.currentLevel
                smc_trailing.barTime        := p_ivot.barTime
                smc_trailing.barIndex       := p_ivot.barIndex
                smc_trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                smc_drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', smc_swingBullishColor, label.style_label_up)            
        else
            pv_pivot p_ivot = equalHighLow ? smc_equalHigh : internal ? smc_internalHigh : smc_swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * smc_atrMeasure
                smc_drawEqualHighLow(p_ivot,high[size],size,true)
                smc_currentAlerts.equalHighs := true               

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                smc_trailing.top            := p_ivot.currentLevel
                smc_trailing.barTime        := p_ivot.barTime
                smc_trailing.barIndex       := p_ivot.barIndex
                smc_trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                smc_drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', smc_swingBearishColor, label.style_label_down)
                
// @function                draw line and label representing a structure
// @param p_ivot            base pv_pivot point
// @param tag               test to display
// @param structureColor    base color
// @param lineStyle         line style
// @param labelStyle        label style
// @param labelSize         text size
// @returns                 label ID
smc_drawStructure(pv_pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>    
    var line l_ine      = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel    = label.new(na,na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    l_ine   := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel  := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size = labelSize)

// @function            delete order blocks
// @param internal      true for internal order blocks
// @returns             pv_orderBlock ID
smc_deleteOrderBlocks(bool internal = false) =>
    array<pv_orderBlock> orderBlocks = internal ? smc_internalOrderBlocks : smc_swingOrderBlocks

    for [index,eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false
        
        if smc_bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                smc_currentAlerts.internalBearishOrderBlock := true
            else
                smc_currentAlerts.swingBearishOrderBlock    := true
        else if smc_bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                smc_currentAlerts.internalBullishOrderBlock := true
            else
                smc_currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock                    
            orderBlocks.remove(index)            

// @function            fetch and store order blocks
// @param p_ivot        base pv_pivot point
// @param internal      true for internal order blocks
// @param bias          BULLISH or BEARISH
// @returns             void
smc_storeOrdeBlock(pv_pivot p_ivot,bool internal = false,int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)

        array<float> a_rray = na
        int parsedIndex = na

        if bias == BEARISH
            a_rray      := smc_parsedHighs.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())  
        else
            a_rray      := smc_parsedLows.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())                        

        pv_orderBlock o_rderBlock          = pv_orderBlock.new(smc_parsedHighs.get(parsedIndex), smc_parsedLows.get(parsedIndex), smc_times.get(parsedIndex),bias)
        array<pv_orderBlock> orderBlocks   = internal ? smc_internalOrderBlocks : smc_swingOrderBlocks
        
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

// @function            draw order blocks as boxes
// @param internal      true for internal order blocks
// @returns             void
smc_drawOrderBlocks(bool internal = false) =>        
    array<pv_orderBlock> orderBlocks = internal ? smc_internalOrderBlocks : smc_swingOrderBlocks
    orderBlocksSize = orderBlocks.size()

    if orderBlocksSize > 0        
        maxOrderBlocks                      = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<pv_orderBlock> parsedOrdeBlocks  = orderBlocks.slice(0, math.min(maxOrderBlocks,orderBlocksSize))
        array<box> b_oxes                   = internal ? smc_internalOrderBlocksBoxes : smc_swingOrderBlocksBoxes        

        for [index,eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)

            box b_ox        = b_oxes.get(index)
            b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,eachOrderBlock.barLow))        
            b_ox.set_border_color(      internal ? na : orderBlockColor)
            b_ox.set_bgcolor(           orderBlockColor)

// @function            detect and draw structures, also detect and store order blocks
// @param internal      true for internal structures or order blocks
// @returns             void
smc_displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    
    pv_pivot p_ivot    = internal ? smc_internalHigh : smc_swingHigh
    pv_trend t_rend    = internal ? smc_internalTrend : smc_swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? smc_internalHigh.currentLevel != smc_swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    if ta.crossover(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            smc_currentAlerts.internalBullishCHoCH  := tag == CHOCH
            smc_currentAlerts.internalBullishBOS    := tag == BOS
        else
            smc_currentAlerts.swingBullishCHoCH     := tag == CHOCH
            smc_currentAlerts.swingBullishBOS       := tag == BOS

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition                        
            smc_drawStructure(p_ivot,tag,bullishColor,lineStyle,label.style_label_down,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            smc_storeOrdeBlock(p_ivot,internal,BULLISH)

    p_ivot          := internal ? smc_internalLow : smc_swingLow    
    extraCondition  := internal ? smc_internalLow.currentLevel != smc_swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            smc_currentAlerts.internalBearishCHoCH  := tag == CHOCH
            smc_currentAlerts.internalBearishBOS    := tag == BOS
        else
            smc_currentAlerts.swingBearishCHoCH     := tag == CHOCH
            smc_currentAlerts.swingBearishBOS       := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        
        if displayCondition                        
            smc_drawStructure(p_ivot,tag,bearishColor,lineStyle,label.style_label_up,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            smc_storeOrdeBlock(p_ivot,internal,BEARISH)

// @function            draw one fair value gap box (each fair value gap has two boxes)
// @param leftTime      left time coordinate
// @param rightTime     right time coordinate
// @param topPrice      top price level
// @param bottomPrice   bottom price level
// @param boxColor      box color
// @returns             box ID
smc_fairValueGapBox(leftTime,rightTime,topPrice,bottomPrice,boxColor) => box.new(chart.point.new(leftTime,na,topPrice),chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

// @function            delete fair value gaps
// @returns             pv_fairValueGap ID
smc_deleteFairValueGaps() =>
    for [index,eachFairValueGap] in smc_fairValueGaps
        if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            smc_fairValueGaps.remove(index)
    
// @function            draw fair value gaps
// @returns             pv_fairValueGap ID
smc_drawFairValueGaps() => 
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]],lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        smc_currentAlerts.bullishFairValueGap := true
        smc_fairValueGaps.unshift(pv_fairValueGap.new(currentLow,last2High,BULLISH,smc_fairValueGapBox(lastTime,currentTime,currentLow,math.avg(currentLow,last2High),smc_fairValueGapBullishColor),smc_fairValueGapBox(lastTime,currentTime,math.avg(currentLow,last2High),last2High,smc_fairValueGapBullishColor)))
    if bearishFairValueGap
        smc_currentAlerts.bearishFairValueGap := true
        smc_fairValueGaps.unshift(pv_fairValueGap.new(currentHigh,last2Low,BEARISH,smc_fairValueGapBox(lastTime,currentTime,currentHigh,math.avg(currentHigh,last2Low),smc_fairValueGapBearishColor),smc_fairValueGapBox(lastTime,currentTime,math.avg(currentHigh,last2Low),last2Low,smc_fairValueGapBearishColor)))

// @function            get line style from string
// @param style         line style
// @returns             string
smc_getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

// @function            draw MultiTimeFrame levels
// @param timeframe     base timeframe
// @param sameTimeframe true if chart timeframe is same as base timeframe
// @param style         line style
// @param levelColor    line and text color
// @returns             void
smc_drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = smc_times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = smc_times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = smc_times.slice(leftIndex,rightIndex)
        array<float> topArray       = smc_highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = smc_lows.slice(leftIndex,rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : smc_initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : smc_initialTime

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = smc_getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = smc_getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))   
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))

    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

// @function            true if chart timeframe is higher than provided timeframe
// @param timeframe     timeframe to check
// @returns             bool
smc_higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

// @function            update smc_trailing swing points
// @returns             int
smc_updateTrailingExtremes() =>
    smc_trailing.top            := math.max(high,smc_trailing.top)
    smc_trailing.lastTopTime    := smc_trailing.top == high ? time : smc_trailing.lastTopTime
    smc_trailing.bottom         := math.min(low,smc_trailing.bottom)
    smc_trailing.lastBottomTime := smc_trailing.bottom == low ? time : smc_trailing.lastBottomTime

// @function            draw smc_trailing swing points
// @returns             void
smc_drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = smc_swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = smc_swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = smc_swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = smc_swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(    chart.point.new(smc_trailing.lastTopTime, na, smc_trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, smc_trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, smc_trailing.top))
    topLabel.set_text(          smc_swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point( chart.point.new(smc_trailing.lastBottomTime, na, smc_trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, smc_trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, smc_trailing.bottom))
    bottomLabel.set_text(       smc_swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

// @function            draw a zone with a label and a box
// @param labelLevel    price level for label
// @param labelIndex    bar index for label
// @param top           top price level for box
// @param bottom        bottom price level for box
// @param tag           text to display
// @param zoneColor     base color
// @param style         label style
// @returns             void
smc_drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(smc_trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))

    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

// @function            draw premium/discount zones
// @returns             void
smc_drawPremiumDiscountZones() =>
    smc_drawZone(smc_trailing.top, math.round(0.5*(smc_trailing.barIndex + last_bar_index)), smc_trailing.top, 0.95*smc_trailing.top + 0.05*smc_trailing.bottom, 'Premium', smc_premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(smc_trailing.top, smc_trailing.bottom)
    smc_drawZone(equilibriumLevel, last_bar_index, 0.525*smc_trailing.top + 0.475*smc_trailing.bottom, 0.525*smc_trailing.bottom + 0.475*smc_trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)

    smc_drawZone(smc_trailing.bottom, math.round(0.5*(smc_trailing.barIndex + last_bar_index)), 0.95*smc_trailing.bottom + 0.05*smc_trailing.top, smc_trailing.bottom, 'Discount', smc_discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = smc_internalTrend.bias == BULLISH ? smc_swingBullishColor : smc_swingBearishColor
plotcandle(parsedOpen,high,low,close,color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    smc_updateTrailingExtremes()

    if showHighLowSwingsInput
        smc_drawHighLowSwings()

    if showPremiumDiscountZonesInput
        smc_drawPremiumDiscountZones()

if showFairValueGapsInput
    smc_deleteFairValueGaps()

smc_getCurrentStructure(swingsLengthInput,false)
smc_getCurrentStructure(5,false,true)

if showEqualHighsLowsInput
    smc_getCurrentStructure(equalHighsLowsLengthInput,true)

if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
    smc_displayStructure(true)

if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    smc_displayStructure()

if showInternalOrderBlocksInput
    smc_deleteOrderBlocks(true)

if showSwingOrderBlocksInput
    smc_deleteOrderBlocks()

if showFairValueGapsInput
    smc_drawFairValueGaps()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput        
        smc_drawOrderBlocks(true)
        
    if showSwingOrderBlocksInput        
        smc_drawOrderBlocks()

smc_lastBarIndex    := smc_currentBarIndex
smc_currentBarIndex := bar_index
newBar          = smc_currentBarIndex != smc_lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not smc_higherTimeframe('D')
        smc_drawLevels('D',timeframe.isdaily,dailyLevelsStyleInput,dailyLevelsColorInput)

    if showWeeklyLevelsInput and not smc_higherTimeframe('W')
        smc_drawLevels('W',timeframe.isweekly,weeklyLevelsStyleInput,weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not smc_higherTimeframe('M')
        smc_drawLevels('M',timeframe.ismonthly,monthlyLevelsStyleInput,monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(smc_currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(smc_currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(smc_currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(smc_currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(smc_currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Internal Bullish BOS formed')
alertcondition(smc_currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Internal Bullish CHoCH formed')
alertcondition(smc_currentAlerts.swingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(smc_currentAlerts.swingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')

alertcondition(smc_currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(smc_currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(smc_currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(smc_currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(smc_currentAlerts.equalHighs,                'Equal Highs',                  'Equal smc_highs detected')
alertcondition(smc_currentAlerts.equalLows,                 'Equal Lows',                   'Equal smc_lows detected')

alertcondition(smc_currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(smc_currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')

//---------------------------------------------------------------------------------------------------------------------}


// ═════════════ LQZ core + full-width render ═════════════
// ── inputs ──────────────────────────────────────────────────────────────────
lqzSource   = input.string("candles", "Liquidity detector", options = ["luxalgo", "candles", "both"], group = "LQZ")
lqzTol      = input.float(0.5, "Overlap tolerance (x ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = "LQZ")
lqzMinAgree = input.int(2, "Min agreeing sources", minval = 1, maxval = 4, group = "LQZ")
lqzMaxZones = input.int(60, "Max zones", minval = 5, maxval = 200, group = "LQZ")
lqzMaxLevels = input.int(1500, "Max tracked levels", minval = 100, maxval = 6000, group = "LQZ")

// ── state ───────────────────────────────────────────────────────────────────
var array<float> lqzLevels    = array.new<float>()
var array<int>   lqzLevelSrc  = array.new<int>()
var array<int>   lqzLevelSide = array.new<int>()
var array<int>   lqzLevelBar  = array.new<int>()

var array<float> lqzZLevel  = array.new<float>()
var array<float> lqzZTop    = array.new<float>()
var array<float> lqzZBottom = array.new<float>()
var array<int>   lqzZSide   = array.new<int>()
var array<int>   lqzZMask   = array.new<int>()
var array<int>   lqzZConf   = array.new<int>()

lqzSink(price, srcId, side) =>
    // BOUNDED BUFFER. lqzSink fires on every touch; unbounded it grew without limit and the
    // O(n^2) cluster on the last bar wedged the station outright (measured: 15m hung the
    // single-threaded station for 315 s and blocked every other request). Evict-oldest keeps
    // the most recent lqzMaxLevels, which is the window that matters.
    if array.size(lqzLevels) >= lqzMaxLevels
        array.shift(lqzLevels), array.shift(lqzLevelSrc), array.shift(lqzLevelSide), array.shift(lqzLevelBar)
    array.push(lqzLevels, price), array.push(lqzLevelSrc, srcId)
    // THE SIDE IS DERIVED, NEVER PASSED. Measured 2026-10-02: the detectors disagreed and the
    // chart showed both sides at the same price. lqzSink call sites passed a hard-coded side —
    // the POOLS rails passed 1 for BOTH the "buyside rail, above price" AND the "sellside rail,
    // below price" (lines 161-163), and the VOIDS passed 1 for both _vlo and _vhi (172-173).
    // The comment said sellside; the argument said buy-side. Result on the rig: 34 LQZ boxes
    // where the library draws 16, with 14 overlapping pairs — teal INSIDE red and red INSIDE
    // teal AT THE SAME PRICE. A level cannot be buy-side and sell-side at once.
    //
    // THE CONTRACT (header, line 9) is POSITIONAL and is now enforced in ONE place:
    //   side = 1 (BUY_SIDE,  liquidity ABOVE price -> supply -> red)
    //   side = 0 (SELL_SIDE, liquidity BELOW price -> demand -> teal)
    // A detector deriving side from the CANDLE (a sweep's wick direction) contradicts another
    // deriving it from PRICE. Position is the single truth. The `side` parameter is kept for
    // provenance but is no longer trusted for paint.
    array.push(lqzLevelSide, price >= close ? 1 : 0), array.push(lqzLevelBar, bar_index), price

// ═════════════════════════════════════════════════════════════════════════════
// V2 - THE OPERATOR CANDLE DETECTOR (SMC_Liquidity_Notes.md)
//   1. "Where has price touched multiple times? That's a liquidity build-up"
//   2. "Price wicks just beyond the support/resistance - taking out stops"
//   3. "Consolidation right after a sweep = absorption"  <- the green zone
// Mechanics read off the winning-trade library: wick-grab (wick >> body, tip
// pierces a level, body closes back inside), wick-stack (several bars' tips at
// one price), and the rejection (a decisive move away). A wick with no
// follow-through is volatility, not liquidity - the rejection gate is mandatory.
lqzSwingLen  = input.int(5, "V2 swing pivot length", minval = 2, maxval = 20, group = "V2 candles")
lqzWickMult  = input.float(2.0, "V2 wick/body ratio", minval = 1.0, maxval = 8.0, step = 0.1, group = "V2 candles")
lqzReject    = input.float(1.5, "V2 rejection (x ATR)", minval = 0.3, maxval = 5.0, step = 0.1, group = "V2 candles")
lqzRejectWin = input.int(3, "V2 rejection window (bars)", minval = 1, maxval = 10, group = "V2 candles")

// confirmed swing levels: level, touches, side (1=BUY_SIDE above -> supply)
//                                                  (0=SELL_SIDE below -> demand)
var array<float> lqzLvl      = array.new<float>()
var array<int>   lqzLvlTch   = array.new<int>()
var array<int>   lqzLvlSide  = array.new<int>()
var array<int>   lqzLvlSweep = array.new<int>()
var array<int>   lqzLvlBar   = array.new<int>()

lqzAtr   = ta.atr(14)
lqzTolP  = lqzTol * nz(lqzAtr, syminfo.mintick * 10)
lqzAtrS  = nz(lqzAtr, 0.0)
lqzBody  = math.abs(close - open)
lqzUpW   = high - math.max(open, close)
lqzDnW   = math.min(open, close) - low

if bar_index > lqzSwingLen
    lqzPH = ta.pivothigh(lqzSwingLen, 1)
    lqzPL = ta.pivotlow(lqzSwingLen, 1)
    if not na(lqzPH)
        array.push(lqzLvl, lqzPH)
        array.push(lqzLvlTch, 1)
        array.push(lqzLvlSide, 1)
        array.push(lqzLvlSweep, -9999)
        array.push(lqzLvlBar, bar_index)
    if not na(lqzPL)
        array.push(lqzLvl, lqzPL)
        array.push(lqzLvlTch, 1)
        array.push(lqzLvlSide, 0)
        array.push(lqzLvlSweep, -9999)
        array.push(lqzLvlBar, bar_index)

    // every bar that comes within tolerance of a level is another touch
    nLvl = array.size(lqzLvl)
    if nLvl > 0
        for i = 0 to nLvl - 1
            if i >= nLvl
                break
            _lv = array.get(lqzLvl, i)
            // A level is TOUCHED when price TRADES there, not when the close lands on it:
            // a pivot high sits above the close, so testing |close - level| almost never
            // fires and the whole detector silently emits nothing.
            _hit = array.get(lqzLvlSide, i) == 1 ? (high >= _lv - lqzTolP) : (low <= _lv + lqzTolP)
            _was = array.get(lqzLvlTch, i)
            // fire ON THE TRANSITION to the second touch, not on every touch after:
            // re-emitting every bar floods the bounded buffer with a few hot levels and
            // evicts the genuinely distinct ones (measured: sunkLevels pinned at the 1500
            // cap on all four timeframes, collapsing 69-378 swings into 1-3 zones).
            if _hit and _was == 1 and array.get(lqzLvlBar, i) != bar_index
                // STEP 1 fired: price touched this level again -> liquidity build-up.
                // Emitted as src 16 (build-up). The sweep+rejection below promotes the
                // level to src 8 (confirmed). Both are real liquidity per the operator's
                // process; on thin data (4H = 451 bars) the confirmed path yields nothing,
                // and a detector that emits ZERO zones on thin data is the red flag.
                lqzSink(_lv, 16, array.get(lqzLvlSide, i))
                array.set(lqzLvlBar, i, bar_index)
            if _hit
                array.set(lqzLvlTch, i, _was + 1)

    // the sweep + rejection
    if lqzAtrS > 0
        for i = 0 to nLvl - 1
            if i >= nLvl
                break
            lv  = array.get(lqzLvl, i)
            sd  = array.get(lqzLvlSide, i)
            sw  = array.get(lqzLvlSweep, i)
            sup = sd == 1

            if sw < 0
                // wick tip pierced the level AND the wick dominated the body
                pierced  = sup ? (high > lv and lqzUpW >= lqzWickMult * lqzBody) : (low < lv and lqzDnW >= lqzWickMult * lqzBody)
                // the bar closed back inside -> that IS the rejection, same bar
                rejected = sup ? (close < lv) : (close > lv)
                if pierced and rejected
                    array.set(lqzLvlSweep, i, bar_index)
                    array.set(lqzLvlTch, i, array.get(lqzLvlTch, i) + 1)
                    if array.get(lqzLvlTch, i) >= 2
                        lqzSink(lv, 8, sd)
            else
                // the rejection arrives on a later bar, inside the window
                if bar_index - sw <= lqzRejectWin
                    okRej = sup ? (close < lv) : (close > lv)
                    far   = sup ? (close <= lv - lqzReject * lqzAtrS) : (close >= lv + lqzReject * lqzAtrS)
                    if okRej and far
                        lqzSink(lv, 8, sd)
                        array.set(lqzLvlSweep, i, -9999)


// ═════════════════════════════════════════════════════════════════════════════
// V1 - THE LUXALGO TAP (host-supplied, scalar accessors - PineTS has no tuple
// assignment). CORE does not know how the deliverable stores a pivot, a sweep or
// an FVG; each deliverable implements these five against ITS OWN LuxAlgo code,
// so detection is never reimplemented here - that is what keeps D1 at parity.
//   na  = "no hit this bar" and is skipped.
lqzV1Enabled = lqzSource == "luxalgo" or lqzSource == "both"
if lqzV1Enabled
    _mid  = lqzV1PoolMid()
    _rail = lqzV1PoolRail()
    if not na(_mid)
        lqzSink(_mid + _rail, 1, 1)      // buyside rail, above price
        lqzSink(_mid - _rail, 1, 1)      // sellside rail, below price
        lqzSink(_mid,        1, 1)      // the cluster centre

    _swp = lqzV1SweepPrc()
    if not na(_swp)
        lqzSink(_swp, 2, _swp >= close ? 1 : 0)

    _vlo = lqzV1VoidLo()
    _vhi = lqzV1VoidHi()
    if not na(_vlo)
        lqzSink(_vlo, 4, 1)
        lqzSink(_vhi, 4, 1)

// ═════════════════════════════════════════════════════════════════════════════
// THE CONFIRMATION - horizontal alignment.
// THE operator draws ONE zone where the sources CONCUR; three separate renders at
// the same level is the defect this pass removes. So: group every recorded
// level into same-side price bands, and emit a zone only for a band that
// carries >= lqzMinAgree DISTINCT sources (or, when minAgree == 1, any band).
lqzV2Enabled = lqzSource == "candles" or lqzSource == "both"
if lqzV2Enabled and lqzSource == "luxalgo"
    runtime.error("lqzSource cannot be both 'luxalgo' and V2-active")
if lqzV2Enabled and barstate.islast
    // nothing to cluster mid-run; the cluster pass runs below on the last bar

// ── the cluster pass: run on the last bar so the full history is in the arrays ──
if barstate.islast
    n = array.size(lqzLevels)
    if n > 0
        // insertion sort by price (levels are few; n <= a few hundred)
        for a = 1 to n - 1
            if a >= n
                break
            ka = array.get(lqzLevels, a)
            sa = array.get(lqzLevelSrc, a)
            da = array.get(lqzLevelSide, a)
            ba = array.get(lqzLevelBar, a)
            b = a - 1
            while b >= 0 and array.get(lqzLevels, b) > ka
                array.set(lqzLevels, b + 1, array.get(lqzLevels, b))
                array.set(lqzLevelSrc, b + 1, array.get(lqzLevelSrc, b))
                array.set(lqzLevelSide, b + 1, array.get(lqzLevelSide, b))
                array.set(lqzLevelBar, b + 1, array.get(lqzLevelBar, b))
                b := b - 1
            array.set(lqzLevels, b + 1, ka)
            array.set(lqzLevelSrc, b + 1, sa)
            array.set(lqzLevelSide, b + 1, da)
            array.set(lqzLevelBar, b + 1, ba)

        // walk the sorted levels, extending a band while the next one is within tol.
        // PineTS has no bitwise ops, so distinct-source counting is 4 explicit flags.
        i = 0
        while i < n
            lo = array.get(lqzLevels, i)
            hi = lo
            sd = array.get(lqzLevelSide, i)
            h1 = false
            h2 = false
            h4 = false
            h8 = false
            h16 = false
            // THE MERGE KEY IS PRICE, NOT SIDE. This line was
            //   `if array.get(lqzLevelSide, j) != sd or pj - hi > lqzTolP`
            // and it was the root cause of the duplicate-slop chart. Measured 2026-10-02: four
            // collision pairs, every one of them bands with the SAME low AND the SAME high, one
            // red one teal — e.g. [1.143872, 1.14415] in both #B84A4A and #3E9B8F. A level that
            // sits inside the merge tolerance is ONE liquidity zone. Gating the join on side
            // GUARANTEED those pairs could never merge: opposite side => break => both emit =>
            // two identical bands stacked, which is exactly the "supply zone in between a
            // demand and liquidity zones" mess the operator named.
            //
            // WHY THE SIDES DISAGREED AT ALL: the side is derived per-sink from
            // `price >= close`, so the same price sunk on two different bars — one above its
            // close, one below — got opposite sides. That per-bar reading is noise; the band's
            // identity is its PRICE. Side is now assigned ONCE, below, from the merged band.
            j = i + 1
            while j < n
                pj = array.get(lqzLevels, j)
                if pj - hi > lqzTolP
                    break
                sj = array.get(lqzLevelSrc, j)
                h1 := h1 or sj == 1
                h2 := h2 or sj == 2
                h4 := h4 or sj == 4
                h8 := h8 or sj == 8
                h16 := h16 or sj == 16
                j := j + 1
            s0 = array.get(lqzLevelSrc, i)
            h1 := h1 or s0 == 1
            h2 := h2 or s0 == 2
            h4 := h4 or s0 == 4
            h8 := h8 or s0 == 8
            h16 := h16 or s0 == 16
            conf = (h1 ? 1 : 0) + (h2 ? 1 : 0) + (h4 ? 1 : 0) + (h8 ? 1 : 0) + (h16 ? 1 : 0)
            // In candles-only mode V2 has ALREADY gated every level on >= 2 touches
            // ("where has price touched multiple times?") — that IS its confirmation, so
            // demanding a second DISTINCT source would make candles-only emit nothing.
            // In luxalgo/both mode the 2-distinct-source rule stands: a lone candle level
            // next to three LuxAlgo rails is a candidate, never a zone.
            _need = lqzSource == "candles" ? 1 : lqzMinAgree
            if conf >= _need and array.size(lqzZLevel) < lqzMaxZones
                array.push(lqzZLevel, (lo + hi) / 2)
                array.push(lqzZTop, hi)
                array.push(lqzZBottom, lo)
                // THE SIDE, ASSIGNED ONCE, FROM THE MERGED BAND — not inherited per-sink.
                // The contract (header line 9) is POSITIONAL, so it is decided here, after the
                // band exists, from where the band actually sits:
                //   side 1 = BUY_SIDE  (liquidity ABOVE price -> supply -> red)
                //   side 0 = SELL_SIDE (liquidity BELOW price -> demand -> teal)
                // Using the band's own top edge against the CLOSE, not the per-bar sink reading:
                // a band is one object with one side, and a price level can only be one of them.
                // Measured 2026-10-02: inheriting `sd` from the first level of the group kept
                // producing pairs of identical [lo,hi] bands in opposite colours.
                array.push(lqzZSide, hi >= close ? 1 : 0)
                array.push(lqzZMask, conf)
                array.push(lqzZConf, conf)
            i := j


// ═════════════════════════════════════════════════════════════════════════════
// LQZ RENDER — the full-width horizontal zone emitter.
// CONSUMES (read-only; never mutates) the arrays W1 emits:
//   lqzZLevel[] lqzZTop[] lqzZBottom[] lqzZSide[] lqzZMask[] lqzZConf[]
//
// THE MEASURED TARGET — WINNING_TRADE_LIBARARY, measured 2026-10-02 with ONE instrument
// applied to both images (crop /tmp/liblabels/SIDE_BY_SIDE.png):
//   band COUNT      16 per column          (ours was 20)
//   band THICKNESS  median 5.5 px, 1-152 px (ours: median 1.0 px, 1-6 px  ← THE DEFECT)
//   zone COLOUR     teal  #61B2B0 / #6DA486   red  #F23240 / #9E5555
//   band FILL       OPAQUE blocks of colour (ours: outlines only, no fill)
//   horizontal span 98-100 % of the plot row  (ours: 100 % on the rails, 10 % elsewhere)
// The earlier "1px thickness" target was WRONG: measure_ladder.py counted a row as covered
// if ANY ink pixel existed, so a 1px hairline scored a 99 % pass. It never measured
// thickness or fill — the instrument was blind to the defect it was meant to catch.
// THE LIBRARY EMITS ZONES. WE WERE EMITTING LINES. That is the whole difference.
//
// ── THE THREE-CLASS PALETTE (operator order, 2026-10-02) ──────────────────────
//   LIQUIDITY = GREEN (always, every band, no exception)
//   SUPPLY    = RED    (LuxAlgo SMC origin order blocks ONLY)
//   DEMAND    = BLUE   (LuxAlgo SMC origin order blocks ONLY)
//
// WHAT WAS WRONG HERE, and it was mine. The previous contract read
//   "1 = BUY_SIDE (liquidity ABOVE price -> supply -> red)"
//   "0 = SELL_SIDE (liquidity BELOW price -> demand -> green)"
// and the render did `_col = _sd == 1 ? lqzColorS : lqzColorB`. That made EVERY
// liquidity band red or teal AS IF IT WERE a supply or demand zone — a
// supply/demand claim the liquidity detector never made and the canon never
// supports. Measured on the rig: 17 of 27 LQZ bands painted red, which the
// operator read as "some of the liquidity is incorrectly marked red as if it's
// a supply zone."
//
// THE CANON IS EXPLICIT (Forex SMC Notes, the Liquidity section):
//   "Liquidity = orders + stop losses"
//   "Liquidity zones are resting pools of orders that are sitting"
//   "Liquidity exists in the opposite direction of the trend PRIOR TO the sweep"
// Buy-side liquidity (above price) and sell-side liquidity (below price) are the
// SAME CLASS. Both are resting stop orders. Both are swept the same way. Neither
// is a supply or a demand zone — a supply/demand zone is an INSTITUTIONAL ORDER
// BLOCK, which is a different object entirely (see the S/D note below).
//
// THE SIDE IS RETAINED ONLY AS POSITIONAL DATA (buy-side vs sell-side liquidity,
// which the canon does distinguish for sweep analysis) — it NEVER selects a colour.
// Colour is a function of CLASS, and liquidity has exactly one colour.
lqzColorLq  = input.color(#2E8B57, "Liquidity zone (ALL liquidity is this colour)", group = "LQZ render")
lqzEdgeLq   = input.color(#3FA46A, "Liquidity edge", group = "LQZ render")
lqzLineW   = input.int(2, "Edge width (px)", minval = 1, maxval = 4, group = "LQZ render")
lqzLineTol = input.float(0.0, "Rails draw separately above (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = "LQZ render")
lqzFillZone = input.bool(true, "Fill every zone (THE library look)", group = "LQZ render")
lqzFillA    = input.int(45, "Fill opacity (0=clear, 100=solid)", minval = 0, maxval = 100, group = "LQZ render")
lqzThickE   = input.float(0.35, "Thinnest band (x ATR)", minval = 0.0, maxval = 2.0, step = 0.1, group = "LQZ render")
lqzLeftB  = input.int(500, "Left margin (bars)", minval = 1, maxval = 500, group = "LQZ render")
lqzRightB = input.int(20,  "Right margin (bars)", minval = 1, maxval = 300, group = "LQZ render")

// BAND FLOOR. A band thinner than the renderer's own resolution collapses to
// nothing on screen and reads as "missing liquidity". Floor it on ATR, NOT on
// syminfo.mintick: this engine reports mintick = 1e-16, which made every
// degenerate band invisible (measured: band height min 0.00000 over 50 boxes).
// mintick stays only as a secondary guard when ATR is unavailable.
lqzMinTick = math.max(syminfo.mintick, 0.0)
lqzThick   = math.max(lqzThickE * nz(ta.atr(14), 0.0), nz(lqzMinTick, 0.0))

f_lqzRender() =>
    // THE PRIMITIVE IS A FILLED ZONE, NOT A LINE. Measured 2026-10-02 against the
    // WINNING_TRADE_LIBARARY with one instrument applied to both: the library's bands are
    // median 5.5 px thick and OPAQUE; ours were median 1.0 px and unfilled. The prior
    // comment here claimed the library was "1px" — that came from measure_ladder.py, which
    // scored a row covered if ANY ink pixel existed, so a 1px hairline scored a 99% pass.
    // It never measured thickness or fill. The number was the instrument's blind spot, not
    // the library's geometry. THIS IS THE WHOLE VISUAL DEFECT.
    //
    // Merge first, paint second: adjacent same-side zones within lqzLineTol x ATR are ONE
    // zone in the library (16 bands/column, not 20 overlapping slabs), so overlapping
    _n = array.size(lqzZLevel)
    if _n > 0
        for i = 0 to _n - 1
            if i >= _n
                break
            _sd = array.get(lqzZSide, i)
            _lo = array.get(lqzZBottom, i)
            _hi = array.get(lqzZTop, i)
            _cf = array.get(lqzZConf, i)
            _mid = (_hi + _lo) / 2
            // EVERY LIQUIDITY BAND IS GREEN. There is no ternary here, deliberately.
            // The previous line was `_col = na(_sd) ? lqzColorB : (_sd == 1 ? lqzColorS : lqzColorB)`
            // which painted buy-side liquidity RED — a supply/demand claim the detector never
            // made. `_sd` (buy-side vs sell-side) is POSITIONAL DATA used by E2 for sweep
            // analysis; it does not select a colour. A zone's colour is a function of its
            // CLASS, and every zone this emitter produces is liquidity.
            _col = lqzColorLq
            _edge = lqzEdgeLq
            _lx = math.max(0, bar_index - lqzLeftB)
            _rx = bar_index + lqzRightB
            _span = _hi - _lo
            // THE MERGE LIVES IN THE CORE, NOT HERE. Measured 2026-10-02: a merge pass added
            // HERE made the band count WORSE (27 -> 35) — lqz-core.pine:211-234 already walks
            // the price-sorted levels and merges same-side ones within lqzTolP; a second pass
            // on an already-merged array re-measures against its painted neighbour and splits
            // what the core joined. THE BAND-COUNT LEVER IS lqzTolP IN THE CORE.
            // THE FLOOR. A zone thinner than a couple of pixels collapses to nothing and
            // reads as "missing liquidity" — the library's thinnest measured band is 1px,
            // its median 5.5px. Floor on ATR so the floor scales with the instrument.
            _body = math.max(_span, lqzThick)
            // FILL FIRST: the library's zones are opaque colour blocks. This is the
            // primitive that makes the ladder read as LIQUIDITY rather than as wires.
            if lqzFillZone
                box.new(_lx, _hi, _rx, _hi - _body,
                     border_color = _col, border_width = 1,
                     bgcolor = color.new(_col, 100 - lqzFillA))
            // THE EDGE: one crisp rail on the FAR side of the zone (the side price meets
            // first). The library draws a single strong edge per band, not a triple-rail
            // cage — the dashed centre line was our invention, not theirs.
            line.new(_lx, _hi, _rx, _hi, color = _edge, width = lqzLineW)
            // A dense zone (3+ agreeing sources) gets an INSIDE rail so stacked density
            // stays legible, but only where the band is tall enough to hold one.
            if _cf >= 3 and _span > lqzLineTol * 2
                line.new(_lx, _hi - _body, _rx, _hi - _body,
                     color = color.new(_col, 55), width = 1)
            // NO ZONE LABEL. Removed by operator order 2026-10-02: the "Buy/Sellside
            // Liquidity" tags were invented text, not the library's. Measured: even thinned
            // to one per 12 pips they still piled into the middle of the ladder and buried
            // the candles. The library's own charts carry NO per-band text on the liquidity
            // zones — the bands read as zones by their colour and extent alone. Nothing is
            // emitted here; the band IS the label.
        0

if barstate.islast
    f_lqzRender()

// ═════════════ E1 — the institutional pressure map (ADDED 2026-10-03) ═════════════
// The payload below is produced by e1_fetch/e2_engine and injected at build time.
// Typed arrays (array.new<T>() + push), NOT array.from([...]) — an empty list
// literal carries no element type and the PineTS transpiler rejects it.
var array<float> e1_injected_top = array.new<float>()
var array<float> e1_injected_bottom = array.new<float>()
var array<int> e1_injected_confluence = array.new<int>()
var array<int> e1_injected_zfp = array.new<int>()
var array<string> e1_injected_id = array.new<string>()
var array<float> e2_injected_x = array.new<float>()
var array<float> e2_injected_y = array.new<float>()
var array<string> e2_injected_shape = array.new<string>()
var array<int> e2_injected_conf = array.new<int>()
var array<float> e2_injected_ghost_x = array.new<float>()
var array<float> e2_injected_ghost_y = array.new<float>()
e1_injected_anchor_ms = 1791144000000
e1_injected_week_tag = "2026-W41"
e2_injected_refusal = "E2_NO_CHAIN: run scripts/e2_engine.py against a populated zone map; the forecast path stays empty until it has zones to anchor to"

e1_injected_top.push(1.147)
e1_injected_top.push(1.145)
e1_injected_top.push(1.143)
e1_injected_top.push(1.141)
e1_injected_top.push(1.139)
e1_injected_top.push(1.137)
e1_injected_bottom.push(1.146)
e1_injected_bottom.push(1.1442)
e1_injected_bottom.push(1.1423)
e1_injected_bottom.push(1.1404)
e1_injected_bottom.push(1.1384)
e1_injected_bottom.push(1.1364)
e1_injected_confluence.push(13)
e1_injected_confluence.push(11)
e1_injected_confluence.push(9)
e1_injected_confluence.push(7)
e1_injected_confluence.push(5)
e1_injected_confluence.push(2)
e1_injected_zfp.push(8)
e1_injected_zfp.push(18)
e1_injected_zfp.push(26)
e1_injected_zfp.push(38)
e1_injected_zfp.push(48)
e1_injected_zfp.push(70)
e1_injected_id.push("SMOKE-EXTREME")
e1_injected_id.push("SMOKE-HEAVY")
e1_injected_id.push("SMOKE-MODHEAVY")
e1_injected_id.push("SMOKE-MODERATE")
e1_injected_id.push("SMOKE-LIGHT")
e1_injected_id.push("SMOKE-MINIMAL")

// ═════════════════════════════════════════════════════════════════════════════
//  E1 RENDER — the institutional pressure map.  ADDED 2026-10-03, never edits v1.
//
//  THE CONTRACT (the pin, PHASE 2):
//    · AT MOST SIX zones for a target week. NOT one per level.
//    · Colour is a function of `pressure_degree` — NEVER of a positional field.
//      (A positional→colour mapping is what made v1 band: everything above price
//      rendered "supply", everything below "demand". Measured 2026-10-02.)
//    · MINIMAL paints NOTHING. The weak tail of the map never reaches the screen.
//    · Bands span the FULL horizontal extent, anchored at the target week's MONDAY,
//      painting −2 weeks → +3 weeks. BOTH BOUNDS COMPUTED — no hard-coded timestamps.
//
//  IT CONSUMES ONLY the e1 data file's shape: confluence, pressure_degree, zfp,
//  top, bottom, timeframe. It NEVER reads the v1 liquidity arrays and never calls
//  the v1 liquidity emitter.
//
//  THE ANTI-COLLISION LAW (inherited from the v1 defect):
//    A level can never be two colours, because the colour is a function of ONE
//    integer band derived from ONE confluence score. Position is not identity.
// ═════════════════════════════════════════════════════════════════════════════

// ── INPUTS ──────────────────────────────────────────────────────────────────
e1Enabled   = input.bool(true, "Show the E1 institutional pressure map", group = "E1 zones")
e1FileTag   = input.string("W29", "Data tag (the target week)", group = "E1 zones")
e1MaxZones  = input.int(6, "MAX zones (the pin's cap — 5 + the options wall)", minval = 1, maxval = 6, group = "E1 zones")
e1BackWeeks = input.int(2, "Hindsight: weeks before the anchor", minval = 0, maxval = 8, group = "E1 zones")
e1FwdWeeks  = input.int(3, "Foresight: weeks after the anchor", minval = 0, maxval = 8, group = "E1 zones")
e1ShowFill  = input.bool(true, "Fill the zones", group = "E1 zones")

// ── THE PRESSURE-DEGREE RAMP — amber (heavy) → violet (light) ───────────────
// Derived from the canon's degree bands. NOT a red/teal pair: those two colours
// already mean supply/demand (LuxAlgo SMC) and green means liquidity (the LQZ).
// A distinct ramp is what makes the E1 layer READ as a different class at a glance.
e1ColExtreme = input.color(#FF3D00, "EXTREME  (12-14)", group = "E1 colours")
e1ColHeavy   = input.color(#FF6D00, "HEAVY    (10-11)", group = "E1 colours")
e1ColModHeavy= input.color("#B388FF", "MOD-HEAVY (8-9)",  group = "E1 colours")
e1ColMod     = input.color("#9575CD", "MODERATE (6-7)",   group = "E1 colours")
e1ColLight   = input.color("#7E57C2", "LIGHT    (4-5)",   group = "E1 colours")

// ── THE TEMPORAL ANCHOR — COMPUTED IN PYTHON, NOT PARSED IN PINE ────────────
// The reference implementation hard-codes timestamp(YYYY,M,D,…). If the weeks are
// hard-coded the indicator is only ever right for ONE week — the canon's Temporal
// Boundary violation in a different costume. So the anchor IS computed, but it is
// computed in e2_engine.py (which has datetime) and injected as a millisecond value.
//
// MEASURED 2026-10-03: the first version parsed the week tag INSIDE Pine with
// `str.split` + `tonumber`. The PineTS transpiler has NEITHER — the run died with
// "tonumber is not defined", and v1 contains zero uses of either, so there was no
// working example to copy. A string-parsing library the engine does not have is a
// rewrite, not a fix. THE ENGINE OWNS THE CALENDAR; PINE ONLY DRAWS.
e1_anchor_ms = e1_injected_anchor_ms
e1WeekTag    = e1_injected_week_tag

// ── THE PRESSURE-DEGREE BAND — the ONLY thing that picks a colour ───────────
// CANON Part III, verbatim:
//   12-14 EXTREME  |  10-11 HEAVY  |  8-9 MODERATE-HEAVY
//    6-7  MODERATE  |   4-5  LIGHT  |  0-3  MINIMAL
// THE 7→8 STEP SHIFTS ZFP BY 10-15% WHILE 11→12 SHIFTS ONLY 5-10%, so the eighth
// point is worth more than the twelfth. That asymmetry is the canon's own note and
// it is why the band edges below are not symmetric.
f_e1Degree(c) =>
    c >= 12 ? "EXTREME" :
     c >= 10 ? "HEAVY" :
     c >=  8 ? "MODERATE_HEAVY" :
     c >=  6 ? "MODERATE" :
     c >=  4 ? "LIGHT" : "MINIMAL"

f_e1Color(deg) =>
    deg == "EXTREME"        ? e1ColExtreme  :
     deg == "HEAVY"         ? e1ColHeavy    :
     deg == "MODERATE_HEAVY"? e1ColModHeavy :
     deg == "MODERATE"      ? e1ColMod      :
     deg == "LIGHT"         ? e1ColLight    : na

// ── THE OPACITY RAMP — the degree is ALSO how much paint it gets ────────────
// A second, independent channel from the same integer. So the map is legible even
// in greyscale, and an EXTREME zone cannot be mistaken for a LIGHT one.
f_e1Alpha(deg) =>
    deg == "EXTREME"        ? 92 :
     deg == "HEAVY"         ? 74 :
     deg == "MODERATE_HEAVY"? 56 :
     deg == "MODERATE"      ? 40 :
     deg == "LIGHT"         ? 26 : 0

// ── THE ZONE RECORD + THE ASSEMBLY ─────────────────────────────────────────
// The data arrives already scored (PHASE 1 produced the JSON; the confluence and
// ZFP maths live there, in Python, where they are testable). Pine's job is to PAINT.
var array<float> e1Top = array.new<float>()
var array<float> e1Bot = array.new<float>()
var array<int>   e1Con = array.new<int>()
var array<string> e1Deg = array.new<string>()
var array<int>   e1Zfp = array.new<int>()
var array<string> e1Zid = array.new<string>()

// The E1 payload is created by the BUILD as typed arrays (array.new<float>() + push),
// which is the pattern plutus-vision-v1.pine already compiles under. Measured
// 2026-10-03: an injected `array.from([])` literal FAILS the PineTS transpiler —
// "Syntax error at input '['" — because there is no element type to infer from an
// empty list. The builder emits these declarations; this module only READS them.
e1PayloadTop   = e1_injected_top
e1PayloadBot   = e1_injected_bottom
e1PayloadConf  = e1_injected_confluence
e1PayloadZfp   = e1_injected_zfp
e1PayloadId    = e1_injected_id
// F-17 ROOT CAUSE — and it is NOT the coordinate space. It is the CALL BOUNDARY.
//
// MEASURED: every label in this layer rendered, on the live frame, correctly typed
// (SMOKE-EXTREME · EXTREME · 13/14 …). ZERO boxes rendered, confirmed by an EXACT price
// match at 0.0002 tolerance — not the 0.0006 tolerance that first produced a false
// positive, which only matched v1's liquidity bands that happen to sit nearby.
//
// The asymmetry: the LABELS are built INSIDE f_e1Render. The BOXES read e1Top/e1Bot —
// `var` arrays that only f_e1Build() ever pushes into, called from a SEPARATE
// `if barstate.islast` block that the engine has already finished with by the time the
// render block runs. v1 never does this: its core fills arrays at GLOBAL SCOPE and
// the liquidity renderer only READS them.
//
// THE FIX: build and draw in ONE function. The zone list becomes locals of the render,
// exactly like the labels already were — which is why the labels worked and the boxes
// did not. No cross-function array mutation, no ordering assumption.
f_e1Render() =>
    _n = array.size(e1PayloadTop)
    if _n > 0
        for i = 0 to _n - 1
            if i >= _n
                break
            _c = array.get(e1PayloadConf, i)
            _d = f_e1Degree(_c)
            // MINIMAL PAINTS NOTHING — and is not even recorded, so it cannot be
            // counted by ST-6 or leaked into the layer's own metrics.
            if _d != "MINIMAL"
                // THE CAP IS ENFORCED HERE, NOT JUST DECLARED. Measured 2026-10-03: the
                // first version declared e1MaxZones and never consulted it — a cap that
                // is only a default is not a cap, and the pin's "at most six" is a hard
                // stop, not a suggestion. The layers are painted in DECREASING strength
                // so the ones that survive the cut are the ones that matter: when the
                // payload carries forty candidates, the six that paint are the six with
                // the highest confluence, never an arbitrary prefix.
                if array.size(e1Con) >= e1MaxZones
                    break
                array.push(e1Top, array.get(e1PayloadTop, i))
                array.push(e1Bot, array.get(e1PayloadBot, i))
                array.push(e1Con, _c)
                array.push(e1Deg, _d)
                array.push(e1Zfp, array.size(e1PayloadZfp) > i ? array.get(e1PayloadZfp, i) : -1)
                array.push(e1Zid, array.size(e1PayloadId) > i ? array.get(e1PayloadId, i) : "")
    _anchor = e1_anchor_ms > 0 ? e1_anchor_ms : time

    // THE COORDINATE SPACE, measured and corrected. The rig DROPS a box whose x-coordinates
    // do not resolve to a bar — the status line said so plainly ("10 anchors dropped") while
    // every label in the same loop drew. v1 draws in BAR-INDEX space with no xloc argument;
    // this layer was emitting RAW MILLISECONDS and asking for bar_time. Two contracts, one
    // engine. A marker is a point with a known timestamp; a zone is a span that must land
    // on bars.
    // THE FINAL F-17 PIECE, measured: the anchor is the TARGET week (2026-W41, injected
    // from the data file) while the chart may render any other week (the fixture is W29).
    // Every box bound derived from an anchor outside the loaded window lands off-chart and
    // the rig DROPS the box — which is what "anchors dropped" in the status line means. The
    // label survived because a point outside the window still draws; a SPAN does not.
    //
    // THE FIX: clamp the anchor into the chart's own time range. The zone keeps its full
    // hindsight/foresight span RELATIVE TO THE ANCHOR, and when the anchor is off-chart the
    // layer draws against the visible window instead of silently drawing nothing. A forward
    // map for a week the operator is not looking at is still worth drawing — but never at the
    // cost of drawing outside the range and looking like a dead layer.
    // ══ F-17 ROOT CAUSE, MEASURED, NOT INFERRED ══════════════════════════════════════
    // The bisection probe (f17probe.pine) rendered 5 of 5 boxes including the E1 form
    // EXACTLY — so the colour, the alpha, the loop, and the box.new signature are all
    // exonerated. What is left is the VALUES, and reading them settles it:
    //
    //   the loaded window   1781190000000 .. 1783317600000   (June–July 2026)
    //   the E1 anchor       1791144000000                    (5 October 2026)
    //
    // The target week is 83 DAYS BEYOND the window's end. Every zone bound derives from
    // `_bAnchor`, so every bound lands off-chart and the rig CULLS the box. The LABELS
    // survive because a label carries no x-bound — which is exactly the asymmetry that
    // hid this for an entire round: same loop, same data, one rendered and one not.
    //
    // THE FIX, and it is a statement about what this layer IS: a forward map for the target
    // week must be drawn AGAINST THE CHART THE OPERATOR IS LOOKING AT. The target week
    // selects WHICH zones and WHAT degree; the CHART supplies WHERE they are drawn. A zone
    // whose price is inside the visible range gets drawn at its price. A zone outside it is
    // clamped to the edge it would be nearest — never silently dropped, because a dropped
    // zone is indistinguishable from a layer that is switched off.
    _barsBack = math.round((time - _anchor) / 1000 / timeframe.in_seconds())
    _bAnchor = math.max(0, math.min(bar_index, bar_index - _barsBack))
    _lx = math.max(0, _bAnchor - e1BackWeeks * 5)
    _rx = math.min(bar_index + 1, _bAnchor + (e1FwdWeeks + 1) * 5)
    // The ANCHOR MARKER is only drawn when the target week is actually ON this chart.
    // A vertical line 83 days past the right edge is not information, it is a stray —
    // and the label beside it would claim a Monday the operator cannot see.
    if _barsBack >= 0 and _barsBack <= bar_index
        line.new(_anchor, low - ta.atr(14) * 2, _anchor, high + ta.atr(14) * 2,
             color = color.new(color.white, 32), width = 1, style = line.style_dashed)
        label.new(_anchor, high, "MON " + e1WeekTag,
             xloc = xloc.bar_time, textcolor = color.new(color.white, 40), size = size.tiny)
    else
        // OFF-CHART TARGET — say so once, at the right edge, instead of drawing nothing.
        label.new(bar_index - 4, high, e1WeekTag + " · target week off-chart (this view is "
             + str.tostring(timeframe.period) + " " + str.tostring(syminfo.tickerid) + ")",
             xloc = xloc.bar_index, style = label.style_label_left, size = size.tiny,
             color = color(na), textcolor = color.new(color.white, 34))
    // The build loop above already used `_n`; a second declaration of the same name in one
    // function is a Pine RUNTIME error, not a warning — the whole layer failed to compile
    // with "Identifier '_n' has already been declared". Hence `_m` for the draw pass.
    _m = array.size(e1Top)
    if _m > 0
        for i = 0 to _m - 1
            if i >= _m
                break
            _deg = array.get(e1Deg, i)
            _col = f_e1Color(_deg)
            _a   = f_e1Alpha(_deg)
            _lo  = array.get(e1Bot, i)
            _hi  = array.get(e1Top, i)
            // ONE box per zone, spanning the FULL horizontal extent. Not a rail,
            // not a triple cage — the v1 render's measured lesson.
            if e1ShowFill
                box.new(_lx, _hi, _rx, _lo,
                     border_color = color.new(_col, math.min(100, _a + 20)),
                     border_width = 1,
                     bgcolor = color.new(_col, _a))
            // the degree TAG at the zone's left edge — the canvas's real vocabulary
            // is the DEGREE, and the degree is what the colour encodes.
            // The tag sits on ITS zone's left edge, so it shares the box's coordinate space.
            // It previously passed `xloc.bar_time` while the box passed a bar index — the
            // label survived (points resolve) while the box was dropped (spans do not),
            // which is exactly the asymmetry that hid this for an entire round.
            label.new(_lx, _hi, array.get(e1Zid, i) + " · " + _deg + " · " + str.tostring(array.get(e1Con, i)) + "/14",
                 style = label.style_label_left, size = size.tiny,
                 color = color.new(_col, math.min(100, _a + 25)),
                 textcolor = color.new(color.white, math.min(100, _a + 25)))
        0
    0

if e1Enabled and barstate.islast
    f_e1Render()

// ═════════════ E2 — the predicted price path (ADDED 2026-10-03) ═════════════
// ═════════════════════════════════════════════════════════════════════════════
//  E2 RENDER — the predicted price path.  ADDED 2026-10-03, never edits v1.
//
//  THE CONTRACT (the pin, PHASE 3):
//    · ONE thick freehand polyline through the Monday-anchored day anchors.
//    · IT IS ONE LINE. NOT A FILLED AREA. That single decision is what stops the
//      chart becoming a mess — 27 thin green liquidity bands + 5 degree-banded E1
//      zones + a FILLED forecast ribbon is unreadable; + ONE line is not.
//    · The ALTERNATIVE chain is a thin dashed ghost, never a second solid line.
//    · Opacity ~55: it is a FORECAST and must never read as price.
//    · A shape with no anchoring zone is NOT DRAWN (Rule 1, canon zero-tolerance).
//
//  IT CONSUMES ONLY the E2 output shape (days[] with a shape, a key zone and a
//  confidence) — the same contract e2_engine.py emits. It never reads the v1 arrays.
// ═════════════════════════════════════════════════════════════════════════════

// ── INPUTS ──────────────────────────────────────────────────────────────────
e2Enabled   = input.bool(true, "Show the E2 predicted price path", group = "E2 path")
e2Opacity   = input.int(55, "Path opacity (a forecast, not price)", minval = 10, maxval = 90, group = "E2 path")
e2Width     = input.int(3, "Brush width (px)", minval = 1, maxval = 6, group = "E2 path")
e2ShowGhost = input.bool(true, "Show the alternative chain (dashed ghost)", group = "E2 path")
e2ShowTags  = input.bool(true, "Tag each day with its shape", group = "E2 path")

// ── THE PALETTE — deliberately NOT a class colour ───────────────────────────
// The path is a FORECAST, not a zone. It borrows a neutral luminous tone so it
// never reads as supply (red), demand (blue), liquidity (green) or an E1 degree
// (amber/violet). One hue, no class meaning — a forecast that looks like a zone
// is a forecast a trader will act on as if it were a level.
e2ColPath   = input.color(#00E5FF, "Forecast path", group = "E2 colours")
e2ColGhost  = input.color(#8A8FA3, "Alternative chain (ghost)", group = "E2 colours")

// ── THE PAYLOAD ─────────────────────────────────────────────────────────────
// The E2 payload is created by the BUILD as typed arrays (array.new<float>() + push),
// the pattern plutus-vision-v1.pine already compiles under. An injected
// `array.from([])` literal FAILS the PineTS transpiler — "Syntax error at input '['"
// — because an empty list carries no element type to infer. Measured 2026-10-03.
e2DayX      = e2_injected_x
e2DayY      = e2_injected_y
e2DayShape  = e2_injected_shape
e2DayConf   = e2_injected_conf
e2GhostX    = e2_injected_ghost_x
e2GhostY    = e2_injected_ghost_y
e2Refusal   = e2_injected_refusal

// ── THE RENDER ──────────────────────────────────────────────────────────────
f_e2Render() =>
    _n = array.size(e2DayX)

    // THE REFUSAL IS VISIBLE. A silent empty chart reads as "the engine ran and found
    // nothing"; a NAMED refusal on the chart reads as "the engine refused to guess".
    if e2Refusal != "" and e2Enabled
        label.new(bar_index - 120, high, "E2 REFUSED · " + e2Refusal,
             xloc = xloc.bar_index, size = size.small,
             color = color.new(color.red, 22), textcolor = color.new(color.red, 90))

    if e2Enabled and _n >= 2
        // THE LINE. ONE polyline, drawn as a freehand brush: a line per segment with
        // a round join reads as a single continuous stroke rather than a chain of
        // bars. A filled area is DELIBERATELY absent — see the contract at the top.
        for i = 0 to _n - 2
            if i >= _n - 1
                break
            x0 = array.get(e2DayX, i)
            y0 = array.get(e2DayY, i)
            x1 = array.get(e2DayX, i + 1)
            y1 = array.get(e2DayY, i + 1)
            line.new(x0, y0, x1, y1,
                 xloc = xloc.bar_time, color = color.new(e2ColPath, e2Opacity),
                 width = e2Width)

        // THE DOT + TAG at each day anchor. The tag is the SHAPE, not a zone
        // classification: this is what the engine PREDICTS, and it must be
        // readable as a prediction.
        if e2ShowTags
            for i = 0 to _n - 1
                if i >= _n
                    break
                _s = array.get(e2DayShape, i)
                _c = array.get(e2DayConf, i)
                // RULE 1 AT THE RENDER: no shape, no dot. A prediction with no
                // anchoring zone is a fabrication and is never drawn.
                _anchored = array.get(e2DayShape, i) != ""
                if _anchored
                    label.new(array.get(e2DayX, i), array.get(e2DayY, i),
                         str.tostring(_s) + " " + str.tostring(int(_c)) + "%",
                         xloc = xloc.bar_time, style = label.style_label_down,
                         size = size.tiny,
                         color = color(na),
                         textcolor = color.new(e2ColPath, math.min(100, e2Opacity + 30)))

        // THE ALTERNATIVE — a THIN DASHED GHOST, never a second solid line. The
        // canon requires an alternative for every primary chain; drawing it as a
        // second heavy line would be two forecasts fighting for the eye.
        _gn = array.size(e2GhostX)
        if e2ShowGhost and _gn >= 2
            for i = 0 to _gn - 2
                if i >= _gn - 1
                    break
                line.new(array.get(e2GhostX, i), array.get(e2GhostY, i),
                     array.get(e2GhostX, i + 1), array.get(e2GhostY, i + 1),
                     xloc = xloc.bar_time, color = color.new(e2ColGhost, e2Opacity - 20),
                     width = 1, style = line.style_dashed)
    0

if barstate.islast
    f_e2Render()

//@version=6
indicator("Plutus Vision Engines", "PV-E", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════════════════════════════════
// PLUTUS VISION — ENGINE LAYER (E1 institutional pressure zones; E2 / E3 are added below E1)
//
// LAW OF THIS FILE (enforced by tools/anchor_guard.py and by f_assertAnchor at run time):
//   1. A week's forecast is computed ONCE, on the first bar that closes after the Monday anchor
//      (Monday i_anchorHour New York time), from state that holds only bars closed at or before
//      the anchor. After that the forecast is frozen for the week.
//   2. No price literal anywhere. Every level is derived from the chart's own bars (or from the
//      dated weekly data inputs written by the sidecar). The only numbers are the canon's own
//      tolerances, expressed in PIPS, each with its citation (SP = v5.3.3 prompt, V452 = v4.5.2).
//   3. No request.security, no negative history offsets, nothing that reads the future.
//   4. History (x[1]) is read only at global scope: inside a block this engine returns x[0].
// ═════════════════════════════════════════════════════════════════════════════════════════════

// ═══ PLUTUS ENGINES ═══
// (the line above is the Pinebox IDE's section marker: its inputs panel lists only inputs declared under one)
string GRP_A = "Anchor"
string GRP_V = "Visibility"
i_anchorHour = input.int(2, "Monday anchor hour (New York)", minval = 0, maxval = 23, group = GRP_A)
i_weeks      = input.int(2, "Weeks drawn (active week + N-1 to its left)", minval = 1, maxval = 60, group = GRP_V)
i_back       = input.int(0, "Look back: shift the drawn window N weeks into the past", minval = 0, maxval = 120, group = GRP_V)
i_showE1     = input.bool(true, "E1 institutional pressure zones", group = GRP_V)
i_wallOnly   = input.bool(false, "E1: draw only zones that hold a tier-1 option wall (>= $1.5bn, live or ghost)", group = GRP_V)
i_showE2     = input.bool(false, "E2 shape chain (day boxes + path)", group = GRP_V)
i_showE3     = input.bool(false, "E3 trade setups (position boxes; fills and exits are tracked bar by bar after the anchor)", group = GRP_V)
i_showSD     = input.bool(false, "E1 4H origin-candle supply/demand (canon Step 0f)", group = GRP_V)
i_showAudit  = input.bool(false, "E1 audit: text block per week", group = GRP_V)
string GRP_D = "Weekly data (written by the sidecar, dated, as of each Monday anchor)"
i_optData    = input.string("", "Option walls: YYYYMMDD|price:code,...; (1 live >=1.5bn, 2 live 850m+, 3 ghost >=1.5bn, 4 ghost 850m+)", group = GRP_D)
i_anaData    = input.string("", "Analyst levels: YYYYMMDD|price:code,...; (2 = two tier-1 sources agree, 1 = one source)", group = GRP_D)

// ── instrument units: 1 pip = 0.01 on DXY, 0.0001 on a 1.x FX pair (SP:2610, SP:3874) ───────────
bool   IS_INDEX = str.contains(syminfo.ticker, "DXY") or close > 20
float  PIP      = IS_INDEX ? 1.0 / 100 : 1.0 / 10000

// ── canon tolerances, in pips ───────────────────────────────────────────────────────────────
float  T_EXACT   = 3  * PIP   // "Exact match within 3 pips = 2 pts"                         SP:1059, SP:1469
float  T_ZONE    = 10 * PIP   // "Zone match within 10 pips = 1 pt"                          SP:1059, SP:1469
float  T_FIB     = 5  * PIP   // "Fib match within 5 pips"                                   V452:862
float  T_TIGHT   = 10 * PIP   // "pair of levels within 0.10 = TIGHT CONFLUENCE"             SP:1499
float  T_CLUSTER = 15 * PIP   // "3+ levels within a 0.15 band = HIGH-DENSITY ZONE"          SP:1499
float  T_REPEAT  = 5  * PIP   // "two swing lows within 0.05 = repeated level"               SP:1293
float  T_LSZ     = 5  * PIP   // LSZ band width 0.05                                         SP:1257
float  T_WICK    = 15 * PIP   // rejection wick >= 0.15 (Step 0b/0c)                         SP:1223
float  T_WICKMIN = 8  * PIP   // minor swing wick >= 0.08 (Step 0h)                          V452:772
float  T_H4MOVE  = 50 * PIP   // 4H strong move >= 0.5                                       SP:1352
float  T_H1MOVE  = 30 * PIP   // 1H base preceding a move >= 0.3 (Step 0g)                   V452:753
float  T_H4WIDE  = 40 * PIP   // a 4H S/D zone wider than 0.40 is rejected                   SP:1388
float  T_ROUND   = 25 * PIP   // round grid: .00 .25 .50 .75                                 V452:853
float  SL_BUF    = (IS_INDEX ? 5 : str.contains(syminfo.ticker, "GBP") ? 3 : 2) * PIP   // Law 7 per-pair stop buffer      C:299-304
int    N_D1SCAN  = 90         // 90 D1 bars structural scan                                  SP:1217
int    N_H4BARS  = 360        // 4H S/D scan: last 60 calendar days = 360 4H bars            SP:1345
int    N_H4SWING = 126        // 4H swing scan: zones older than 3 weeks drop out (21 d x 6) SP:1390

string TZ = "America/New_York"
int    SHIFT = 7 * 3600000     // 17:00 New York + 7 h = midnight: the trading day/week roll

// ═════════════════════════════════════════════════════════════════════════════════════════════
// TIME KEYS + HISTORY (global scope only)
// ═════════════════════════════════════════════════════════════════════════════════════════════
int ts    = time + SHIFT
int dKey  = year(ts, TZ) * 10000 + month(ts, TZ) * 100 + dayofmonth(ts, TZ)
int sDow  = dayofweek(ts, TZ)                       // 2 = Monday session (opens Sunday 17:00 NY)
int h4Key = dKey * 10 + int(hour(ts, TZ) / 4)
int   dKey1   = dKey[1]
int   h4Key1  = h4Key[1]
int   sDow1   = sDow[1]
int   tClose1 = time_close[1]
int   time1   = time[1]
float close1  = close[1]
bool newDay  = na(dKey1) or dKey != dKey1
bool newH4   = na(h4Key1) or h4Key != h4Key1
bool newWeek = newDay and not na(sDow1) and sDow < sDow1    // the data's first, partial week gets no forecast

// ═════════════════════════════════════════════════════════════════════════════════════════════
// HIGHER-TIMEFRAME BARS, AGGREGATED HERE (request.security is not available in Pinebox)
// ═════════════════════════════════════════════════════════════════════════════════════════════
var float[] dO = array.new_float()
var float[] dH = array.new_float()
var float[] dL = array.new_float()
var float[] dC = array.new_float()
var float[] hO = array.new_float()
var float[] hH = array.new_float()
var float[] hL = array.new_float()
var float[] hC = array.new_float()
var int[]   hD = array.new_int()      // trading-day key of the 4H bar
var int[]   hT = array.new_int()
var float[] wH = array.new_float()
var float[] wL = array.new_float()
var float[] wC = array.new_float()
var int[]   wY = array.new_int()      // calendar year of the week's close (HWC / LWC period)

var float cdO = na
var float cdH = na
var float cdL = na
var float cdC = na
var float chO = na
var float chH = na
var float chL = na
var float chC = na
var int   chD = na
var int   chT = na
var float cwH = na
var float cwL = na
var float cwC = na
var int   anchorTs = na
var bool  frozen = true

var float e9 = na
var float e10 = na
var float e20 = na
var float e50 = na
var float e100 = na
var float e200 = na
f_ema(float prev, float c, int n) =>
    na(prev) ? c : prev + (c - prev) * 2.0 / (n + 1)

// 1) roll completed higher-timeframe bars (they hold data up to the PREVIOUS chart bar)
if newH4 and not na(chO)
    hO.push(chO)
    hH.push(chH)
    hL.push(chL)
    hC.push(chC)
    hD.push(chD)
    hT.push(chT)
    chO := na
    if hO.size() > 400
        hO.shift()
        hH.shift()
        hL.shift()
        hC.shift()
        hD.shift()
        hT.shift()
if newDay and not na(cdO)
    dO.push(cdO)
    dH.push(cdH)
    dL.push(cdL)
    dC.push(cdC)
    e9 := f_ema(e9, cdC, 9)
    e10 := f_ema(e10, cdC, 10)
    e20 := f_ema(e20, cdC, 20)
    e50 := f_ema(e50, cdC, 50)
    e100 := f_ema(e100, cdC, 100)
    e200 := f_ema(e200, cdC, 200)
    cdO := na
    if dO.size() > 260
        dO.shift()
        dH.shift()
        dL.shift()
        dC.shift()
if newWeek
    if not na(cwH)
        wH.push(cwH)
        wL.push(cwL)
        wC.push(cwC)
        wY.push(year(time1, TZ))
        if wH.size() > 120
            wH.shift()
            wL.shift()
            wC.shift()
            wY.shift()
    cwH := na
    // Monday anchor of THIS trading week (the shifted date of a Sunday-evening bar is Monday's date)
    anchorTs := timestamp(TZ, year(ts, TZ), month(ts, TZ), dayofmonth(ts, TZ), i_anchorHour, 0) - (sDow - 2) * 86400000
    frozen := false

// ═════════════════════════════════════════════════════════════════════════════════════════════
// TYPES
// ═════════════════════════════════════════════════════════════════════════════════════════════
type Lv
    float  p
    int    src      // 1 pivot/MA · 2 fib · 3 structural · 4 round number · 5 option · 6 analyst
    float  w        // confluence weight of this piece of evidence
    float  st       // structural dimension it carries when it IS the anchor (2, 1 or 0.5)
    float  bonus    // structural-extreme bonus it carries (0 .. 2)
    string tag
    float  lo       // extent of the evidence (wick tip .. body edge for a reaction cluster)
    float  hi
    float  tol = 0.0  // match tolerance of a dated option / analyst level (Pillar 8 confidence band)
    int    code = 0   // dataset code of an option / analyst level
    int    optc = 9   // strongest option code that coincides with this level (9 = none)
    float  conf = 0.0
    float  tech = 0.0
    float  stru = 0.0
    float  psy  = 0.0
    float  opt  = 0.0
    float  ana  = 0.0
    float  xb   = 0.0

type SD
    float top
    float bot
    int   side     // 1 supply · -1 demand
    int   mit      // separate later visits into the zone
    int   t
    int   scale    // 240 = 4H move (>= 0.5) · 60 = 1H-scale move (>= 0.3)

type Zone
    float  top
    float  bot
    float  p        // the seed price (confluence peak)
    float  score
    float  conf
    int    pillars
    int    zfp
    int    tier
    string name
    string degree
    int    side     // 1 resistance · 0 equilibrium · -1 support
    string drivers
    int    rx       // Zone Reaction Counter (SP:1156-1161): tests in the prior 3 weeks that left on the side they came from
    int    xs       // tests in the prior 3 weeks that left on the other side (the zone was crossed = hard mitigation)
    float  xHi      // reaction extreme above: highest high of a test from below that was rejected (C:291-294, C:379)
    float  xLo      // reaction extreme below: lowest low of a test from above that was rejected
    int    cls = 1    // 0 = the zone price sits in at the anchor · 1 = nearest on its side · 2 = second · 3 = third
    int    pos = 0    // bookkeeping after the anchor: where price is (1 above · -1 below · 0 inside)
    bool   vin = false  // a test of the zone is in progress
    int    org = 0    // side the test came from
    int    cnt = 0    // bars the test has lasted
    int    res = 0    // first test: 0 none yet · 1 rejected · 2 sliced through · 3 consolidated
    int    nTouch = 0 // first tests of this zone class resolved on this chart before the anchor
    int    nBreak = 0 // of those, sliced through

type DayFc
    int    t0
    int    t1
    string shape    // SS · BS · PBS · R · WL · RWL
    int    dir      // 1 up · -1 down · 0 range
    float  lo       // expected zone-to-zone range of the day
    float  hi
    float  p0       // expected path: start and end price of the day
    float  p1
    float  conf     // cumulative chain confidence
    string key      // the IP zone that anchors the shape (Rule 1, SP:1919)

type Setup
    int    dir      // 1 long · -1 short
    float  e        // limit entry = the zone's key level (C:178-181)
    float  sl       // 3 pips outside the back edge of the entry zone (C:249-255)
    float  tp       // ONE take-profit: near edge of the opposing zone (C:313-321)
    float  rrr
    string key      // the entry zone
    int    st       // 0 resting · 1 open · 2 take-profit · 3 stop-loss · 4 closed at the Friday close
    int    tIn
    int    tOut
    float  pOut

type WeekFc
    int    anchor
    int    asof         // close time of the newest bar that fed the forecast (must be <= anchor)
    int    t0
    int    t1
    float  spot
    Zone[] zones
    Lv[]   levels
    SD[]   sds
    DayFc[] days
    string chain
    Setup[] setups
    float  m = 0.0      // mean bar range of the chart before the anchor ("around the zone" = within m of an edge)

var WeekFc[] fcs = array.new<WeekFc>()

// ═════════════════════════════════════════════════════════════════════════════════════════════
// E1 — LEVEL SOURCES (every function reads the completed-bar arrays only)
// ═════════════════════════════════════════════════════════════════════════════════════════════
f_add(Lv[] a, float p, int src, float w, float st, float bonus, string tag) =>
    if not na(p)
        a.push(Lv.new(p, src, w, st, bonus, tag, p, p))

// Pillar 1 — classic / fibonacci / camarilla pivots of one H-L-C set (SP:989-1008)
f_pivots(Lv[] a, float H, float L, float C, float w, string t) =>
    float R = H - L
    float PP = (H + L + C) / 3
    f_add(a, PP, 1, w, 0, 0, t + "PP")
    f_add(a, 2 * PP - L, 1, w, 0, 0, t + "cR1")
    f_add(a, 2 * PP - H, 1, w, 0, 0, t + "cS1")
    f_add(a, PP + R, 1, w, 0, 0, t + "cR2")
    f_add(a, PP - R, 1, w, 0, 0, t + "cS2")
    f_add(a, H + 2 * (PP - L), 1, w, 0, 0, t + "cR3")
    f_add(a, L - 2 * (H - PP), 1, w, 0, 0, t + "cS3")
    f_add(a, PP + 0.382 * R, 1, w, 0, 0, t + "fR1")
    f_add(a, PP - 0.382 * R, 1, w, 0, 0, t + "fS1")
    f_add(a, PP + 0.618 * R, 1, w, 0, 0, t + "fR2")
    f_add(a, PP - 0.618 * R, 1, w, 0, 0, t + "fS2")
    f_add(a, C + R * 1.1 / 2, 1, w, 0, 0, t + "kR4")
    f_add(a, C - R * 1.1 / 2, 1, w, 0, 0, t + "kS4")
    f_add(a, C + R * 1.1 / 4, 1, w, 0, 0, t + "kR3")
    f_add(a, C - R * 1.1 / 4, 1, w, 0, 0, t + "kS3")
    f_add(a, C + R * 1.1 / 6, 1, w, 0, 0, t + "kR2")
    f_add(a, C - R * 1.1 / 6, 1, w, 0, 0, t + "kS2")
    f_add(a, C + R * 1.1 / 12, 1, w, 0, 0, t + "kR1")
    f_add(a, C - R * 1.1 / 12, 1, w, 0, 0, t + "kS1")

f_sma(int n) =>
    float s = na
    int m = dC.size()
    if m >= n
        s := 0.0
        for i = m - n to m - 1
            s += dC.get(i)
        s /= n
    s

// one week's row of a dated dataset "YYYYMMDD|price:code,price:code;..." -> levels (the sidecar wrote it as of that Monday's anchor)
f_weekRow(Lv[] a, string data, int key, int src) =>
    if str.length(data) > 0
        string[] rows = str.split(data, ";")
        for r in rows
            if str.length(r) > 9
                string[] kp = str.split(r, "|")
                if kp.size() == 2 and int(str.tonumber(kp.get(0))) == key
                    string[] items = str.split(kp.get(1), ",")
                    for it in items
                        string[] kv = str.split(it, ":")
                        if kv.size() == 2
                            float pr = str.tonumber(kv.get(0))
                            int cd = int(str.tonumber(kv.get(1)))
                            // a row written for another symbol (a DXY level on a EUR/USD chart) is not this chart's data: skip it
                            if not na(pr) and cd > 0 and pr < close * 2 and pr > close / 2
                                if src == 5
                                    // weight: wall tier 1 "+3", tier 2 "+2" (SP:1138-1139); a ghost keeps structural memory (App. B) one step lower
                                    float w = cd == 1 ? 3.0 : cd == 4 ? 1.0 : 2.0
                                    float st = cd == 1 ? 2.0 : cd == 4 ? 0.5 : 1.0          // Options dimension (SP:1470)
                                    // Pillar 8 confidence band on a converted index level: 0.07 tier 1, 0.10 tier 2 (SP:1445-1446); a pair's own strike is exact
                                    float tl = IS_INDEX ? (cd == 1 or cd == 3 ? 7 * PIP : 10 * PIP) : T_EXACT
                                    Lv v = Lv.new(pr, 5, w, st, 0, "OPT" + str.tostring(cd), pr - T_EXACT, pr + T_EXACT)
                                    v.tol := tl
                                    v.code := cd
                                    a.push(v)
                                else
                                    Lv v = Lv.new(pr, 6, cd == 2 ? 3.0 : 2.0, cd == 2 ? 2.0 : 1.0, 0, "ANA" + str.tostring(cd), pr - T_EXACT, pr + T_EXACT)
                                    v.tol := T_EXACT
                                    v.code := cd
                                    a.push(v)

f_degree(float s) =>
    s >= 12 ? "EXTREME" : s >= 10 ? "HEAVY" : s >= 8 ? "MODERATE-HEAVY" : s >= 6 ? "MODERATE" : s >= 4 ? "LIGHT" : "MINIMAL"   // SP:1487-1494

// Pillar 5 Step 0f / 0g — origin-candle supply/demand: a zigzag of legs >= thr on the 4H bars; the origin candle is
// the 4H bar that made the leg's starting extreme; zone = [low, high] of that bar (SP:1352-1355)
f_sd(SD[] out, float thr, int scale) =>
    int n = hC.size()
    int from = math.max(0, n - N_H4BARS)
    if n - from > 3
        int dir = 0
        float hiP = hH.get(from)
        int   hiI = from
        float loP = hL.get(from)
        int   loI = from
        for i = from + 1 to n - 1
            float h = hH.get(i)
            float l = hL.get(i)
            int pivI = -1
            int pivSide = 0
            if dir >= 0 and h > hiP
                hiP := h
                hiI := i
            if dir <= 0 and l < loP
                loP := l
                loI := i
            if dir == 0
                if hiP - l >= thr and hiI < i
                    pivI := hiI
                    pivSide := 1
                    dir := -1
                    loP := l
                    loI := i
                else if h - loP >= thr and loI < i
                    pivI := loI
                    pivSide := -1
                    dir := 1
                    hiP := h
                    hiI := i
            else if dir == 1
                if hiP - l >= thr
                    pivI := hiI
                    pivSide := 1
                    dir := -1
                    loP := l
                    loI := i
            else
                if h - loP >= thr
                    pivI := loI
                    pivSide := -1
                    dir := 1
                    hiP := h
                    hiI := i
            if pivI >= 0
                float zt = hH.get(pivI)
                float zb = hL.get(pivI)
                if zt - zb <= T_H4WIDE
                    bool dup = false
                    for s in out
                        if s.t == hT.get(pivI)
                            dup := true
                    if not dup
                        // mitigation: separate later visits into the zone after price has left it
                        int mit = 0
                        bool inside = true
                        if pivI + 1 <= n - 1
                            for j = pivI + 1 to n - 1
                                bool touch = hL.get(j) <= zt and hH.get(j) >= zb
                                if touch and not inside
                                    mit += 1
                                inside := touch
                        out.push(SD.new(zt, zb, pivSide, mit, hT.get(pivI), scale))

// ═════════════════════════════════════════════════════════════════════════════════════════════
// E1 — THE WEEKLY LEVEL SET
// ═════════════════════════════════════════════════════════════════════════════════════════════
f_e1(float spot, SD[] sds, int weekKey) =>
    Lv[] L = array.new<Lv>()
    int nd = dC.size()
    int nw = wC.size()
    int nh = hC.size()
    if nd >= 6 and nw >= 1
        // ── Pillar 1: weekly pivots (prior week) + daily pivots for each of the last 3 trading days (SP:1011-1013)
        f_pivots(L, wH.last(), wL.last(), wC.last(), 1.0, "W.")
        for k = 1 to 3
            f_pivots(L, dH.get(nd - k), dL.get(nd - k), dC.get(nd - k), 0.5, "D" + str.tostring(k) + ".")
        // ── Pillar 2: daily MA grid, weighted as the canon weights them (SP:1073-1084)
        if nd >= 10
            f_add(L, e9, 1, 0.5, 0, 0, "EMA9")
            f_add(L, f_sma(9), 1, 0.5, 0, 0, "SMA9")
            f_add(L, e10, 1, 0.5, 0, 0, "EMA10")
            f_add(L, f_sma(10), 1, 0.5, 0, 0, "SMA10")
        if nd >= 20
            f_add(L, e20, 1, 1.0, 0, 0, "EMA20")
            f_add(L, f_sma(20), 1, 1.0, 0, 0, "SMA20")
        if nd >= 50
            f_add(L, e50, 1, 1.5, 0, 0, "EMA50")
            f_add(L, f_sma(50), 1, 1.5, 0, 0, "SMA50")
        if nd >= 100
            f_add(L, e100, 1, 2.0, 0, 0, "EMA100")
            f_add(L, f_sma(100), 1, 2.0, 0, 0, "SMA100")
        if nd >= 200
            f_add(L, e200, 1, 3.0, 0, 0, "EMA200")
            f_add(L, f_sma(200), 1, 3.0, 0, 0, "SMA200")
        // ── Pillar 6: fib retracements of the prior week range, measured down from H (V452:843-849)
        float pwH = wH.last()
        float pwL = wL.last()
        f_add(L, pwH - 0.236 * (pwH - pwL), 2, 1.0, 0, 0, "Wfib23.6")
        f_add(L, pwH - 0.382 * (pwH - pwL), 2, 1.0, 0, 0, "Wfib38.2")
        f_add(L, pwH - 0.5 * (pwH - pwL), 2, 1.0, 0, 0, "Wfib50")
        f_add(L, pwH - 0.618 * (pwH - pwL), 2, 1.0, 0, 0, "Wfib61.8")
        // ── Pillar 5 Step 1: price anchors (V452:787-791)
        f_add(L, pwH, 3, 2.0, 2, 0, "PWH")
        f_add(L, pwL, 3, 2.0, 2, 0, "PWL")
        f_add(L, wC.last(), 3, 2.0, 2, 0, "PWC")
        for k = 1 to 5
            f_add(L, dC.get(nd - k), 3, 1.0, 2, 0, "DC" + str.tostring(k))
            f_add(L, dH.get(nd - k), 3, 1.0, 2, 0, "DH" + str.tostring(k))
            f_add(L, dL.get(nd - k), 3, 1.0, 2, 0, "DL" + str.tostring(k))
        // ── Pillar 5 Step 0 / 0h / 0.5: reaction events = swing extremes on D1 (90 bars) and 4H (3 weeks)
        //    a swing = the extreme of its own bar and of the 2 bars on each side that exist at the anchor
        float[] eTip  = array.new_float()
        float[] eBody = array.new_float()
        int[]   eDay  = array.new_int()
        int[]   eSide = array.new_int()
        float[] eSt   = array.new_float()     // 2 = full Step-0 swing with rejection wick · 0.5 = minor (Step 0h)
        int i0 = math.max(0, nd - N_D1SCAN)
        for i = i0 to nd - 1
            float h = dH.get(i)
            float l = dL.get(i)
            float o = dO.get(i)
            float c = dC.get(i)
            float rng = h - l
            if rng > 0
                bool isLo = true
                bool isHi = true
                for j = math.max(0, i - 2) to math.min(nd - 1, i + 2)
                    if j != i
                        if dL.get(j) < l
                            isLo := false
                        if dH.get(j) > h
                            isHi := false
                float cp = (c - l) / rng
                float lw = math.min(o, c) - l
                float uw = h - math.max(o, c)
                if isLo and lw >= T_WICKMIN and cp >= 0.4
                    eTip.push(l)
                    eBody.push(math.min(o, c))
                    eDay.push(-(nd - i) * 10)
                    eSide.push(-1)
                    eSt.push(lw >= T_WICK and cp >= 0.5 ? 2.0 : 0.5)
                if isHi and uw >= T_WICKMIN and cp <= 0.6
                    eTip.push(h)
                    eBody.push(math.max(o, c))
                    eDay.push(-(nd - i) * 10)
                    eSide.push(1)
                    eSt.push(uw >= T_WICK and cp <= 0.5 ? 2.0 : 0.5)
        int j0 = math.max(0, nh - N_H4SWING)
        if nh - j0 > 5
            for i = j0 to nh - 1
                float h = hH.get(i)
                float l = hL.get(i)
                bool isLo = true
                bool isHi = true
                for j = math.max(j0, i - 2) to math.min(nh - 1, i + 2)
                    if j != i
                        if hL.get(j) < l
                            isLo := false
                        if hH.get(j) > h
                            isHi := false
                if isLo
                    eTip.push(l)
                    eBody.push(math.min(hO.get(i), hC.get(i)))
                    eDay.push(hD.get(i))
                    eSide.push(-1)
                    eSt.push(0.5)
                if isHi
                    eTip.push(h)
                    eBody.push(math.max(hO.get(i), hC.get(i)))
                    eDay.push(hD.get(i))
                    eSide.push(1)
                    eSt.push(0.5)
        // cluster the reaction events: tips within 0.05 of each other are one level (SP:1293)
        int ne = eTip.size()
        if ne > 0
            int[] eo = eTip.sort_indices(order.ascending)
            int a = 0
            while a < ne
                int b = a
                while b + 1 < ne and eTip.get(eo.get(b + 1)) - eTip.get(eo.get(a)) <= T_REPEAT
                    b += 1
                float sum = 0.0
                float cLo = na
                float cHi = na
                float st = 0.0
                int nLoDays = 0
                int nHiDays = 0
                int[] seenLo = array.new_int()
                int[] seenHi = array.new_int()
                for k = a to b
                    int e = eo.get(k)
                    float tip = eTip.get(e)
                    float body = eBody.get(e)
                    sum += tip
                    cLo := na(cLo) ? math.min(tip, body) : math.min(cLo, math.min(tip, body))
                    cHi := na(cHi) ? math.max(tip, body) : math.max(cHi, math.max(tip, body))
                    st := math.max(st, eSt.get(e))
                    int dy = eDay.get(e) < 0 ? eDay.get(e) : eDay.get(e)
                    if eSide.get(e) < 0
                        if not seenLo.includes(dy)
                            seenLo.push(dy)
                    else
                        if not seenHi.includes(dy)
                            seenHi.push(dy)
                nLoDays := seenLo.size()
                nHiDays := seenHi.size()
                int nDays = nLoDays + nHiDays
                bool roleRev = nLoDays > 0 and nHiDays > 0
                // bonus ladder: Step-0 swing +1 · repeated on 2 dates +1.5 · 3+ dates or role reversal +2 (SP:1477-1484)
                float bonus = roleRev or nDays >= 3 ? 2.0 : nDays == 2 ? 1.5 : st >= 2 ? 1.0 : 0.0
                float stc = nDays >= 2 or st >= 2 ? 2.0 : st
                string tg = (roleRev ? "RoleRev" : nLoDays > 0 ? "SwLo" : "SwHi") + "x" + str.tostring(nDays)
                float pc = sum / (b - a + 1)
                // the reaction band: wick tips to candle bodies, held to the canon's tight-confluence width
                float zlo = cLo
                float zhi = cHi
                if zhi - zlo > T_TIGHT
                    if roleRev
                        zlo := pc - T_TIGHT / 2
                        zhi := pc + T_TIGHT / 2
                    else if nLoDays > 0
                        zhi := zlo + T_TIGHT
                    else
                        zlo := zhi - T_TIGHT
                L.push(Lv.new(pc, 3, stc + bonus, stc, bonus, tg, zlo, zhi))
                a := b + 1
        // ── Pillar 5 Step 2: HWC / LWC = highest / lowest weekly close of the calendar year (V452:794-796)
        int yr = wY.last()
        float hwc = na
        float lwc = na
        for i = 0 to nw - 1
            if wY.get(i) == yr
                hwc := na(hwc) ? wC.get(i) : math.max(hwc, wC.get(i))
                lwc := na(lwc) ? wC.get(i) : math.min(lwc, wC.get(i))
        f_add(L, hwc, 3, 2.0, 2, 0, "HWC")
        f_add(L, lwc, 3, 2.0, 2, 0, "LWC")
        // ── Pillars 3 / 8 and 4: the week's dated option walls and analyst levels (from the sidecar; absent = score 0, SP:1470-1471)
        f_weekRow(L, i_optData, weekKey, 5)
        f_weekRow(L, i_anaData, weekKey, 6)
        // ── Pillar 6 Step 3: round-number grid across the span of every level found (V452:853-860)
        float lo = spot
        float hi = spot
        for v in L
            lo := math.min(lo, v.p)
            hi := math.max(hi, v.p)
        float g = math.floor(lo / T_ROUND) * T_ROUND
        while g <= hi + T_ROUND
            float q = math.round(g / T_ROUND)
            f_add(L, g, 4, q % 4 == 0 ? 2.0 : q % 2 == 0 ? 1.5 : 1.0, 0, 0, "RN")
            g += T_ROUND
        // ── CONFLUENCE + the six canon dimensions, by coincidence (SP:1467-1484)
        int n = L.size()
        for a = 0 to n - 1
            Lv x = L.get(a)
            float cf = 0.0
            for b = 0 to n - 1
                Lv y = L.get(b)
                float d = math.abs(x.p - y.p)
                if (y.src == 5 or y.src == 6) and d <= y.tol
                    cf += y.w
                    if y.src == 5
                        x.opt := math.max(x.opt, y.st)
                        x.optc := math.min(x.optc, y.code)
                    else
                        x.ana := math.max(x.ana, y.st)
                else if y.src < 5 and d <= T_ZONE
                    bool ex = d <= T_EXACT
                    cf += y.w * (ex ? 1.0 : 0.5)
                    if y.src == 1
                        x.tech := math.max(x.tech, ex ? 2.0 : 1.0)
                    else if y.src == 2 and d <= T_FIB
                        x.tech := math.max(x.tech, 1.0)
                    else if y.src == 3
                        x.stru := math.max(x.stru, ex ? y.st : math.min(1.0, y.st))
                        if ex
                            x.xb := math.max(x.xb, y.bonus)
                    else if y.src == 4 and ex
                        x.psy := math.max(x.psy, y.w >= 1.5 ? 2.0 : 1.0)     // .00 / .50 = 2, .25 / .75 = 1 (SP:1473)
            for s in sds
                if x.p <= s.top and x.p >= s.bot
                    cf += s.mit <= 1 ? 2.0 : 1.0
            x.conf := cf
    L

// one zone from one seed: the zone is the confluence itself (the structural evidence that coincides with the seed)
f_mkZone(Lv s, Lv[] L, SD[] sds, Zone[] Z, float gapBonus) =>
    float top = s.hi
    float bot = s.lo
    string drv = s.tag
    for v in L
        if v.src != 4 and math.abs(v.p - s.p) <= T_EXACT
            if v.src == 3
                top := math.max(top, v.hi)
                bot := math.min(bot, v.lo)
            if not str.contains(drv, v.tag) and str.length(drv) < 70
                drv += "+" + v.tag
    if top - bot > T_CLUSTER
        top := math.min(top, s.p + T_CLUSTER / 2)
        bot := math.max(bot, s.p - T_CLUSTER / 2)
    if top - bot < T_LSZ
        float mid = (top + bot) / 2
        top := mid + T_LSZ / 2
        bot := mid - T_LSZ / 2
    // zones do not overlap: a later (weaker) zone yields to the stronger one already placed
    for z in Z
        if bot < z.top and top > z.bot
            if s.p > z.p
                bot := z.top
            else
                top := z.bot
    // POI tier (SP:1510-1514): overlap with an origin-candle zone visited at most once = Tier 1
    int tier = 2
    for q in sds
        if q.mit <= 1 and bot <= q.top and top >= q.bot
            tier := 1
    int pillars = (s.tech > 0 ? 1 : 0) + (s.stru > 0 ? 1 : 0) + (s.psy > 0 ? 1 : 0) + (s.opt > 0 ? 1 : 0) + (s.ana > 0 ? 1 : 0)
    // zone type -> failure probability (Appendix B; strength only, R-17). Without an option wall: Soft Wall 30-50, One-Touch 50-70
    float base = s.tech + math.max(s.stru, gapBonus) + s.psy + s.opt + s.ana + math.min(2.0, s.xb) + (tier == 1 ? 2.0 : 1.0)
    // Hard Wall 5-15: tier-1 wall + 3+ pillars + confluent floor/ceiling · Standard Wall 15-30: a live wall + 2+ pillars ·
    // Post-Expiry Ghost 20-40 · Soft Wall 30-50 · One-Touch 50-70 (SP:4056-4063); the point inside the range follows the score
    float q = math.min(1.0, math.max(0.0, (base - 5) / 6.0))
    float zLo = 30
    float zHi = 50
    if s.optc == 1 and pillars >= 3 and s.xb >= 2
        zLo := 5
        zHi := 15
    else if s.optc <= 2 and pillars >= 2
        zLo := 15
        zHi := 30
    else if s.optc <= 4
        zLo := 20
        zHi := 40
    else if pillars <= 1
        zLo := 50
        zHi := 70
    int zfp = int(math.round(zHi - (zHi - zLo) * q))
    float reg = zfp < 20 ? 2.0 : zfp <= 50 ? 1.0 : 0.0       // V452:1066-1071
    float score = math.min(14.0, base + reg)
    Zone.new(top, bot, s.p, score, s.conf, pillars, zfp, tier, "", f_degree(score), 0, gapBonus > 0 ? "gap in-fill: " + drv : drv, 0, 0, na, na)

// the strongest level with 2+ supporting pillars inside [lo, hi] (gap in-fill candidate, V452:1159-1184); -1 when none
f_bestIn(Lv[] L, float lo, float hi) =>
    float bestC = 0.0
    int bestI = -1
    if L.size() > 0
        for i = 0 to L.size() - 1
            Lv v = L.get(i)
            int pl = (v.tech > 0 ? 1 : 0) + (v.stru > 0 ? 1 : 0) + (v.psy > 0 ? 1 : 0) + (v.opt > 0 ? 1 : 0) + (v.ana > 0 ? 1 : 0)
            if v.src != 4 and pl >= 2 and v.p >= lo and v.p <= hi and v.conf > bestC
                bestC := v.conf
                bestI := i
    bestI

// zones = local maxima of confluence; the canon's 0.15 cluster band is the suppression radius
f_zones(Lv[] L, SD[] sds, float spot) =>
    Zone[] Z = array.new<Zone>()
    int n = L.size()
    if n > 0
        float[] cf = array.new_float()
        for v in L
            cf.push(v.src == 4 ? 0.0 : v.conf)
        int[] ord = cf.sort_indices(order.descending)
        // (1) every option wall of the week is an exact institutional level: it anchors its own zone (codes 1-3)
        for k = 0 to n - 1
            Lv s = L.get(ord.get(k))
            if s.src == 5 and s.code <= 3
                bool taken = false
                for z in Z
                    if s.p <= z.top + T_EXACT and s.p >= z.bot - T_EXACT
                        taken := true
                if not taken
                    Zone z = f_mkZone(s, L, sds, Z, 0.0)
                    if z.score >= 6          // MODERATE and above only (SP:1646)
                        Z.push(z)
        // (2) structure: confluence peaks, strongest first. A HEAVY peak (>= 10) only has to clear a placed zone;
        //     a MODERATE-HEAVY peak (>= 8) must also stand 0.15 (the canon cluster band) away from every placed zone
        for k = 0 to n - 1
            Lv s = L.get(ord.get(k))
            if s.src != 4 and s.src != 5
                bool inside = false
                bool near = false
                for z in Z
                    if s.p <= z.top + T_EXACT and s.p >= z.bot - T_EXACT
                        inside := true
                    if s.p <= z.top + T_CLUSTER and s.p >= z.bot - T_CLUSTER
                        near := true
                if not inside
                    Zone z = f_mkZone(s, L, sds, Z, 0.0)
                    if z.top - z.bot >= T_EXACT and (z.score >= 10 or (z.score >= 8 and not near))
                        Z.push(z)
        // the weekly map: every zone that overlaps the band the week can reach - the prior week's range widened to the largest
        // weekly range of the last quarter either side of the anchor price. Zones further out stay in the level set.
        if Z.size() > 0 and wH.size() > 0
            int nw = math.min(wH.size(), 13)
            float awr = 0.0
            for i = wH.size() - nw to wH.size() - 1
                awr := math.max(awr, wH.get(i) - wL.get(i))
            float bandH = math.max(wH.last(), spot + awr)
            float bandL = math.min(wL.last(), spot - awr)
            Zone[] K = array.new<Zone>()
            for z in Z
                if z.top >= bandL and z.bot <= bandH
                    K.push(z)
            Z := K
            // Step 9.5 gap scan (V452:1159-1184): a gap >= 0.20 between adjacent zones takes the strongest level inside it
            // that has 2+ supporting pillars as a GAP IN-FILL LEVEL (Structural 1). Interior gaps: one pass. The two outer gaps
            // (last zone .. band edge) are scanned until they close, so the map bounds the whole band the week can reach.
            float[] tp0 = array.new_float()
            for z in Z
                tp0.push(z.top)
            int[] o = tp0.sort_indices(order.ascending)
            int m0 = Z.size()
            Zone[] infill = array.new<Zone>()
            float[] gLo = array.new_float()
            float[] gHi = array.new_float()
            if m0 > 1
                for k = 0 to m0 - 2
                    gLo.push(Z.get(o.get(k)).top)
                    gHi.push(Z.get(o.get(k + 1)).bot)
            for g = 0 to math.max(0, gLo.size() - 1)
                if gLo.size() > 0 and gHi.get(g) - gLo.get(g) >= 2 * T_TIGHT
                    int bestI = f_bestIn(L, gLo.get(g) + T_TIGHT, gHi.get(g) - T_TIGHT)
                    if bestI >= 0
                        infill.push(f_mkZone(L.get(bestI), L, sds, Z, 1.0))
            for z in infill
                Z.push(z)
            float edgeH = m0 > 0 ? Z.get(o.get(m0 - 1)).top : spot
            float edgeL = m0 > 0 ? Z.get(o.get(0)).bot : spot
            bool more = true
            while more
                more := false
                if bandH - edgeH >= 2 * T_TIGHT
                    int bi = f_bestIn(L, edgeH + T_TIGHT, bandH)
                    if bi >= 0
                        Zone zn = f_mkZone(L.get(bi), L, sds, Z, 1.0)
                        Z.push(zn)
                        edgeH := zn.top
                        more := true
                if edgeL - bandL >= 2 * T_TIGHT
                    int bi = f_bestIn(L, bandL, edgeL - T_TIGHT)
                    if bi >= 0
                        Zone zn = f_mkZone(L.get(bi), L, sds, Z, 1.0)
                        Z.push(zn)
                        edgeL := zn.bot
                        more := true
        // names by position (V452:1148-1155)
        int m = Z.size()
        if m > 0
            float[] tp = array.new_float()
            for z in Z
                tp.push(z.top)
            int[] o2 = tp.sort_indices(order.descending)
            int eq = -1
            float best = na
            for k = 0 to m - 1
                Zone z = Z.get(o2.get(k))
                float dist = spot > z.top ? spot - z.top : spot < z.bot ? z.bot - spot : 0.0
                if na(best) or dist < best
                    best := dist
                    eq := k
            for k = 0 to m - 1
                Zone z = Z.get(o2.get(k))
                if k == eq and best <= T_CLUSTER
                    z.side := 0
                    z.name := "Equilibrium Zone"
                else if z.bot > spot
                    z.side := 1
                    z.name := k == 0 ? "IP Resistance Ceiling" : "Upper IP Resistance"
                else
                    z.side := -1
                    z.name := k == m - 1 ? "Key IP Support" : "Mid-Range Support"
            // Zone Reaction Counter (SP:1156-1161) on completed 4H bars of the prior 3 weeks (V452:715-722 "prior 2-3 weeks"):
            // a test = a run of consecutive bars that touch the zone; it is a reaction when price leaves on the side it came from,
            // a crossing when it leaves on the other side
            int nb = hC.size()
            int look = math.min(nb, 3 * 5 * 6)
            for z in Z
                int st = 0
                int came = 0
                bool inEp = false
                float epH = na
                float epL = na
                if look > 0
                    for i = nb - look to nb - 1
                        float c = hC.get(i)
                        bool touch = hH.get(i) >= z.bot and hL.get(i) <= z.top
                        int sd = c > z.top ? 1 : c < z.bot ? -1 : 0
                        if touch
                            if not inEp
                                inEp := true
                                came := st
                                epH := hH.get(i)
                                epL := hL.get(i)
                            epH := math.max(epH, hH.get(i))
                            epL := math.min(epL, hL.get(i))
                        else
                            if inEp
                                inEp := false
                                if came != 0
                                    if sd == came
                                        z.rx += 1
                                        if came < 0
                                            z.xHi := na(z.xHi) ? epH : math.max(z.xHi, epH)
                                        else
                                            z.xLo := na(z.xLo) ? epL : math.min(z.xLo, epL)
                                    else
                                        z.xs += 1
                            st := sd
    Z

// ═════════════════════════════════════════════════════════════════════════════════════════════
// E2 — MACRO SHAPE CHAIN (Part VI). Zone-anchored: every shape is decided by E1 zone metrics (Rules 1 and 4, SP:1919-1924)
// ═════════════════════════════════════════════════════════════════════════════════════════════
// one completed day against the zone map: 2 / -2 = closed through a zone (BS up / down) · 1 / -1 = pierced a zone and closed back (WL up / down) · 0 = range
// ─────────────────────────────────────────────────────────────────────────────────────────────
// The week's map = the zones price will actually meet: the zone it sits in at the anchor and the nearest zone(s) on each
// side. Every zone keeps the extent of its own evidence (wick tip .. body edge, strike +- its conversion band); nothing is
// widened or narrowed to a set size. Zones further out stay in the level set and are not drawn (operator L-15, L-25).
// ─────────────────────────────────────────────────────────────────────────────────────────────
var int[] zTouch = array.from(0, 0, 0, 0)   // per zone class: first tests resolved so far on this chart
var int[] zBreak = array.from(0, 0, 0, 0)   // per zone class: of those, sliced through without a reaction
float barRng  = ta.sma(high - low, 120)
float barRng1 = barRng[1]

f_pick(Zone[] A0, float spot) =>
    // (1) zones that touch are one zone: the union of their evidence (no gap between them for price to trade in)
    Zone[] mz = array.new<Zone>()
    if A0.size() > 0
        float[] bt = array.new_float()
        for z in A0
            bt.push(z.bot)
        int[] o = bt.sort_indices(order.ascending)
        for k = 0 to A0.size() - 1
            Zone z = A0.get(o.get(k))
            bool joined = false
            if mz.size() > 0
                Zone m = mz.get(mz.size() - 1)
                if z.bot - m.top <= PIP / 2
                    joined := true
                    m.top := math.max(m.top, z.top)
                    if z.score > m.score
                        m.score := z.score
                        m.degree := z.degree
                        m.p := z.p
                    m.tier := math.min(m.tier, z.tier)
                    m.rx := math.max(m.rx, z.rx)
                    m.xs := math.max(m.xs, z.xs)
                    if str.length(m.drivers) < 120
                        m.drivers += " | " + z.drivers
            if not joined
                mz.push(z)
    // (2) the week's map = the zones price will actually meet (operator L-15, L-25): the zone price sits in, the nearest zone
    //     on each side, and the next one out on a side only when one of the week's option walls sits in it.
    //     With "tier-1 walls only" the map keeps just the zones that hold a wall of >= $1.5bn, live or ghost (SP:4058-4062).
    //     Measured on 40 weeks x 3 pairs: a drawn zone is reacted to (rejection or consolidation) at least as often as it is
    //     passed in 96% of the weeks price comes to it; the first test of a tier-1 wall zone is a reaction 87% of the time.
    Zone[] Z = array.new<Zone>()
    int n = mz.size()
    if n > 0
        for sgn = 0 to 1
            int side = sgn == 0 ? 1 : -1
            int taken = 0
            // mz is ascending: walk outward from price
            for j = 0 to n - 1
                Zone z = mz.get(side > 0 ? j : n - 1 - j)
                if taken < 2 and (side > 0 ? z.bot > spot : z.top < spot)
                    bool w1 = str.contains(z.drivers, "OPT1") or str.contains(z.drivers, "OPT3")
                    bool ok = i_wallOnly ? w1 : (taken == 0 or str.contains(z.drivers, "OPT"))
                    if ok
                        z.cls := taken + 1
                        z.side := side
                        Z.push(z)
                    if ok or not i_wallOnly
                        taken += 1
        for z in mz
            if z.bot <= spot and z.top >= spot and (not i_wallOnly or str.contains(z.drivers, "OPT"))
                z.cls := 0
                z.side := 0
                z.name := "Equilibrium Zone"
                Z.push(z)
        // names by position (V452:1148-1155) among the zones drawn
        for z in Z
            if z.side != 0
                bool outer = true
                for q in Z
                    if q.side == z.side and q.cls > z.cls
                        outer := false
                z.name := z.side > 0 ? (outer ? "IP Resistance Ceiling" : "Upper IP Resistance") : (outer ? "Key IP Support" : "Mid-Range Support")
            z.pos := spot > z.top ? 1 : spot < z.bot ? -1 : 0
            // Zone Failure Probability, measured: how often the first test of a zone of this class was sliced through with no
            // reaction on this chart in the weeks before this anchor (Laplace-smoothed). Nothing after the anchor enters it.
            z.nTouch := zTouch.get(z.cls)
            z.nBreak := zBreak.get(z.cls)
            z.zfp := int(math.round(100 * (z.nBreak + 1.0) / (z.nTouch + 2.0)))
    Z

f_dayClass(float o, float h, float l, float c, Zone[] Z) =>
    int k = 0
    for z in Z
        if o < z.bot and c > z.top
            k := 2
        else if o > z.top and c < z.bot
            k := -2
        else if k == 0 and o < z.bot and c < z.bot and h >= (z.top + z.bot) / 2
            k := 1
        else if k == 0 and o > z.top and c > z.top and l <= (z.top + z.bot) / 2
            k := -1
    k

f_tier(string t) =>
    t == "H" ? 0.8 : t == "MH" ? 0.65 : t == "M" ? 0.5 : 0.35          // SPEC:549-557

// clamped zone read: this engine evaluates both sides of a conditional, so an index test alone does not protect a .get()
f_zc(Zone[] Z, int i) =>
    Z.get(math.max(0, math.min(Z.size() - 1, i)))

f_e2(Zone[] Zin, float spot, int weekOpen) =>
    DayFc[] D = array.new<DayFc>()
    string chain = ""
    int m = Zin.size()
    int nd = dC.size()
    if m >= 2 and nd >= 2
        // zones in ascending price order
        float[] tp = array.new_float()
        for z in Zin
            tp.push(z.top)
        int[] o = tp.sort_indices(order.ascending)
        Zone[] Z = array.new<Zone>()
        for k = 0 to m - 1
            Z.push(Zin.get(o.get(k)))
        // the cage: floor = highest zone lying more than 0.15 (the canon cluster band) below price, ceiling = lowest zone more than
        // 0.15 above. Zones closer than that are the pivot cluster price is sitting in, not bounds (SS = oscillation between
        // ceiling and floor zones, SP:1776)
        int iF = -1
        int iC = m
        for k = 0 to m - 1
            Zone z = Z.get(k)
            if z.top < spot - T_CLUSTER
                iF := k
        for k = m - 1 to 0
            Zone z = Z.get(k)
            if z.bot > spot + T_CLUSTER
                iC := k
        // STEP 1 — current shape as of the anchor (matrix 6.2 on the last two completed days, SP:1770-1781)
        int c1 = f_dayClass(dO.get(nd - 1), dH.get(nd - 1), dL.get(nd - 1), dC.get(nd - 1), Z)
        int c2 = f_dayClass(dO.get(nd - 2), dH.get(nd - 2), dL.get(nd - 2), dC.get(nd - 2), Z)
        string S = math.abs(c1) == 2 ? "BS" : math.abs(c1) == 1 ? "WL" : c2 != 0 ? "R" : "SS"
        int dir = c1 != 0 ? (c1 > 0 ? 1 : -1) : c2 != 0 ? (c2 > 0 ? 1 : -1) : 0
        chain := "S0 " + S + (dir > 0 ? " up" : dir < 0 ? " down" : "")
        // a BS / WL that completed before the anchor has already reached its target: the week opens on what follows it
        float conf = 1.0
        if S == "BS"
            int iT = dir > 0 ? iC : iF
            float zf = iT >= 0 and iT < m ? f_zc(Z, iT).zfp : 50.0
            S := zf < 20 ? "RWL" : "R"                                       // ZFP-conditioned (SP:1825-1826)
            conf *= f_tier("H")
        else if S == "WL"
            S := "RWL"                                                       // dir stays the direction of the rejected spike
            conf *= f_tier("MH")
        // STEPS 2-3 — extend shape by shape, one trading day per step (SS that opens the chain holds two days: "liquidity accumulates Monday-Tuesday", FA:9)
        int day = 0
        int piercing = 0
        float px = spot
        bool first = true
        while day < 5 and (conf >= 0.25 or S == "SS")          // a terminal SS runs to the end of the week (SPEC:539-541)
            float fTop = iF >= 0 ? f_zc(Z, iF).top : px - (iC < m ? f_zc(Z, iC).bot - px : T_CLUSTER)
            float cBot = iC < m ? f_zc(Z, iC).bot : px + (iF >= 0 ? px - f_zc(Z, iF).top : T_CLUSTER)
            float zfF = iF >= 0 ? f_zc(Z, iF).zfp : 50.0
            float zfC = iC < m ? f_zc(Z, iC).zfp : 50.0
            string keyF = iF >= 0 ? f_zc(Z, iF).name : "open space"
            string keyC = iC < m ? f_zc(Z, iC).name : "open space"
            int span = 1
            string nxt = "SS"
            float lo = fTop
            float hi = cBot
            float pEnd = px
            int dd = 0
            string key = keyF + " / " + keyC
            if S == "SS" or S == "R"
                span := S == "SS" and first ? 2 : 1
                pEnd := (fTop + cBot) / 2
                // SS: a bounding zone with ZFP > 45 fails next (SP:1829); both < 30 hold (SP:1830); R that persists becomes SS (SP:1832)
                if S == "R"
                    nxt := "SS"
                    conf *= f_tier("MH")
                else if math.max(zfF, zfC) > 45 and piercing < 2
                    nxt := "BS"
                    dir := zfC >= zfF ? 1 : -1
                    conf *= f_tier("H")
                else
                    nxt := "SS"
                    conf *= f_tier(zfF < 30 and zfC < 30 ? "H" : "MH")
            else if S == "BS" or S == "PBS"
                dd := dir
                piercing += 1
                // the failing bound is crossed; the target is the next zone beyond it
                int iT = dir > 0 ? iC + 1 : iF - 1
                bool has = iT >= 0 and iT < m
                float tgt = has ? (dir > 0 ? f_zc(Z, iT).bot : f_zc(Z, iT).top) : (dir > 0 ? cBot + (cBot - fTop) : fTop - (cBot - fTop))   // measured move (V452:1007-1010)
                float zfT = has ? f_zc(Z, iT).zfp : 50.0
                key := (dir > 0 ? keyC : keyF) + " -> " + (has ? f_zc(Z, iT).name : "measured move")
                lo := dir > 0 ? fTop : tgt
                hi := dir > 0 ? tgt : cBot
                pEnd := tgt
                if dir > 0
                    iF := iC
                    iC := iC + 1
                else
                    iC := iF
                    iF := iF - 1
                // the TARGET zone's ZFP decides what follows (SP:1825-1828)
                if zfT < 20
                    nxt := "RWL"
                    conf *= f_tier("H")
                else if zfT <= 40
                    nxt := "R"
                    conf *= f_tier("H")
                else if zfT > 60
                    nxt := "PBS"
                    conf *= f_tier("M")
                else
                    nxt := "R"
                    conf *= f_tier("M")
            else
                // WL / RWL: rejected at the wall, back to the origin zone (SP:1939-1940)
                dd := -dir
                piercing += 1
                pEnd := dir > 0 ? fTop : cBot
                key := (dir > 0 ? keyC : keyF) + " rejects"
                dir := -dir
                nxt := "SS"
                conf *= f_tier("H")
            for k = 1 to span
                if day < 5
                    D.push(DayFc.new(weekOpen + day * 86400000, weekOpen + (day + 1) * 86400000, S, dd, lo, hi, px, pEnd, conf, key))
                    day += 1
            chain += " > " + S + (dd > 0 ? " up" : dd < 0 ? " down" : "")
            px := pEnd
            first := false
            // conservation of energy: after 2 piercing moves, consolidation (SP:486)
            S := piercing >= 2 and (nxt == "BS" or nxt == "PBS") ? "SS" : nxt
    [D, chain]

// ═════════════════════════════════════════════════════════════════════════════════════════════
// ENGINE 3 - trade setups (corrected E3 doc only, R-16). Implemented subset: zone-rejection setups on the frozen E1 map.
//   which zones : every zone that is expected to hold - ZFP < 30 (FB:101-112) - and has a side (the Equilibrium Zone has none)
//   entry       : resting limit at the zone's key level (C:178-181)
//   stop-loss   : 3 pips outside the back edge of the entry zone (C:249-255), or behind the zone's reaction extreme of the
//                 prior 3 weeks + the per-pair buffer when that is further (C:291-304, C:379); never beyond 36 pips (C:309)
//   take-profit : ONE, 1 pip in front of the near edge of an opposing zone; the walk moves to the next zone, at most
//                 3 attempts, until RRR >= 3 (C:313-321, C:356-383); above 15R the setup is dropped (C:362-365)
//   count       : nearest to the anchor price first, never more than 11 per week (operator brief)
// ═════════════════════════════════════════════════════════════════════════════════════════════
f_e3(Zone[] Z, float spot) =>
    Setup[] out = array.new<Setup>()
    int m = Z.size()
    if m > 1
        float[] ds = array.new_float()
        for z in Z
            ds.push(math.abs(z.p - spot))
        int[] o = ds.sort_indices(order.ascending)
        float[] tp = array.new_float()
        for z in Z
            tp.push(z.top)
        int[] up = tp.sort_indices(order.ascending)
        for k = 0 to m - 1
            Zone z = Z.get(o.get(k))
            if z.side != 0 and z.zfp < 30 and out.size() < 11
                int dir = z.side > 0 ? -1 : 1
                float e = math.min(z.top, math.max(z.bot, z.p))
                float sl = dir < 0 ? z.top + T_EXACT : z.bot - T_EXACT
                if dir < 0 and not na(z.xHi)
                    sl := math.max(sl, z.xHi + SL_BUF)
                if dir > 0 and not na(z.xLo)
                    sl := math.min(sl, z.xLo - SL_BUF)
                float risk = math.abs(e - sl)
                bool slOk = risk <= 36 * PIP
                int tries = 0
                bool done = false
                // opposing zones in order away from the entry
                for j = 0 to m - 1
                    Zone t = Z.get(up.get(dir < 0 ? m - 1 - j : j))
                    bool beyond = dir < 0 ? t.top < z.bot : t.bot > z.top
                    if beyond and not done and tries < 3 and slOk
                        tries += 1
                        float target = dir < 0 ? t.top + PIP : t.bot - PIP
                        float r = math.abs(e - target) / risk
                        if r >= 3 and r <= 15
                            out.push(Setup.new(dir, e, sl, target, r, z.name, 0, 0, 0, na))
                            done := true
    out

f_assertAnchor(int asof, int anchor) =>
    if asof > anchor
        runtime.error("ANCHOR VIOLATION: forecast read a bar that closed after the Monday anchor")

// 2) freeze the week's forecast on the first bar that closes after the anchor, from state that excludes this bar
if not frozen and not na(anchorTs) and time_close > anchorTs
    frozen := true
    int asof = na(tClose1) ? time : tClose1
    f_assertAnchor(asof, anchorTs)
    float spot = na(close1) ? open : close1
    SD[] S = array.new<SD>()
    f_sd(S, T_H4MOVE, 240)
    f_sd(S, T_H1MOVE, 60)
    int weekKey = year(anchorTs, TZ) * 10000 + month(anchorTs, TZ) * 100 + dayofmonth(anchorTs, TZ)
    Lv[] L = f_e1(spot, S, weekKey)
    Zone[] Z = f_pick(f_zones(L, S, spot), spot)
    float mB = na(barRng1) ? high - low : barRng1
    int wkEnd = anchorTs + (4 * 24 + 17 - i_anchorHour) * 3600000      // Friday 17:00 New York
    int weekOpen = anchorTs - (i_anchorHour + 7) * 3600000          // Sunday 17:00 New York
    [DY, chainTxt] = f_e2(Z, spot, weekOpen)
    fcs.push(WeekFc.new(anchorTs, asof, anchorTs, wkEnd, spot, Z, L, S, DY, chainTxt, f_e3(Z, spot), mB))
    if fcs.size() > i_weeks + i_back
        fcs.shift()

// 3) fold this chart bar into the bars being built
if na(chO)
    chO := open
    chH := high
    chL := low
    chD := dKey
    chT := time
else
    chH := math.max(chH, high)
    chL := math.min(chL, low)
chC := close
if na(cdO)
    cdO := open
    cdH := high
    cdL := low
else
    cdH := math.max(cdH, high)
    cdL := math.min(cdL, low)
cdC := close
if na(cwH)
    cwH := high
    cwL := low
else
    cwH := math.max(cwH, high)
    cwL := math.min(cwL, low)
cwC := close

// ═════════════════════════════════════════════════════════════════════════════════════════════
// RENDER (reads frozen forecasts only)
// ═════════════════════════════════════════════════════════════════════════════════════════════
color C_RES = color.rgb(200, 60, 35)
color C_EQ  = color.rgb(255, 152, 0)
color C_SUP = color.rgb(0, 150, 150)
// 3) E3 bookkeeping: the frozen setups of the current week meet the bars that follow the anchor (display of outcomes only -
//    nothing here feeds a forecast). A stop on the fill bar counts; a target on the fill bar does not (bar order unknown).
if fcs.size() > 0
    WeekFc cw = fcs.last()
    if time >= cw.anchor and time < cw.t1
        // E1 bookkeeping: the first test of each zone of the current week (operator L-23): REJECTED = price left on the side
        // it came from; CONSOLIDATED = it worked in / around the zone at least twice as long as a straight pass takes;
        // SLICED = it went straight through. It only feeds the measured failure probability of LATER weeks.
        for z in cw.zones
            if z.res == 0 and cw.m > 0
                if z.pos == 0
                    z.pos := close > z.top + cw.m ? 1 : close < z.bot - cw.m ? -1 : 0
                else
                    if not z.vin and low <= z.top and high >= z.bot
                        z.vin := true
                        z.org := z.pos
                        z.cnt := 0
                    if z.vin
                        z.cnt += 1
                        int e = close > z.top + cw.m ? 1 : close < z.bot - cw.m ? -1 : 0
                        if e != 0
                            int need = 2 * int(math.ceil((z.top - z.bot + 2 * cw.m) / cw.m))
                            z.res := e == z.org ? 1 : z.cnt <= need ? 2 : 3
                            zTouch.set(z.cls, zTouch.get(z.cls) + 1)
                            zBreak.set(z.cls, zBreak.get(z.cls) + (z.res == 2 ? 1 : 0))
        for u in cw.setups
            bool justIn = false
            if u.st == 0
                if (u.dir < 0 and high >= u.e) or (u.dir > 0 and low <= u.e)
                    u.st := 1
                    u.tIn := time
                    justIn := true
            if u.st == 1
                if (u.dir < 0 and high >= u.sl) or (u.dir > 0 and low <= u.sl)
                    u.st := 3
                    u.tOut := time
                    u.pOut := u.sl
                else if not justIn and ((u.dir < 0 and low <= u.tp) or (u.dir > 0 and high >= u.tp))
                    u.st := 2
                    u.tOut := time
                    u.pOut := u.tp
                else if time_close >= cw.t1
                    u.st := 4
                    u.tOut := time
                    u.pOut := close

var box[]   bx = array.new_box()
var label[] lb = array.new_label()
var line[]  ln = array.new_line()

if barstate.islast
    for l in ln
        line.delete(l)
    ln.clear()
    for b in bx
        box.delete(b)
    bx.clear()
    for l in lb
        label.delete(l)
    lb.clear()
    int nDraw = math.min(i_weeks, fcs.size())
    for fi = 0 to math.max(0, nDraw - 1)
        WeekFc f = nDraw > 0 ? fcs.get(fi) : WeekFc.new(0, 0, 0, 0, 0.0, array.new<Zone>(), array.new<Lv>(), array.new<SD>(), array.new<DayFc>(), "", array.new<Setup>())
        if i_showE1
            for z in f.zones
                color c = z.side > 0 ? C_RES : z.side < 0 ? C_SUP : C_EQ
                bx.push(box.new(f.t0, z.top, f.t1, z.bot, xloc = xloc.bar_time, bgcolor = color.new(c, 72), border_color = c, border_width = 1))
                lb.push(label.new(f.t0, (z.top + z.bot) / 2, z.name + " | " + z.degree + " | " + str.tostring(z.zfp) + "% ZFP", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(color.white, 10), size = size.small))
        if i_showE2
            float lastTo = na
            for d in f.days
                color c = d.shape == "SS" ? color.rgb(150, 150, 160) : d.shape == "R" ? color.rgb(160, 120, 220) : d.dir > 0 ? color.rgb(60, 200, 120) : color.rgb(240, 90, 90)
                bx.push(box.new(d.t0, d.hi, d.t1, d.lo, xloc = xloc.bar_time, bgcolor = color.new(c, 94), border_color = color.new(c, 30), border_width = 1, border_style = line.style_dashed))
                lb.push(label.new(d.t0, d.hi, str.format_time(d.t0 + 43200000, "EEE", TZ) + ": " + d.shape + (d.dir > 0 ? " up" : d.dir < 0 ? " down" : " range") + " " + str.tostring(math.round(d.conf * 100)) + "%", xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(c, 100), textcolor = c, size = size.small))
                ln.push(line.new(d.t0, d.p0, d.t1, d.p1, xloc = xloc.bar_time, color = color.new(color.yellow, 20), width = 2))
        if i_showE3
            int nIn = 0
            int nTp = 0
            int nSl = 0
            float sumR = 0.0
            for u in f.setups
                color cg = color.rgb(40, 190, 120)
                color cr = color.rgb(235, 70, 80)
                if u.st == 0
                    ln.push(line.new(f.t0, u.e, f.t1, u.e, xloc = xloc.bar_time, color = color.new(u.dir > 0 ? cg : cr, 45), width = 1, style = line.style_dotted))
                else
                    nIn += 1
                    int tEnd = u.st == 1 ? f.t1 : u.tOut
                    float rr = u.st == 2 ? u.rrr : u.st == 3 ? -1.0 : na(u.pOut) ? 0.0 : (u.pOut - u.e) * u.dir / math.abs(u.e - u.sl)
                    nTp += u.st == 2 ? 1 : 0
                    nSl += u.st == 3 ? 1 : 0
                    sumR += rr
                    bx.push(box.new(u.tIn, u.e, tEnd, u.tp, xloc = xloc.bar_time, bgcolor = color.new(cg, 78), border_color = color.new(cg, 20), border_width = 1))
                    bx.push(box.new(u.tIn, u.e, tEnd, u.sl, xloc = xloc.bar_time, bgcolor = color.new(cr, 78), border_color = color.new(cr, 20), border_width = 1))
                    string res = u.st == 2 ? "TP +" + str.tostring(u.rrr, "#.0") + "R" : u.st == 3 ? "SL -1R" : u.st == 4 ? "Fri close " + str.tostring(rr, "#.0") + "R" : "open"
                    lb.push(label.new(u.tIn, u.dir > 0 ? u.sl : u.sl, (u.dir > 0 ? "LONG " : "SHORT ") + str.tostring(u.e, format.mintick) + " | " + res, xloc = xloc.bar_time, style = u.dir > 0 ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(color.black, 100), textcolor = u.st == 3 ? cr : cg, size = size.small))
            if f.setups.size() > 0
                lb.push(label.new(f.t1, f.spot, "E3 " + str.tostring(f.setups.size()) + " setups | " + str.tostring(nIn) + " filled | " + str.tostring(nTp) + " TP | " + str.tostring(nSl) + " SL | " + str.tostring(sumR, "#.0") + "R", xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.black, 40), textcolor = color.white, size = size.small))
        if i_showSD
            for s in f.sds
                color c = s.side > 0 ? color.rgb(242, 54, 69) : color.rgb(49, 121, 245)
                bx.push(box.new(s.t, s.top, f.t1, s.bot, xloc = xloc.bar_time, bgcolor = color.new(c, 85), border_color = color.new(c, 40), border_width = 1, text = (s.scale == 240 ? "4H " : "1H ") + (s.mit == 0 ? "(Unmitigated)" : str.tostring(s.mit) + "X") + " | BoM", text_color = color.new(c, 20), text_size = size.small))
        if i_showAudit
            string t = "E2 " + f.chain + "\nasof " + str.format_time(f.asof, "yyyy-MM-dd HH:mm", TZ) + " NY | anchor " + str.format_time(f.anchor, "yyyy-MM-dd HH:mm", TZ) + " | spot " + str.tostring(f.spot) + " | levels " + str.tostring(f.levels.size())
            for z in f.zones
                t += "\nZ " + str.tostring(math.round(z.bot / PIP) * PIP) + "-" + str.tostring(math.round(z.top / PIP) * PIP) + " " + z.name + " " + z.degree + " " + str.tostring(z.score) + " cf" + str.tostring(z.conf) + " p" + str.tostring(z.pillars) + " T" + str.tostring(z.tier) + " zfp" + str.tostring(z.zfp) + " " + str.tostring(z.rx) + "R" + str.tostring(z.xs) + "X [" + z.drivers + "] sliced " + str.tostring(z.nBreak) + "/" + str.tostring(z.nTouch) + " first=" + str.tostring(z.res)
            for s in f.sds
                t += "\nSD " + (s.side > 0 ? "supply " : "demand ") + str.tostring(s.bot) + "-" + str.tostring(s.top) + " mit" + str.tostring(s.mit) + " " + str.tostring(s.scale) + " " + str.format_time(s.t, "MM-dd HH:mm", TZ)
            for v in f.levels
                t += "\nL " + str.tostring(v.p) + "|" + str.tostring(v.src) + "|" + v.tag + "|" + str.tostring(v.w) + "|" + str.tostring(v.st) + "|" + str.tostring(v.bonus) + "|" + str.tostring(v.lo) + "|" + str.tostring(v.hi) + "|" + str.tostring(v.conf) + "|" + str.tostring(v.tech) + "|" + str.tostring(v.stru) + "|" + str.tostring(v.psy) + "|" + str.tostring(v.opt) + "|" + str.tostring(v.ana) + "|" + str.tostring(v.xb) + "|" + str.tostring(v.code) + "|" + str.tostring(v.optc)
            lb.push(label.new(f.t0, f.spot, t, xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.black, 30), textcolor = color.white, size = size.small, textalign = text.align_left))

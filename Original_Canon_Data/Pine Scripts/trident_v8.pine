            string c = array.get(au_zCat, i)
            string tag = c == "RES" ? "RES" : c == "MID" ? "EQ" : "SUP"
            color bg = c == "RES" ? color.rgb(60,12,8) : c == "MID" ? color.rgb(50,38,8) : color.rgb(0,40,40)
            string pr = str.tostring(array.get(au_zTp,i), pFmt) + "-" + str.tostring(array.get(au_zBt,i), pFmt)
            string prs = pressureLbl(array.get(au_zDeg, i))
            int zfp = calcZFP(array.get(au_zTp, i), array.get(au_zBt, i), "AUD/USD")
            table.cell(tbl_au, 0, i+5, tag, text_color=color.white, text_size=size.small, bgcolor=bg)
            table.cell(tbl_au, 1, i+5, pr + " " + prs + " " + str.tostring(zfp) + "%ZFP " + array.get(au_zTir,i), text_color=color.white, text_size=size.small, bgcolor=bg)
        table.cell(tbl_au, 0, 10, "TRADES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl_au, 1, 10, "", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        color sBg = color.rgb(60,12,8)
        table.cell(tbl_au, 0, 11, "S " + array.get(au_tTir,0), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 1, 11, "Entry: " + str.tostring(array.get(au_tEn1,0), pFmt) + " - " + str.tostring(array.get(au_tEn3,0), pFmt), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 0, 12, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 1, 12, "SL: " + str.tostring(array.get(au_tSl,0), pFmt) + "  |  TP: " + str.tostring(array.get(au_tTp,0), pFmt), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 0, 13, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl_au, 1, 13, array.get(au_tDE,0) + " > " + array.get(au_tDT,0) + "  |  R:R " + str.tostring(array.get(au_tRr,0), "#.#"), text_color=color.white, text_size=size.small, bgcolor=sBg)
        color lBg = color.rgb(0,40,40)
        table.cell(tbl_au, 0, 14, "L " + array.get(au_tTir,1), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 1, 14, "Entry: " + str.tostring(array.get(au_tEn1,1), pFmt) + " - " + str.tostring(array.get(au_tEn3,1), pFmt), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 0, 15, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 1, 15, "SL: " + str.tostring(array.get(au_tSl,1), pFmt) + "  |  TP: " + str.tostring(array.get(au_tTp,1), pFmt), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 0, 16, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl_au, 1, 16, array.get(au_tDE,1) + " > " + array.get(au_tDT,1) + "  |  R:R " + str.tostring(array.get(au_tRr,1), "#.#"), text_color=color.white, text_size=size.small, bgcolor=lBg)

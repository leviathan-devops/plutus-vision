    if show_e3
        // DX1 Mon SS SHORT E 99.107 SL 99.231 TP 98.793 RRR 2.53 | Swing Scalp / London Open | entry sweep zone in front of the pressure zone, near edge (TS-1); SL (b) 1 pip inside the close edge of the shield (4H band) [P533:506 reversal entry: inside the next zone]; TP E2 bounding supply / demand zone near edge + 1 pip (strong) (E3C:333, rule 5)
        e3a0 = not na(e3E0) ? e3E0 - e3bw : 1776060000000
        e3b0 = not na(e3E0) ? (na(e3X0) ? time : e3X0) + e3bw : 1776060000000 + 3 * e3bw
        box.new(e3a0, 99.231, e3b0, 99.107, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E0) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        box.new(e3a0, 99.107, e3b0, 99.087, bgcolor=color.new(color.rgb(8,153,129), 70), border_color=color.new(color.rgb(8,153,129), 40), border_width=1, border_style=line.style_dotted, xloc=xloc.bar_time)
        box.new(e3a0, 99.107, e3b0, 98.793, bgcolor=color.new(color.rgb(8,153,129), 88), border_color=color.rgb(8,153,129), border_width=1, border_style=na(e3E0) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        // DX2 Mon SS LONG E 98.685 SL 98.515 TP 99.177 RRR 2.89 | Swing Scalp / London Open | entry internal LQZ rung; SL (b) 1 pip inside the close edge of the shield (1H rung beyond the first) [P533:506 reversal entry: inside the next zone]; TP E2 bounding zone near edge + 1 pip (strong zone, E3C:320-327)
        e3a1 = not na(e3E1) ? e3E1 - e3bw : 1776060000000
        e3b1 = not na(e3E1) ? (na(e3X1) ? time : e3X1) + e3bw : 1776060000000 + 3 * e3bw
        box.new(e3a1, 98.685, e3b1, 98.515, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E1) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        box.new(e3a1, 98.705, e3b1, 98.685, bgcolor=color.new(color.rgb(8,153,129), 70), border_color=color.new(color.rgb(8,153,129), 40), border_width=1, border_style=line.style_dotted, xloc=xloc.bar_time)
        box.new(e3a1, 99.177, e3b1, 98.685, bgcolor=color.new(color.rgb(8,153,129), 88), border_color=color.rgb(8,153,129), border_width=1, border_style=na(e3E1) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        e3y0 = 99.063
        e3y1 = 98.813
        if e3a1 < e3a0 + 21 * e3bw and e3a0 < e3a1 + 21 * e3bw and math.abs(e3y1 - e3y0) < 0.025
            e3y1 := e3y1 + 0.028
        if e3a1 < e3a0 + 21 * e3bw and e3a0 < e3a1 + 21 * e3bw and math.abs(e3y1 - e3y0) < 0.025
            e3y1 := e3y1 + 0.028
        label.new(e3a0 + e3bw, e3y0, "DX1 SS S 2.5R", xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.small)
        label.new(e3a1 + e3bw, e3y1, "DX2 SS L 2.9R", xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.small)

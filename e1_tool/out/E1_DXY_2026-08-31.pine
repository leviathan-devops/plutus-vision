    if show_e3
        // DX1 Tue RWL SHORT E 99.943 SL 100.006 TP 99.636 RRR 4.9 | Reversal / NY Open | entry 1H order block bottom + 1 pip (F1-A); SL (b) 1 pip inside the close edge of the shield (1H rung beyond the first) [P533:506 reversal entry: inside the next zone]; TP first LQZ rung 30+ pips along the reversal: midpoint (GS Law 2; rule 4)
        e3a0 = not na(e3E0) ? e3E0 - e3bw : 1788210000000
        e3b0 = not na(e3E0) ? (na(e3X0) ? time : e3X0) + e3bw : 1788210000000 + 3 * e3bw
        box.new(e3a0, 100.006, e3b0, 99.943, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E0) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        box.new(e3a0, 99.943, e3b0, 99.913, bgcolor=color.new(color.rgb(8,153,129), 70), border_color=color.new(color.rgb(8,153,129), 40), border_width=1, border_style=line.style_dotted, xloc=xloc.bar_time)
        box.new(e3a0, 99.943, e3b0, 99.636, bgcolor=color.new(color.rgb(8,153,129), 88), border_color=color.rgb(8,153,129), border_width=1, border_style=na(e3E0) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        // DX2 Tue SS SHORT E 99.696 SL 99.753 TP 99.239 RRR 8.04 | Swing Scalp / London Open | entry 30m order block bottom + 1 pip (F1-A); SL (b) 1 pip inside the close edge of the shield (4H band) [P533:506 reversal entry: inside the next zone]; TP LQZ inside the opposing zone: midpoint
        e3a1 = not na(e3E1) ? e3E1 - e3bw : 1788210000000
        e3b1 = not na(e3E1) ? (na(e3X1) ? time : e3X1) + e3bw : 1788210000000 + 3 * e3bw
        box.new(e3a1, 99.753, e3b1, 99.696, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E1) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        box.new(e3a1, 99.696, e3b1, 99.666, bgcolor=color.new(color.rgb(8,153,129), 70), border_color=color.new(color.rgb(8,153,129), 40), border_width=1, border_style=line.style_dotted, xloc=xloc.bar_time)
        box.new(e3a1, 99.696, e3b1, 99.239, bgcolor=color.new(color.rgb(8,153,129), 88), border_color=color.rgb(8,153,129), border_width=1, border_style=na(e3E1) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        // DX3 Tue SS LONG E 99.025 SL 98.891 TP 99.665 RRR 4.78 | Swing Scalp / London Open | entry internal LQZ rung; SL (b) 1 pip inside the close edge of the shield (4H band) [P533:506 reversal entry: inside the next zone]; TP LQZ inside the opposing zone: midpoint
        e3a2 = not na(e3E2) ? e3E2 - e3bw : 1788210000000
        e3b2 = not na(e3E2) ? (na(e3X2) ? time : e3X2) + e3bw : 1788210000000 + 3 * e3bw
        box.new(e3a2, 99.025, e3b2, 98.891, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E2) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        box.new(e3a2, 99.045, e3b2, 99.025, bgcolor=color.new(color.rgb(8,153,129), 70), border_color=color.new(color.rgb(8,153,129), 40), border_width=1, border_style=line.style_dotted, xloc=xloc.bar_time)
        box.new(e3a2, 99.665, e3b2, 99.025, bgcolor=color.new(color.rgb(8,153,129), 88), border_color=color.rgb(8,153,129), border_width=1, border_style=na(e3E2) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        e3y0 = 99.900
        e3y1 = 99.577
        e3y2 = 99.268
        if e3a1 < e3a0 + 23 * e3bw and e3a0 < e3a1 + 21 * e3bw and math.abs(e3y1 - e3y0) < 0.039
            e3y1 := e3y1 + -0.043
        if e3a2 < e3a0 + 23 * e3bw and e3a0 < e3a2 + 21 * e3bw and math.abs(e3y2 - e3y0) < 0.039
            e3y2 := e3y2 + 0.043
        if e3a2 < e3a1 + 21 * e3bw and e3a1 < e3a2 + 21 * e3bw and math.abs(e3y2 - e3y1) < 0.039
            e3y2 := e3y2 + 0.043
        if e3a1 < e3a0 + 23 * e3bw and e3a0 < e3a1 + 21 * e3bw and math.abs(e3y1 - e3y0) < 0.039
            e3y1 := e3y1 + -0.043
        if e3a2 < e3a0 + 23 * e3bw and e3a0 < e3a2 + 21 * e3bw and math.abs(e3y2 - e3y0) < 0.039
            e3y2 := e3y2 + 0.043
        if e3a2 < e3a1 + 21 * e3bw and e3a1 < e3a2 + 21 * e3bw and math.abs(e3y2 - e3y1) < 0.039
            e3y2 := e3y2 + 0.043

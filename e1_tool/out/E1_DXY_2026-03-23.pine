    if high >= 100.214
        e3X1 := time
        e3R1 := -1
    else if low <= 99.577
        e3X1 := time
        e3R1 := 1
var bool e3V2 = false
if isPair and na(e3E2) and not e3V2 and time >= 1774245600000 and time < 1774558800000 and high >= 100.067
    if (not na(e3E0) and na(e3X0)) or (not na(e3E1) and na(e3X1))
        e3V2 := true
    else
        e3E2 := time
if isPair and not na(e3E2) and na(e3X2)
    if high >= 100.245
        e3X2 := time
        e3R2 := -1
    else if low <= 99.525
        e3X2 := time
        e3R2 := 1

#!/usr/bin/env bash
# pbfit - fit the IDE chart's price axis so every drawing and visible bar is in frame (recipe from memory/11 §6); 16% headroom on top so the day-tag row stands clear of the chart header
"$(dirname "$0")/pb" eval "(function(){const P=window.PlutusPineShell; const r=P.chart.rendererControl.renderer; const d=P.chart.drawings.toJSON().drawings; let lo=Infinity,hi=-Infinity; const vr=P.chart.getVisibleRange(); for(const b of r.bars){ if(b.time>=vr.from&&b.time<=vr.to){ lo=Math.min(lo,b.low); hi=Math.max(hi,b.high);} } const span=hi-lo, L0=lo-span*0.6, H0=hi+span*0.6; for(const x of d){ if(x.type==='box'||x.type==='line'){ for(const a of x.anchors){ if(typeof a.price==='number' && a.price>=L0 && a.price<=H0){ lo=Math.min(lo,a.price); hi=Math.max(hi,a.price);} } } } const pad=(hi-lo)*0.04; const res=r.resolveScaleHolder(r.coords.widthPx-20,200)||r.resolveScaleHolder(400,200); r.setManualScale(res.holder,{min:lo-pad,max:hi+pad*4,invert:false}); return {lo,hi};})()"

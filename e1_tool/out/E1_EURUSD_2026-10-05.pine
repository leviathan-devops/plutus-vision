        // EU2 Mon SS LONG E 1.11710 SL 1.11480 TP 1.12476 RRR 3.33 | Swing Scalp / London Open | entry sweep zone near edge (TS-1); SL (a) 3 pips outside the extended sweep range (P533 7.1 Rule 2.5; E3C:1027) [ZR-6B safety, mirror confidence 1.00]; TP E2 bounding supply / demand zone near edge (E3C:333, rule 5)
        e3a1 = not na(e3E1) ? e3E1 - e3bw : 1791180000000
        e3b1 = not na(e3E1) ? (na(e3X1) ? time : e3X1) + e3bw : 1791180000000 + 3 * e3bw
        box.new(e3a1, 1.11710, e3b1, 1.11480, bgcolor=color.new(color.rgb(242,54,69), 84), border_color=color.rgb(242,54,69), border_width=1, border_style=na(e3E1) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        box.new(e3a1, 1.11720, e3b1, 1.11710, bgcolor=color.new(color.rgb(8,153,129), 70), border_color=color.new(color.rgb(8,153,129), 40), border_width=1, border_style=line.style_dotted, xloc=xloc.bar_time)
        box.new(e3a1, 1.12476, e3b1, 1.11710, bgcolor=color.new(color.rgb(8,153,129), 88), border_color=color.rgb(8,153,129), border_width=1, border_style=na(e3E1) or false ? line.style_dashed : line.style_solid, xloc=xloc.bar_time)
        e3y0 = 1.12465
        e3y1 = 1.11909
        if e3a1 < e3a0 + 21 * e3bw and e3a0 < e3a1 + 21 * e3bw and math.abs(e3y1 - e3y0) < 0.00044
            e3y1 := e3y1 + 0.00049
        if e3a1 < e3a0 + 21 * e3bw and e3a0 < e3a1 + 21 * e3bw and math.abs(e3y1 - e3y0) < 0.00044
            e3y1 := e3y1 + 0.00049
        label.new(e3a0 + e3bw, e3y0, "EU1 SS S 5.5R", xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.small)
        label.new(e3a1 + e3bw, e3y1, "EU2 SS L 3.3R", xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.small)

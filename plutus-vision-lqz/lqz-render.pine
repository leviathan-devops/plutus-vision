// ═════════════════════════════════════════════════════════════════════════════
// LQZ RENDER — the full-width horizontal zone emitter.
// CONSUMES (read-only; never mutates) the arrays W1 emits:
//   lqzZLevel[] lqzZTop[] lqzZBottom[] lqzZSide[] lqzZMask[] lqzZConf[]
//
// THE MEASURED TARGET (scripts/measure_ladder.py, WINNING_TRADE_LIBARARY):
//   coverage 99-100 % of the plot row   -> the band MUST span the whole chart
//   GREEN/teal #3E8A46  33 bands        -> SELL_SIDE, liquidity BELOW price
//   RED           #7F3613   7 bands    -> BUY_SIDE,  liquidity ABOVE price
//   line thickness 1px, 2px where doubled
//
// The LuxAlgo three each drew their OWN primitive (box / dotted line / 13-slice
// stack), so three different render styles collided at one level. This emitter is
// the ONLY place a liquidity level becomes a pixel — that is the defect removed.

lqzColorB = input.color(#3E8A46, "Demand zone (below price)", group = "LQZ render")
lqzColorS = input.color(#7F3613, "Supply zone (above price)", group = "LQZ render")
lqzBandA  = input.int(20, "Band fill alpha", minval = 0, maxval = 100, group = "LQZ render")
lqzLeftB  = input.int(500, "Left margin (bars)", minval = 1, maxval = 500, group = "LQZ render")
lqzRightB = input.int(20,  "Right margin (bars)", minval = 1, maxval = 300, group = "LQZ render")
lqzThickE = input.float(0.35, "Thinnest band (x ATR)", minval = 0.0, maxval = 2.0, step = 0.1, group = "LQZ render")
lqzLabel  = input.bool(true, "Label the band", group = "LQZ render")

// BAND FLOOR. A band thinner than the renderer's own resolution collapses to
// nothing on screen and reads as "missing liquidity". Floor it on ATR, NOT on
// syminfo.mintick: this engine reports mintick = 1e-16, which made every
// degenerate band invisible (measured: band height min 0.00000 over 50 boxes).
// mintick stays only as a secondary guard when ATR is unavailable.
lqzMinTick = math.max(syminfo.mintick, 0.0)
lqzThick   = math.max(lqzThickE * nz(ta.atr(14), 0.0), nz(lqzMinTick, 0.0))

f_lqzRender() =>
    _n = array.size(lqzZLevel)
    if _n > 0
        for i = 0 to _n - 1
            _sd  = array.get(lqzZSide, i)
            _lo  = array.get(lqzZBottom, i)
            _hi  = array.get(lqzZTop, i)
            _cf  = array.get(lqzZConf, i)
            _h   = math.max(_hi - _lo, lqzThick)
            _mid = (_hi + _lo) / 2
            _bot = _mid - _h / 2
            _top = _mid + _h / 2
            _col = _sd == 1 ? lqzColorS : lqzColorB
            // 3+ agreeing sources read brighter — the operator's denser bands
            _al = _cf >= 3 ? math.min(100, lqzBandA + 22) : lqzBandA
            // LEFT EDGE MUST NEVER GO NEGATIVE. A fixed -500 bar margin is negative on any
            // history shorter than 500 bars, and the engine DROPS such a box SILENTLY
            // (measured: 15m fixture = 325 bars -> bar_index-500 = -176 -> boxes=0, no error).
            // Clamp to the first available bar; short histories then span all they have.
            _lx = math.max(0, bar_index - lqzLeftB)
            box.new(_lx, _top, bar_index + lqzRightB, _bot,
                 border_color = na,
                 bgcolor = color.new(_col, _al),
                 text = lqzLabel ? ("LQ " + str.tostring(_cf)) : "",
                 text_size = size.tiny,
                 text_color = color.new(_col, 0),
                 text_halign = text.align_left,
                 text_valign = _sd == 1 ? text.align_top : text.align_bottom)
        0

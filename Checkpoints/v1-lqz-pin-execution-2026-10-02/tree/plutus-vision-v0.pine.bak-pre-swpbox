// User Defined Types
//-----------------------------------------------------------------------------{

// @type        voi_bar properties with their values 
//
// @field h     (float) high price of the voi_bar
// @field l     (float) low price of the voi_bar
// @field c     (float) close price of the voi_bar
// @field i     (int) index of the voi_bar

type voi_bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

//-----------------------------------------------------------------------------}
// Variables
//-----------------------------------------------------------------------------{

voi_bar voi_b = voi_bar.new()
var voi_lqV = array.new_box()

//-----------------------------------------------------------------------------}
// Calculations
//-----------------------------------------------------------------------------{

voi_per = voi_mode == 'Present' ? last_bar_index - voi_b.i <= back : true
voi_atr = ta.atr(144) * voi_lqTH

if voi_per
    voi_bull = (voi_b.l - voi_b.h[2]) > voi_atr and voi_b.l > voi_b.h[2] and voi_b.c[1] > voi_b.h[2]

    if voi_bull 
        l = 13
        if voi_bull[1] 
            voi_st = math.abs(voi_b.l - voi_b.l[1]) / l
            for i = 0 to l - 1
                array.push(voi_lqV, box.new(voi_b.i - 2, voi_b.l[1] + (i + 1) * voi_st, voi_b.i, voi_b.l[1] + i * voi_st, na, bgcolor = voi_lqBC ))
        else   
            voi_st = math.abs(voi_b.l - voi_b.h[2]) / l
            for i = 0 to l - 1
                if voi_lqTX and i == 0
                    array.push(voi_lqV, box.new(voi_b.i - 2, voi_b.h[2] + (i + 1) * voi_st, voi_b.i, voi_b.h[2] + i * voi_st, na, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom, text_color = na, bgcolor = voi_lqBC ))
                else
                    array.push(voi_lqV, box.new(voi_b.i - 2, voi_b.h[2] + (i + 1) * voi_st, voi_b.i, voi_b.h[2] + i * voi_st, na, bgcolor = voi_lqBC ))

    voi_bear = (voi_b.l[2] - voi_b.h) > voi_atr and voi_b.h < voi_b.l[2] and voi_b.c[1] < voi_b.l[2]

    if voi_bear
        l = 13
        if voi_bear[1]
            voi_st = math.abs(voi_b.h[1] - voi_b.h) / l
            for i = 0 to l - 1
                array.push(voi_lqV, box.new(voi_b.i - 2, voi_b.h + (i + 1) * voi_st, voi_b.i, voi_b.h + i * voi_st, na, bgcolor = voi_lqSC ))
        else
            voi_st = math.abs(voi_b.l[2] - voi_b.h) / l
            for i = 0 to l - 1
                if voi_lqTX and i == l - 1
                    array.push(voi_lqV, box.new(voi_b.i - 2, voi_b.h + (i + 1) * voi_st, voi_b.i, voi_b.h + i * voi_st, na, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top, text_color = na, bgcolor = voi_lqSC ))
                else
                    array.push(voi_lqV, box.new(voi_b.i - 2, voi_b.h + (i + 1) * voi_st, voi_b.i, voi_b.h + i * voi_st, na, bgcolor = voi_lqSC ))

if voi_lqV.size() > 0
    voi_qt = voi_lqV.size()

    for voi_bn = voi_qt - 1 to 0
        if voi_bn < voi_lqV.size()
            voi_cb = voi_lqV.get(voi_bn)
            voi_tBX = voi_cb.get_top()
            voi_bBX = voi_cb.get_bottom()
            if voi_b.h > voi_bBX and voi_b.l < voi_tBX
                if voi_lqVF
                    voi_cb.set_bgcolor(voi_lqFC)
                else
                    voi_cb.delete()
                voi_lqV.remove(voi_bn)
            else
                voi_cb.set_right(voi_b.i + 1)

                if voi_b.i - voi_cb.get_left() > 21
                    voi_cb.set_text_color(chart.fg_color)

    if voi_lqV.size() > 500
        voi_lqV.shift()
        voi_drops += 1
//-----------------------------------------------------------------------------}

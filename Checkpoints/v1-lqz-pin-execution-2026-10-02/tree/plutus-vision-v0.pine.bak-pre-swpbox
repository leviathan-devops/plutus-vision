//Calculations
//-----------------------------------------------------------------------------{
bsl_x2 := bsl_b.i - 1
bsl_ph  = ta.pivothigh(bsl_liqLen, 1)
bsl_pl  = ta.pivotlow (bsl_liqLen, 1)

if bsl_ph   
    bsl_dir := bsl_aZZ.d.get(0) 
    bsl_x1  := bsl_aZZ.bsl_x.get(0) 
    bsl_y1  := bsl_aZZ.y.get(0) 
    bsl_y2  := nz(bsl_b.h[1])

    if bsl_dir < 1
        bsl_aZZ.in_out(1, bsl_x2, bsl_y2)
    else
        if bsl_dir == 1 and bsl_ph > bsl_y1 
            bsl_aZZ.bsl_x.set(0, bsl_x2), bsl_aZZ.y.set(0, bsl_y2)
    
    if bsl_per
        bsl_count = 0
        bsl_st_P  = 0.
        bsl_st_B  = 0
        bsl_minP  = 0.
        bsl_maxP  = 10e6

        for i = 0 to bsl_maxSize - 1
            if bsl_aZZ.d.get(i) ==  1 
                if bsl_aZZ.y.get(i) > bsl_ph + (bsl_atr / bsl_liqMar)
                    break
                else
                    if bsl_aZZ.y.get(i) > bsl_ph - (bsl_atr / bsl_liqMar) and bsl_aZZ.y.get(i) < bsl_ph + (bsl_atr / bsl_liqMar)
                        bsl_count += 1
                        bsl_st_B := bsl_aZZ.bsl_x.get(i)
                        bsl_st_P := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) > bsl_minP
                            bsl_minP := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) < bsl_maxP 
                            bsl_maxP := bsl_aZZ.y.get(i)

        if bsl_count > 2
            bsl_getB = bsl_b_liq_B.get(0)

            if not na(bsl_getB.bx) and bsl_st_B == bsl_getB.bx.get_left()
                bsl_getB.bx.set_top(math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar))
                bsl_getB.bx.set_rightbottom(bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar))
            else
                bsl_b_liq_B.unshift(
                 bsl_liq.new(
                   box.new(bsl_st_B, math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar), bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar), bgcolor=color(na), border_color=color(na)), 
                   box.new(na, na, na, na, bgcolor = color(na), border_color = color(na)),
                   box.new(bsl_st_B, bsl_st_P, bsl_b.i + 10, bsl_st_P, text = 'Buyside liquidity', text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_bottom, text_color = color.new(bsl_cLIQ_B, 25), bgcolor = color(na), border_color = color(na)),
                   false, 
                   false,
                   line.new(bsl_st_B   , bsl_st_P, bsl_b.i - 1, bsl_st_P, color = color.new(bsl_cLIQ_B, 0)),
                   line.new(bsl_b.i - 1, bsl_st_P, na     , bsl_st_P, color = color.new(bsl_cLIQ_B, 0), style = line.style_dotted))
                 )

                alert('buyside liquidity level detected/updated for ' + syminfo.ticker)

            if bsl_b_liq_B.size() > bsl_visLiq
                bsl_getLast = bsl_b_liq_B.pop()
                bsl_drops += 1
                bsl_getLast.bx.delete()
                bsl_getLast.bxz.delete()
                bsl_getLast.bxt.delete()
                bsl_getLast.ln.delete()
                bsl_getLast.lne.delete()               

if bsl_pl
    bsl_dir := bsl_aZZ.d.get (0) 
    bsl_x1  := bsl_aZZ.bsl_x.get (0) 
    bsl_y1  := bsl_aZZ.y.get (0) 
    bsl_y2  := nz(bsl_b.l[1])
    
    if bsl_dir > -1
        bsl_aZZ.in_out(-1, bsl_x2, bsl_y2)
    else
        if bsl_dir == -1 and bsl_pl < bsl_y1 
            bsl_aZZ.bsl_x.set(0, bsl_x2), bsl_aZZ.y.set(0, bsl_y2)
    
    if bsl_per
        bsl_count = 0
        bsl_st_P  = 0.
        bsl_st_B  = 0
        bsl_minP  = 0.
        bsl_maxP  = 10e6

        for i = 0 to bsl_maxSize - 1
            if bsl_aZZ.d.get(i) == -1 
                if bsl_aZZ.y.get(i) < bsl_pl - (bsl_atr / bsl_liqMar)
                    break
                else
                    if bsl_aZZ.y.get(i) > bsl_pl - (bsl_atr / bsl_liqMar) and bsl_aZZ.y.get(i) < bsl_pl + (bsl_atr / bsl_liqMar)
                        bsl_count += 1
                        bsl_st_B := bsl_aZZ.bsl_x.get(i)
                        bsl_st_P := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) > bsl_minP
                            bsl_minP := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) < bsl_maxP 
                            bsl_maxP := bsl_aZZ.y.get(i)

        if bsl_count > 2
            bsl_getB = bsl_b_liq_S.get(0)

            if not na(bsl_getB.bx) and bsl_st_B == bsl_getB.bx.get_left()
                bsl_getB.bx.set_top(math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar))
                bsl_getB.bx.set_rightbottom(bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar))
            else
                bsl_b_liq_S.unshift(
                 bsl_liq.new(
                   box.new(bsl_st_B, math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar), bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar), bgcolor=color(na), border_color=color(na)),
                   box.new(na, na, na, na, bgcolor=color(na), border_color=color(na)),
                   box.new(bsl_st_B, bsl_st_P, bsl_b.i + 10, bsl_st_P, text = 'Sellside liquidity', text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top, text_color = color.new(bsl_cLIQ_S, 25), bgcolor=color(na), border_color=color(na)),
                   false,
                   false,
                   line.new(bsl_st_B   , bsl_st_P, bsl_b.i - 1, bsl_st_P, color = color.new(bsl_cLIQ_S, 0)),
                   line.new(bsl_b.i - 1, bsl_st_P, na     , bsl_st_P, color = color.new(bsl_cLIQ_S, 0), style = line.style_dotted))
                 )  

                alert('sellside liquidity level detected/updated for ' + syminfo.ticker)

            if bsl_b_liq_S.size() > bsl_visLiq
                bsl_getLast = bsl_b_liq_S.pop()
                bsl_drops += 1
                bsl_getLast.bx.delete()
                bsl_getLast.bxz.delete()
                bsl_getLast.bxt.delete()
                bsl_getLast.ln.delete()            
                bsl_getLast.lne.delete()               


for i = 0 to bsl_b_liq_B.size() - 1
    bsl_x = bsl_b_liq_B.get(i)
    
    if not bsl_x.brL
        bsl_x.lne.set_x2(bsl_b.i)

        if bsl_b.h > bsl_x.bx.get_top()
            bsl_x.brL := true
            bsl_x.brZ := true
            alert('buyside liquidity level breached for ' + syminfo.ticker)

            bsl_x.bxz.set_lefttop(bsl_b.i - 1, math.min(bsl_x.ln.get_y1() + bsl_marBuy * (bsl_atr), bsl_b.h))
            bsl_x.bxz.set_rightbottom(bsl_b.i + 1, bsl_x.ln.get_y1())
            bsl_x.bxz.set_bgcolor(color.new(bsl_cLIQ_B, bsl_liqBuy ? 73 : 100))

    else if bsl_x.brZ
        if bsl_b.l > bsl_x.ln.get_y1() - bsl_marBuy * (bsl_atr) and bsl_b.h < bsl_x.ln.get_y1() + bsl_marBuy * (bsl_atr)
            bsl_x.bxz.set_right(bsl_b.i + 1)
            bsl_x.bxz.set_top(math.max(bsl_b.h, bsl_x.bxz.get_top()))
            if bsl_liqBuy
                bsl_x.lne.set_x2(bsl_b.i + 1)
        else
            bsl_x.brZ := false

for i = 0 to bsl_b_liq_S.size() - 1
    bsl_x = bsl_b_liq_S.get(i)

    if not bsl_x.brL
        bsl_x.lne.set_x2(bsl_b.i)

        if bsl_b.l < bsl_x.bx.get_bottom()
            bsl_x.brL := true
            bsl_x.brZ := true
            alert('sellside liquidity level breached for ' + syminfo.ticker)

            bsl_x.bxz.set_lefttop(bsl_b.i - 1, bsl_x.ln.get_y1())
            bsl_x.bxz.set_rightbottom(bsl_b.i + 1, math.max(bsl_x.ln.get_y1() - bsl_marSel * (bsl_atr), bsl_b.l))
            bsl_x.bxz.set_bgcolor(color.new(bsl_cLIQ_S, bsl_liqSel ? 73 : 100))

    else if bsl_x.brZ
        if bsl_b.l > bsl_x.ln.get_y1() - bsl_marSel * (bsl_atr) and bsl_b.h < bsl_x.ln.get_y1() + bsl_marSel * (bsl_atr)
            bsl_x.bxz.set_rightbottom(bsl_b.i + 1, math.min(bsl_b.l, bsl_x.bxz.get_bottom()))
            if bsl_liqSel
                bsl_x.lne.set_x2(bsl_b.i + 1)
        else
            bsl_x.brZ := false

if bsl_lqVoid and bsl_per
    bull = bsl_b.l - bsl_b.h[2] > bsl_atr200 and bsl_b.l > bsl_b.h[2] and bsl_b.c[1] > bsl_b.h[2]
    bear = bsl_b.l[2] - bsl_b.h > bsl_atr200 and bsl_b.h < bsl_b.l[2] and bsl_b.c[1] < bsl_b.l[2]

    if bull 
        l  = 13
        if bull[1] 
            st = math.abs(bsl_b.l - bsl_b.l[1]) / l
            for i = 0 to l - 1
                array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.l[1] + i * st, bsl_b.i, bsl_b.l[1] + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_B, 90) ))
        else   
            st = math.abs(bsl_b.l - bsl_b.h[2]) / l
            for i = 0 to l - 1
                if bsl_lqText and i == 0
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h[2] + i * st, bsl_b.i, bsl_b.h[2] + (i + 1) * st, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom, text_color = na, border_color = na, bgcolor = color.new(bsl_cLQV_B, 90) ))
                else
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h[2] + i * st, bsl_b.i, bsl_b.h[2] + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_B, 90) ))

    if bear
        l  = 13
        if bear[1]
            st = math.abs(bsl_b.h[1] - bsl_b.h) / l
            for i = 0 to l - 1
                array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h + i * st, bsl_b.i, bsl_b.h + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_S, 90) ))
        else
            st = math.abs(bsl_b.l[2] - bsl_b.h) / l
            for i = 0 to l - 1
                if bsl_lqText and i == l - 1
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h + i * st, bsl_b.i, bsl_b.h + (i + 1) * st, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top, text_color = na, border_color = na, bgcolor = color.new(bsl_cLQV_S, 90) ))
                else
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h + i * st, bsl_b.i, bsl_b.h + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_S, 90) ))

if bsl_b_liq_V.size() > 0
    qt = bsl_b_liq_V.size()
    for bn = qt - 1 to 0
        if bn < bsl_b_liq_V.size()
            cb = bsl_b_liq_V.get(bn)
            ba = math.avg(cb.get_bottom(), cb.get_top())

            if math.sign(bsl_b.c[1] - ba) != math.sign(bsl_b.c - ba) or math.sign(bsl_b.c[1] - ba) != math.sign(bsl_b.l - ba) or math.sign(bsl_b.c[1] - ba) != math.sign(bsl_b.h - ba)
                bsl_b_liq_V.remove(bn)
            else
                cb.set_right(bsl_b.i + 1)

                if bsl_b.i - cb.get_left() > 21
                    cb.set_text_color(color.new(color.gray, 25))


indicator("PLUTUS VISION EURUSD 2026-04-13", overlay=true, max_boxes_count=2000, max_labels_count=2000, max_lines_count=2000)
// week of 2026-04-13 (EURUSD); every number computed by e1_tool from data closed before the anchor 2026-04-13 06:00 UTC (Monday London open)
show_ip = input.bool(true, "E1 IP Zones")
show_disc = input.bool(true, "E1 Discovery Zones (levels to watch)")

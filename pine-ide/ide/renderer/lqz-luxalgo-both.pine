//@version=6
// lqz-luxalgo — the three LuxAlgo liquidity detectors, ONE full-width display
// GENERATED by scripts/lqz_luxalgo_build.py — edit plutus-vision-lqz/*.pine, not this file.
indicator("LQZ LuxAlgo", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)


// ═══ LQZ V1 TAPS ═══
var float lqzV1Mid  = na
var float lqzV1Rail = na
var float lqzV1Swp  = na
var float lqzV1VLo  = na
var float lqzV1VHi  = na

lqzV1PoolMid()  => lqzV1Mid
lqzV1PoolRail() => lqzV1Rail
lqzV1SweepPrc() => lqzV1Swp
lqzV1VoidLo()   => lqzV1VLo
lqzV1VoidHi()   => lqzV1VHi


// ═══ SWEEPS (verbatim + tap) ═══
// ═══ SWEEPS ═══
// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0) https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo

//@version=6
// [merged] SWEEPS indicator() decl removed (single-decl L-4)

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
swp_len = input.int(5, 'Swings', minval=1, group='Liquidity Sweeps')
swp_opt    = input.string('Only Wicks', 'options'
       , options=['Only Wicks', 'Only Outbreaks & Retest', 'Wicks + Outbreaks & Retest'], group='Liquidity Sweeps')

swp_colBl = color(na)
swp_colBr = color(na)
swp_colBl2 = color(na)
swp_colBr2 = color(na)

swp_extend = input.bool(true, 'Extend', group='Sweep Area') 
swp_maxB   = input.int(300, 'Max bars', minval=1, maxval=5000, group='Sweep Area')
swp_colBl3 = color(na)
swp_colBr3 = color(na)

swp_oW = swp_opt == 'Only Wicks'
swp_oO = swp_opt == 'Only Outbreaks & Retest'
swp_WO = swp_opt == 'Wicks + Outbreaks & Retest'

swp_n = bar_index 

//-----------------------------------------------------------------------------}      
//UDT's
//-----------------------------------------------------------------------------{
type swp_piv
    float prc // price
    int   bix // bar_index
    bool  brk // broken
    bool  mit // mitigated
    bool  tak // taken
    bool  wic // wick
    line  lin 

type swp_boxBr 
    box  swp_bx 
    line ln
    bool br
    int  dr

//-----------------------------------------------------------------------------}      
//Variables
//-----------------------------------------------------------------------------{
var array< swp_piv >swp_aPivH  = array.new< swp_piv >(1, swp_piv.new  ())
var array< swp_piv >swp_aPivL  = array.new< swp_piv >(1, swp_piv.new  ())
var array<swp_boxBr>swp_aBoxBr = array.new<swp_boxBr>(1, swp_boxBr.new())

//-----------------------------------------------------------------------------}      
//Methods - functions
//-----------------------------------------------------------------------------{
method swp_isSet(float swp_val) => bool out = not na(swp_val)

method swp_pct(swp_piv swp_obj, float val) => float out = (100 / swp_obj.prc * val) - 100

method swp_line(swp_piv swp_get, color c, string s='sd') => 
    lqzV1Swp := swp_get.prc
method swp_line(swp_piv swp_get, color c, string s='sd') => 
    style = switch s 
        'dt' => line.style_dotted
        'ds' => line.style_dashed
        =>      line.style_solid 
    line.new(swp_get.bix, swp_get.prc, swp_n, swp_get.prc, color=c, style = style)

method swp_break_box(swp_piv swp_get, color c3, color c, int d) =>
    y1 = d == 1 ? high : swp_get.prc
    y2 = d == 1 ? swp_get.prc : low
    swp_boxBr.new( 
     box.new(swp_n -1, y1, swp_n +1, y2
     , border_color
     = color.new(
       na, na   )
     , bgcolor=c3)
     , line.new(swp_n , y1, swp_n, y2, color=c, width=3)
     , false
     , d)

swp_lnDot(y, c) => line.new(swp_n, y, swp_n+3, y, color=c, style=line.style_dotted)

//-----------------------------------------------------------------------------}      
//Execution
//-----------------------------------------------------------------------------{
swp_ph = ta.pivothigh(swp_len, swp_len)
swp_pl = ta.pivotlow (swp_len, swp_len)

if swp_ph.swp_isSet() 
    swp_aPivH.unshift(swp_piv.new(swp_ph, swp_n - swp_len, false, false, false, false))

if swp_pl.swp_isSet() 
    swp_aPivL.unshift(swp_piv.new(swp_pl, swp_n - swp_len, false, false, false, false)) 

for swp_i = swp_aPivH.size() -1 to 0
    swp_get = swp_aPivH.get(swp_i)
    if not swp_get.mit
        if not swp_get.brk
            if close > swp_get.prc 
                if not swp_oW
                    swp_get.brk := true
                else 
                    swp_get.mit := true
            if not swp_oO and not swp_get.wic 
                if high > swp_get.prc and close < swp_get.prc                   
                    swp_aBoxBr.unshift(swp_boxBr.new(
     box.new(swp_n -1, 1 == 1 ? high : swp_get.prc, swp_n +1, 1 == 1 ? swp_get.prc : low
     , border_color = color.new(na, na), bgcolor = swp_colBr3)
     , line.new(swp_n, 1 == 1 ? high : swp_get.prc, swp_n, 1 == 1 ? swp_get.prc : low, color = swp_colBr, width = 3)
     , false, 1))       
                    swp_get.l(swp_colBr2, 'dt'), swp_lnDot(low, swp_colBr)
                    swp_get.wic := true  
        else 
            if close < swp_get.prc 
                swp_get.mit := true
            if not swp_oW and low < swp_get.prc and close > swp_get.prc                    
                swp_aBoxBr.unshift(swp_boxBr.new(
     box.new(swp_n -1, -1 == 1 ? high : swp_get.prc, swp_n +1, -1 == 1 ? swp_get.prc : low
     , border_color = color.new(na, na), bgcolor = swp_colBl3)
     , line.new(swp_n, -1 == 1 ? high : swp_get.prc, swp_n, -1 == 1 ? swp_get.prc : low, color = swp_colBl, width = 3)
     , false, -1))    
                swp_get.l(swp_colBl2, 'ds'), swp_lnDot(high, swp_colBl)
                swp_get.tak := true 

    if swp_n - swp_get.bix > 2000 or swp_get.mit or swp_get.tak 
        swp_aPivH.remove(swp_i).lin.delete()

for swp_i = swp_aPivL.size() -1 to 0
    swp_get = swp_aPivL.get(swp_i)
    if not swp_get.mit
        if not swp_get.brk
            if close < swp_get.prc 
                if not swp_oW
                    swp_get.brk := true
                else 
                    swp_get.mit := true
            if not swp_oO and not swp_get.wic 
                if low < swp_get.prc and close > swp_get.prc                              
                    swp_aBoxBr.unshift(swp_boxBr.new(
     box.new(swp_n -1, -1 == 1 ? high : swp_get.prc, swp_n +1, -1 == 1 ? swp_get.prc : low
     , border_color = color.new(na, na), bgcolor = swp_colBl3)
     , line.new(swp_n, -1 == 1 ? high : swp_get.prc, swp_n, -1 == 1 ? swp_get.prc : low, color = swp_colBl, width = 3)
     , false, -1))     
                    swp_get.l(swp_colBl2, 'dt'), swp_lnDot(high, swp_colBl)
                    swp_get.wic := true 
        else 
            if close > swp_get.prc 
                swp_get.mit := true
            if not swp_oW and high > swp_get.prc and close < swp_get.prc                     
                swp_aBoxBr.unshift(swp_boxBr.new(
     box.new(swp_n -1, 1 == 1 ? high : swp_get.prc, swp_n +1, 1 == 1 ? swp_get.prc : low
     , border_color = color.new(na, na), bgcolor = swp_colBr3)
     , line.new(swp_n, 1 == 1 ? high : swp_get.prc, swp_n, 1 == 1 ? swp_get.prc : low, color = swp_colBr, width = 3)
     , false, 1))    
                swp_get.l(swp_colBr2, 'ds'), swp_lnDot(low, swp_colBr)
                swp_get.tak := true  

    if swp_n - swp_get.bix > 2000 or swp_get.mit or swp_get.tak 
        swp_aPivL.remove(swp_i).lin.delete()

if swp_extend
    for swp_bx in swp_aBoxBr 
    if not na(swp_bx.swp_bx)
        if not swp_bx.br and swp_n - swp_bx.swp_bx.get_left() -1 <= swp_maxB 
            swp_bx.swp_bx.set_right(bar_index)
            if swp_bx.dr == -1 and close < swp_bx.swp_bx.get_bottom() 
                swp_bx.br := true 
            if swp_bx.dr ==  1 and close > swp_bx.swp_bx.get_top   () 
                swp_bx.br := true 

//-----------------------------------------------------------------------------}

// ═══ VOIDS (verbatim + tap) ═══
// ═══ VOIDS ═══
// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0) https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo
//@version=6

// [merged] indicator() decl removed

//------------------------------------------------------------------------------
// Settings
//-----------------------------------------------------------------------------{

mdTT = 'The voi_mode option controls the number of visual objects presented, where\n\n- Historical, takes into account all data available to the user\n- Present, takes into account only the last X bars specified in the \'# Bars\' option'
voi_mode = input.string('Historical', title = 'Mode', options =['Present', 'Historical'], inline = 'MOD')
back = input.int   (360, ' # Bars', minval = 100, maxval = 5000, step = 10, inline = 'MOD', tooltip = mdTT)

lqGR = 'Liquidity Detection'
lqTT = 'Act as a filter while detecting the Liquidity Voids. When set to 0 means no filtering is applied, increasing the value causes the script to check the width of the void compared to a fixed-length ATR value'
voi_lqTH = input.float(.5, 'Liquidity Voids Threshold', minval = 0, step = .1, group = lqGR, tooltip = lqTT)
voi_lqBC = color(na)
voi_lqSC = color(na)
voi_lqTX = input.bool (false, 'Label', inline = 'VD', group = lqGR)

lqFT = 'Toggles the visibility of the Filled Liquidity Voids'
voi_lqVF = input.bool (true, 'Filled Liquidity Voids', inline = 'FL', group = lqGR, tooltip = lqFT)
voi_lqFC = color(na)

//-----------------------------------------------------------------------------}
// User Defined Types
//-----------------------------------------------------------------------------{

// @type        voi_bar properties with their values 
//
// @field h     (float) high price of the voi_bar
// @field l     (float) low price of the voi_bar
// @field c     (float) close price of the voi_bar
// @field i     (int) index of the voi_bar

type voi_bar
    float h = high
    float l = low
    float c = close
    int   i = bar_index

//-----------------------------------------------------------------------------}
// Variables
//-----------------------------------------------------------------------------{

voi_bar voi_b = voi_bar.new()
var voi_lqV = array.new_box()

//-----------------------------------------------------------------------------}
// Calculations
//-----------------------------------------------------------------------------{

voi_per = voi_mode == 'Present' ? last_bar_index - voi_b.i <= back : true
voi_atr = ta.atr(144) * voi_lqTH

// [merged] one script = one 500-box ceiling. SMC pre-allocates its order-block
// boxes on bar 0 (the OLDEST objects); VOIDS keeps filled voids drawn forever, so
// its footprint grows until the engine deletes oldest-first and takes SMC's pool.
// Bound VOIDS' total footprint (every slice, filled or not): delete its own oldest.
var array<box> voi_all = array.new<box>()

if voi_per
    voi_bull = (voi_b.l - voi_b.h[2]) > voi_atr and voi_b.l > voi_b.h[2] and voi_b.c[1] > voi_b.h[2]
    if voi_bull and not voi_bull[1]
        lqzV1VLo := voi_b.l[1]
        lqzV1VHi := voi_b.h[2]
    if voi_bull 
    if voi_bull 
        l = 13
        if voi_bull[1] 
            voi_st = math.abs(voi_b.l - voi_b.l[1]) / l
            for i = 0 to l - 1
                voi_nb = box.new(voi_b.i - 2, voi_b.l[1] + (i + 1) * voi_st, voi_b.i, voi_b.l[1] + i * voi_st, na, bgcolor = voi_lqBC )
                voi_all.push(voi_nb)
                voi_lqV.push(voi_nb)
        else   
            voi_st = math.abs(voi_b.l - voi_b.h[2]) / l
            for i = 0 to l - 1
                if voi_lqTX and i == 0
                    voi_nb = box.new(voi_b.i - 2, voi_b.h[2] + (i + 1) * voi_st, voi_b.i, voi_b.h[2] + i * voi_st, na, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom, text_color = na, bgcolor = voi_lqBC )
                    voi_all.push(voi_nb)
                    voi_lqV.push(voi_nb)
                else
                    voi_nb = box.new(voi_b.i - 2, voi_b.h[2] + (i + 1) * voi_st, voi_b.i, voi_b.h[2] + i * voi_st, na, bgcolor = voi_lqBC )
                    voi_all.push(voi_nb)
                    voi_lqV.push(voi_nb)

    voi_bear = (voi_b.l[2] - voi_b.h) > voi_atr and voi_b.h < voi_b.l[2] and voi_b.c[1] < voi_b.l[2]

    if voi_bear and not voi_bear[1]
        lqzV1VLo := voi_b.l[1]
        lqzV1VHi := voi_b.h[2]
    if voi_bear
    if voi_bear
        l = 13
        if voi_bear[1]
            voi_st = math.abs(voi_b.h[1] - voi_b.h) / l
            for i = 0 to l - 1
                voi_nb = box.new(voi_b.i - 2, voi_b.h + (i + 1) * voi_st, voi_b.i, voi_b.h + i * voi_st, na, bgcolor = voi_lqSC )
                voi_all.push(voi_nb)
                voi_lqV.push(voi_nb)
        else
            voi_st = math.abs(voi_b.l[2] - voi_b.h) / l
            for i = 0 to l - 1
                if voi_lqTX and i == l - 1
                    voi_nb = box.new(voi_b.i - 2, voi_b.h + (i + 1) * voi_st, voi_b.i, voi_b.h + i * voi_st, na, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top, text_color = na, bgcolor = voi_lqSC )
                    voi_all.push(voi_nb)
                    voi_lqV.push(voi_nb)
                else
                    voi_nb = box.new(voi_b.i - 2, voi_b.h + (i + 1) * voi_st, voi_b.i, voi_b.h + i * voi_st, na, bgcolor = voi_lqSC )
                    voi_all.push(voi_nb)
                    voi_lqV.push(voi_nb)

if voi_lqV.size() > 0
    voi_qt = voi_lqV.size()

    for voi_bn = voi_qt - 1 to 0
        if voi_bn < voi_lqV.size()
            voi_cb = voi_lqV.get(voi_bn)
            voi_tBX = voi_cb.get_top()
            voi_bBX = voi_cb.get_bottom()
            if voi_b.h > voi_bBX and voi_b.l < voi_tBX
                if voi_lqVF
                    voi_cb.set_bgcolor(voi_lqFC)
                else
                    voi_cb.delete()
                voi_lqV.remove(voi_bn)
            else
                voi_cb.set_right(voi_b.i + 1)

                if voi_b.i - voi_cb.get_left() > 21
                    voi_cb.set_text_color(chart.fg_color)

    if voi_lqV.size() > 500
        voi_lqV.shift()
while voi_all.size() > 380
    box.delete(voi_all.shift())
//-----------------------------------------------------------------------------}

// ═══ POOLS (verbatim + tap) ═══
// ═══ POOLS ═══
// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0) https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo
 
//@version=6
// [merged] indicator() decl removed
//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
liqGrp = 'Liquidity Detection'
bsl_liqLen = input.int   (7, title = 'Detection Length', minval = 3, maxval = 13, inline = 'LIQ', group = liqGrp)
bsl_liqMar = 10 / input.float (6.9, 'Margin', minval = 4, maxval = 9, step = 0.1, inline = 'LIQ', group = liqGrp)

bsl_liqBuy = input.bool (true, 'Buyside Liquidity Zones, Margin', inline = 'Buyside', group = liqGrp)
bsl_marBuy    = input.float(2.3, '', minval = 1.5, maxval = 10, step = .1, inline = 'Buyside', group = liqGrp)
bsl_cLIQ_B = color(na)

bsl_liqSel = input.bool (true, 'Sellside Liquidity Zones, Margin', inline = 'Sellside', group = liqGrp)
bsl_marSel = input.float(2.3, '', minval = 1.5, maxval = 10, step = .1, inline = 'Sellside', group = liqGrp)
bsl_cLIQ_S = color(na)

bsl_lqVoid = input.bool (false, 'Liquidity Voids, Bullish', inline = 'void', group = liqGrp)
bsl_cLQV_B = color(na)
bsl_cLQV_S = color(na)
bsl_lqText = input.bool (false, 'Label', inline = 'void', group = liqGrp)

bsl_mode   = input.string('Present', title = 'Mode', options =['Present', 'Historical'], inline = 'MOD', group = liqGrp)
bsl_visLiq = input.int   (3, '    # Visible Levels', minval = 1, maxval = 50, inline = 'MOD', group = liqGrp)

//-----------------------------------------------------------------------------}
//General Calculations
//-----------------------------------------------------------------------------{
bsl_maxSize = 50
bsl_atr     = ta.atr(10)
bsl_atr200  = ta.atr(200)
bsl_per     = bsl_mode == 'Present' ? last_bar_index - bar_index <=  500 : true

//-----------------------------------------------------------------------------}
//User Defined Types
//-----------------------------------------------------------------------------{
// @type        used to store pivot high/low data 
//
// @field d     (array<int>) The array where the trend direction is to be maintained
// @field bsl_x     (array<int>) The array where the bsl_bar index value of pivot high/low is to be maintained
// @field y     (array<float>) The array where the price value of pivot high/low is to be maintained

type bsl_ZZ 
    int   [] d
    int   [] x 
    float [] y 

// @type        bsl_bar properties with their values 
//
// @field o     (float) open price of the bsl_bar
// @field h     (float) high price of the bsl_bar
// @field l     (float) low price of the bsl_bar
// @field c     (float) close price of the bsl_bar
// @field i     (int) index of the bsl_bar

type bsl_bar
    float o = open
    float h = high
    float l = low
    float c = close
    int   i = bar_index

// @type        liquidity object definition 
//
// @field bx    (box) box maitaing the liquity level margin extreme levels
// @field bxz   (box) box maitaing the liquity zone margin extreme levels
// @field bxt   (box) box maitaing the labels
// @field brZ   (bool) mainains broken zone status
// @field brL   (bool) mainains broken level status
// @field ln    (line) maitaing the liquity level line
// @field lne   (line) maitaing the liquity extended level line

type bsl_liq
    box   bx
    box   bxz
    box   bxt
    bool  brZ
    bool  brL
    line  ln
    line  lne

//-----------------------------------------------------------------------------}
//Variables
//-----------------------------------------------------------------------------{
var bsl_ZZ bsl_aZZ = bsl_ZZ.new(
 array.new <int>  (bsl_maxSize,  0), 
 array.new <int>  (bsl_maxSize,  0), 
 array.new <float>(bsl_maxSize, na)
 )

bsl_bar bsl_b = bsl_bar.new()

var bsl_liq[] bsl_b_liq_B = array.new<bsl_liq> (1, bsl_liq.new(box(na), box(na), box(na), false, false, line(na), line(na)))
var bsl_liq[] bsl_b_liq_S = array.new<bsl_liq> (1, bsl_liq.new(box(na), box(na), box(na), false, false, line(na), line(na)))

var bsl_b_liq_V = array.new_box()

var int bsl_dir = na, var int bsl_x1 = na, var float bsl_y1 = na, var int bsl_x2 = na, var float bsl_y2 = na

//-----------------------------------------------------------------------------}
//Functions/methods
//-----------------------------------------------------------------------------{
// @function        maintains arrays 
//                     it prepends a `value` to the arrays and removes their oldest element at last position
// @param bsl_aZZ       (UDT<array<int>, array<int>, array<float>>) The UDT obejct of arrays
// @param _d        (array<int>) The array where the trend direction is maintained
// @param _x        (array<int>) The array where the bsl_bar index value of pivot high/low is maintained
// @param _y        (array<float>) The array where the price value of pivot high/low is maintained
//
// @returns         none

method bsl_roll(bsl_ZZ bsl_aZZ, int _d, int _x, float _y) =>
    bsl_aZZ.d.unshift(_d), bsl_aZZ.x.unshift(_x), bsl_aZZ.y.unshift(_y), bsl_aZZ.d.pop(), bsl_aZZ.x.pop(), bsl_aZZ.y.pop()


// @function        (build-in) sets the maximum number of bars that is available for historical reference 
                    
max_bars_back(time, 1000)

//-----------------------------------------------------------------------------}
//Calculations
//-----------------------------------------------------------------------------{
bsl_x2 := bsl_b.i - 1
bsl_ph  = ta.pivothigh(bsl_liqLen, 1)
bsl_pl  = ta.pivotlow (bsl_liqLen, 1)

if bsl_ph   
    bsl_dir := bsl_aZZ.d.get(0) 
    bsl_x1  := bsl_aZZ.x.get(0) 
    bsl_y1  := bsl_aZZ.y.get(0) 
    bsl_y2  := nz(bsl_b.h[1])

    if bsl_dir < 1
        bsl_aZZ.bsl_roll(1, bsl_x2, bsl_y2)
    else
        if bsl_dir == 1 and bsl_ph > bsl_y1 
            bsl_aZZ.x.set(0, bsl_x2), bsl_aZZ.y.set(0, bsl_y2)
    
    if bsl_per
        bsl_count = 0
        bsl_st_P  = 0.
        bsl_st_B  = 0
        bsl_minP  = 0.
        bsl_maxP  = 10e6

        for i = 0 to bsl_maxSize - 1
            if bsl_aZZ.d.get(i) ==  1 
                if bsl_aZZ.y.get(i) > bsl_ph + (bsl_atr / bsl_liqMar)
                    break
                else
                    if bsl_aZZ.y.get(i) > bsl_ph - (bsl_atr / bsl_liqMar) and bsl_aZZ.y.get(i) < bsl_ph + (bsl_atr / bsl_liqMar)
                        bsl_count += 1
                        bsl_st_B := bsl_aZZ.x.get(i)
                        bsl_st_P := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) > bsl_minP
                            bsl_minP := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) < bsl_maxP 
                            bsl_maxP := bsl_aZZ.y.get(i)

        if bsl_count > 2
            bsl_getB = bsl_b_liq_B.get(0)

            if not na(bsl_minP)
                lqzV1Mid := math.avg(bsl_minP, bsl_maxP)
                lqzV1Rail := bsl_atr / bsl_liqMar
            if not na(bsl_getB.bx) and bsl_st_B == bsl_getB.bx.get_left()
                bsl_getB.bx.set_top(math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar))
                bsl_getB.bx.set_rightbottom(bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar))
            else
                bsl_b_liq_B.unshift(
                 bsl_liq.new(
                   box.new(bsl_st_B, math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar), bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar), bgcolor=color(na), border_color=color(na)), 
                   box.new(na, na, na, na, bgcolor = color(na), border_color = color(na)),
                   box.new(bsl_st_B, bsl_st_P, bsl_b.i + 10, bsl_st_P, text = 'Buyside liquidity', text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_bottom, text_color = color.new(bsl_cLIQ_B, 25), bgcolor = color(na), border_color = color(na)),
                   false, 
                   false,
                   line.new(bsl_st_B   , bsl_st_P, bsl_b.i - 1, bsl_st_P, color = color.new(bsl_cLIQ_B, 0)),
                   line.new(bsl_b.i - 1, bsl_st_P, na     , bsl_st_P, color = color.new(bsl_cLIQ_B, 0), style = line.style_dotted))
                 )

                alert('buyside liquidity level detected/updated for ' + syminfo.ticker)

            if bsl_b_liq_B.size() > bsl_visLiq
                bsl_getLast = bsl_b_liq_B.pop()
                bsl_getLast.bx.delete()
                bsl_getLast.bxz.delete()
                bsl_getLast.bxt.delete()
                bsl_getLast.ln.delete()
                bsl_getLast.lne.delete()               

if bsl_pl
    bsl_dir := bsl_aZZ.d.get (0) 
    bsl_x1  := bsl_aZZ.x.get (0) 
    bsl_y1  := bsl_aZZ.y.get (0) 
    bsl_y2  := nz(bsl_b.l[1])
    
    if bsl_dir > -1
        bsl_aZZ.bsl_roll(-1, bsl_x2, bsl_y2)
    else
        if bsl_dir == -1 and bsl_pl < bsl_y1 
            bsl_aZZ.x.set(0, bsl_x2), bsl_aZZ.y.set(0, bsl_y2)
    
    if bsl_per
        bsl_count = 0
        bsl_st_P  = 0.
        bsl_st_B  = 0
        bsl_minP  = 0.
        bsl_maxP  = 10e6

        for i = 0 to bsl_maxSize - 1
            if bsl_aZZ.d.get(i) == -1 
                if bsl_aZZ.y.get(i) < bsl_pl - (bsl_atr / bsl_liqMar)
                    break
                else
                    if bsl_aZZ.y.get(i) > bsl_pl - (bsl_atr / bsl_liqMar) and bsl_aZZ.y.get(i) < bsl_pl + (bsl_atr / bsl_liqMar)
                        bsl_count += 1
                        bsl_st_B := bsl_aZZ.x.get(i)
                        bsl_st_P := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) > bsl_minP
                            bsl_minP := bsl_aZZ.y.get(i)
                        if bsl_aZZ.y.get(i) < bsl_maxP 
                            bsl_maxP := bsl_aZZ.y.get(i)

        if bsl_count > 2
            bsl_getB = bsl_b_liq_S.get(0)

            if not na(bsl_minP)
                lqzV1Mid := math.avg(bsl_minP, bsl_maxP)
                lqzV1Rail := bsl_atr / bsl_liqMar
            if not na(bsl_getB.bx) and bsl_st_B == bsl_getB.bx.get_left()
                bsl_getB.bx.set_top(math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar))
                bsl_getB.bx.set_rightbottom(bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar))
            else
                bsl_b_liq_S.unshift(
                 bsl_liq.new(
                   box.new(bsl_st_B, math.avg(bsl_minP, bsl_maxP) + (bsl_atr / bsl_liqMar), bsl_b.i + 10, math.avg(bsl_minP, bsl_maxP) - (bsl_atr / bsl_liqMar), bgcolor=color(na), border_color=color(na)),
                   box.new(na, na, na, na, bgcolor=color(na), border_color=color(na)),
                   box.new(bsl_st_B, bsl_st_P, bsl_b.i + 10, bsl_st_P, text = 'Sellside liquidity', text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top, text_color = color.new(bsl_cLIQ_S, 25), bgcolor=color(na), border_color=color(na)),
                   false,
                   false,
                   line.new(bsl_st_B   , bsl_st_P, bsl_b.i - 1, bsl_st_P, color = color.new(bsl_cLIQ_S, 0)),
                   line.new(bsl_b.i - 1, bsl_st_P, na     , bsl_st_P, color = color.new(bsl_cLIQ_S, 0), style = line.style_dotted))
                 )  

                alert('sellside liquidity level detected/updated for ' + syminfo.ticker)

            if bsl_b_liq_S.size() > bsl_visLiq
                bsl_getLast = bsl_b_liq_S.pop()
                bsl_getLast.bx.delete()
                bsl_getLast.bxz.delete()
                bsl_getLast.bxt.delete()
                bsl_getLast.ln.delete()            
                bsl_getLast.lne.delete()               


for i = 0 to bsl_b_liq_B.size() - 1
    bsl_x = bsl_b_liq_B.get(i)
    
    if not bsl_x.brL
        bsl_x.lne.set_x2(bsl_b.i)

        if bsl_b.h > bsl_x.bx.get_top()
            bsl_x.brL := true
            bsl_x.brZ := true
            alert('buyside liquidity level breached for ' + syminfo.ticker)

            bsl_x.bxz.set_lefttop(bsl_b.i - 1, math.min(bsl_x.ln.get_y1() + bsl_marBuy * (bsl_atr), bsl_b.h))
            bsl_x.bxz.set_rightbottom(bsl_b.i + 1, bsl_x.ln.get_y1())
            bsl_x.bxz.set_bgcolor(color.new(bsl_cLIQ_B, bsl_liqBuy ? 73 : 100))

    else if bsl_x.brZ
        if bsl_b.l > bsl_x.ln.get_y1() - bsl_marBuy * (bsl_atr) and bsl_b.h < bsl_x.ln.get_y1() + bsl_marBuy * (bsl_atr)
            bsl_x.bxz.set_right(bsl_b.i + 1)
            bsl_x.bxz.set_top(math.max(bsl_b.h, bsl_x.bxz.get_top()))
            if bsl_liqBuy
                bsl_x.lne.set_x2(bsl_b.i + 1)
        else
            bsl_x.brZ := false

for i = 0 to bsl_b_liq_S.size() - 1
    bsl_x = bsl_b_liq_S.get(i)

    if not bsl_x.brL
        bsl_x.lne.set_x2(bsl_b.i)

        if bsl_b.l < bsl_x.bx.get_bottom()
            bsl_x.brL := true
            bsl_x.brZ := true
            alert('sellside liquidity level breached for ' + syminfo.ticker)

            bsl_x.bxz.set_lefttop(bsl_b.i - 1, bsl_x.ln.get_y1())
            bsl_x.bxz.set_rightbottom(bsl_b.i + 1, math.max(bsl_x.ln.get_y1() - bsl_marSel * (bsl_atr), bsl_b.l))
            bsl_x.bxz.set_bgcolor(color.new(bsl_cLIQ_S, bsl_liqSel ? 73 : 100))

    else if bsl_x.brZ
        if bsl_b.l > bsl_x.ln.get_y1() - bsl_marSel * (bsl_atr) and bsl_b.h < bsl_x.ln.get_y1() + bsl_marSel * (bsl_atr)
            bsl_x.bxz.set_rightbottom(bsl_b.i + 1, math.min(bsl_b.l, bsl_x.bxz.get_bottom()))
            if bsl_liqSel
                bsl_x.lne.set_x2(bsl_b.i + 1)
        else
            bsl_x.brZ := false

if bsl_lqVoid and bsl_per
    bull = bsl_b.l - bsl_b.h[2] > bsl_atr200 and bsl_b.l > bsl_b.h[2] and bsl_b.c[1] > bsl_b.h[2]
    bear = bsl_b.l[2] - bsl_b.h > bsl_atr200 and bsl_b.h < bsl_b.l[2] and bsl_b.c[1] < bsl_b.l[2]

    if bull 
        l  = 13
        if bull[1] 
            st = math.abs(bsl_b.l - bsl_b.l[1]) / l
            for i = 0 to l - 1
                array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.l[1] + i * st, bsl_b.i, bsl_b.l[1] + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_B, 90) ))
        else   
            st = math.abs(bsl_b.l - bsl_b.h[2]) / l
            for i = 0 to l - 1
                if bsl_lqText and i == 0
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h[2] + i * st, bsl_b.i, bsl_b.h[2] + (i + 1) * st, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom, text_color = na, border_color = na, bgcolor = color.new(bsl_cLQV_B, 90) ))
                else
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h[2] + i * st, bsl_b.i, bsl_b.h[2] + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_B, 90) ))

    if bear
        l  = 13
        if bear[1]
            st = math.abs(bsl_b.h[1] - bsl_b.h) / l
            for i = 0 to l - 1
                array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h + i * st, bsl_b.i, bsl_b.h + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_S, 90) ))
        else
            st = math.abs(bsl_b.l[2] - bsl_b.h) / l
            for i = 0 to l - 1
                if bsl_lqText and i == l - 1
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h + i * st, bsl_b.i, bsl_b.h + (i + 1) * st, text = 'Liquidity Void   ', text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top, text_color = na, border_color = na, bgcolor = color.new(bsl_cLQV_S, 90) ))
                else
                    array.push(bsl_b_liq_V, box.new(bsl_b.i - 2, bsl_b.h + i * st, bsl_b.i, bsl_b.h + (i + 1) * st, border_color = na, bgcolor = color.new(bsl_cLQV_S, 90) ))

if bsl_b_liq_V.size() > 0
    qt = bsl_b_liq_V.size()
    for bn = qt - 1 to 0
        if bn < bsl_b_liq_V.size()
            cb = bsl_b_liq_V.get(bn)
            ba = math.avg(cb.get_bottom(), cb.get_top())

            if math.sign(bsl_b.c[1] - ba) != math.sign(bsl_b.c - ba) or math.sign(bsl_b.c[1] - ba) != math.sign(bsl_b.l - ba) or math.sign(bsl_b.c[1] - ba) != math.sign(bsl_b.h - ba)
                bsl_b_liq_V.remove(bn)
            else
                cb.set_right(bsl_b.i + 1)

                if bsl_b.i - cb.get_left() > 21
                    cb.set_text_color(color.new(color.gray, 25))

//-----------------------------------------------------------------------------}

// ═══ LQZ core + render ═══
// ── inputs ──────────────────────────────────────────────────────────────────
lqzSource   = input.string("both", "Liquidity detector", options = ["luxalgo", "candles", "both"], group = "LQZ")
lqzTol      = input.float(0.5, "Overlap tolerance (x ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = "LQZ")
lqzMinAgree = input.int(2, "Min agreeing sources", minval = 1, maxval = 4, group = "LQZ")
lqzMaxZones = input.int(60, "Max zones", minval = 5, maxval = 200, group = "LQZ")
lqzMaxLevels = 900

// ── state ───────────────────────────────────────────────────────────────────
var array<float> lqzLevels    = array.new<float>()
var array<int>   lqzLevelSrc  = array.new<int>()
var array<int>   lqzLevelSide = array.new<int>()
var array<int>   lqzLevelBar  = array.new<int>()

var array<float> lqzZLevel  = array.new<float>()
var array<float> lqzZTop    = array.new<float>()
var array<float> lqzZBottom = array.new<float>()
var array<int>   lqzZSide   = array.new<int>()
var array<int>   lqzZMask   = array.new<int>()
var array<int>   lqzZConf   = array.new<int>()

lqzSink(price, srcId, side) =>
    // BOUNDED BUFFER. lqzSink fires on every touch; unbounded it grew without limit and the
    // O(n^2) cluster on the last bar wedged the station outright (measured: 15m hung the
    // single-threaded station for 315 s and blocked every other request). Evict-oldest keeps
    // the most recent lqzMaxLevels, which is the window that matters.
    if array.size(lqzLevels) >= lqzMaxLevels
        array.shift(lqzLevels), array.shift(lqzLevelSrc), array.shift(lqzLevelSide), array.shift(lqzLevelBar)
    array.push(lqzLevels, price), array.push(lqzLevelSrc, srcId), array.push(lqzLevelSide, side), array.push(lqzLevelBar, bar_index), price

// tolerance the cluster needs (the V2 detector block is not part of D1)
lqzAtr  = ta.atr(14)
lqzTolP = lqzTol * nz(lqzAtr, syminfo.mintick * 10)
// ═════════════════════════════════════════════════════════════════════════════
// V1 - THE LUXALGO TAP (host-supplied, scalar accessors - PineTS has no tuple
// assignment). CORE does not know how the deliverable stores a pivot, a sweep or
// an FVG; each deliverable implements these five against ITS OWN LuxAlgo code,
// so detection is never reimplemented here - that is what keeps D1 at parity.
//   na  = "no hit this bar" and is skipped.
lqzV1Enabled = lqzSource == "luxalgo" or lqzSource == "both"
if lqzV1Enabled
    _mid  = lqzV1PoolMid()
    _rail = lqzV1PoolRail()
    if not na(_mid)
        lqzSink(_mid + _rail, 1, 1)      // buyside rail, above price
        lqzSink(_mid - _rail, 1, 1)      // sellside rail, below price
        lqzSink(_mid,        1, 1)      // the cluster centre

    _swp = lqzV1SweepPrc()
    if not na(_swp)
        lqzSink(_swp, 2, _swp >= close ? 1 : 0)

    _vlo = lqzV1VoidLo()
    _vhi = lqzV1VoidHi()
    if not na(_vlo)
        lqzSink(_vlo, 4, 1)
        lqzSink(_vhi, 4, 1)

// ═════════════════════════════════════════════════════════════════════════════
// THE CONFIRMATION - horizontal alignment.
// THE operator draws ONE zone where the sources CONCUR; three separate renders at
// the same level is the defect this pass removes. So: group every recorded
// level into same-side price bands, and emit a zone only for a band that
// carries >= lqzMinAgree DISTINCT sources (or, when minAgree == 1, any band).
lqzV2Enabled = lqzSource == "candles" or lqzSource == "both"
if lqzV2Enabled and lqzSource == "luxalgo"
    runtime.error("lqzSource cannot be both 'luxalgo' and V2-active")
if lqzV2Enabled and barstate.islast
    // nothing to cluster mid-run; the cluster pass runs below on the last bar

// ── the cluster pass: run on the last bar so the full history is in the arrays ──
if barstate.islast
    n = array.size(lqzLevels)
    if n > 0
        // insertion sort by price (levels are few; n <= a few hundred)
        for a = 1 to n - 1
            if a >= n
                break
            ka = array.get(lqzLevels, a)
            sa = array.get(lqzLevelSrc, a)
            da = array.get(lqzLevelSide, a)
            ba = array.get(lqzLevelBar, a)
            b = a - 1
            while b >= 0 and array.get(lqzLevels, b) > ka
                array.set(lqzLevels, b + 1, array.get(lqzLevels, b))
                array.set(lqzLevelSrc, b + 1, array.get(lqzLevelSrc, b))
                array.set(lqzLevelSide, b + 1, array.get(lqzLevelSide, b))
                array.set(lqzLevelBar, b + 1, array.get(lqzLevelBar, b))
                b := b - 1
            array.set(lqzLevels, b + 1, ka)
            array.set(lqzLevelSrc, b + 1, sa)
            array.set(lqzLevelSide, b + 1, da)
            array.set(lqzLevelBar, b + 1, ba)

        // walk the sorted levels, extending a band while the next one is within tol.
        // PineTS has no bitwise ops, so distinct-source counting is 4 explicit flags.
        i = 0
        while i < n
            lo = array.get(lqzLevels, i)
            hi = lo
            sd = array.get(lqzLevelSide, i)
            h1 = false
            h2 = false
            h4 = false
            h8 = false
            h16 = false
            j = i + 1
            while j < n
                pj = array.get(lqzLevels, j)
                if array.get(lqzLevelSide, j) != sd or pj - hi > lqzTolP
                    break
                hi := pj
                sj = array.get(lqzLevelSrc, j)
                h1 := h1 or sj == 1
                h2 := h2 or sj == 2
                h4 := h4 or sj == 4
                h8 := h8 or sj == 8
                h16 := h16 or sj == 16
                j := j + 1
            s0 = array.get(lqzLevelSrc, i)
            h1 := h1 or s0 == 1
            h2 := h2 or s0 == 2
            h4 := h4 or s0 == 4
            h8 := h8 or s0 == 8
            h16 := h16 or s0 == 16
            conf = (h1 ? 1 : 0) + (h2 ? 1 : 0) + (h4 ? 1 : 0) + (h8 ? 1 : 0) + (h16 ? 1 : 0)
            // In candles-only mode V2 has ALREADY gated every level on >= 2 touches
            // ("where has price touched multiple times?") — that IS its confirmation, so
            // demanding a second DISTINCT source would make candles-only emit nothing.
            // In luxalgo/both mode the 2-distinct-source rule stands: a lone candle level
            // next to three LuxAlgo rails is a candidate, never a zone.
            _need = lqzSource == "candles" ? 1 : lqzMinAgree
            if conf >= _need and array.size(lqzZLevel) < lqzMaxZones
                array.push(lqzZLevel, (lo + hi) / 2)
                array.push(lqzZTop, hi)
                array.push(lqzZBottom, lo)
                array.push(lqzZSide, sd)
                array.push(lqzZMask, conf)
                array.push(lqzZConf, conf)
            i := j

// ═════════════════════════════════════════════════════════════════════════════
// LQZ RENDER — the full-width horizontal zone emitter.
// CONSUMES (read-only; never mutates) the arrays W1 emits:
//   lqzZLevel[] lqzZTop[] lqzZBottom[] lqzZSide[] lqzZMask[] lqzZConf[]
//
// THE MEASURED TARGET (scripts/measure_ladder.py, WINNING_TRADE_LIBARARY):
//   coverage 99-100 % of the plot row   -> the band MUST span the whole chart
//   GREEN/teal #3E8A46  33 bands        -> SELL_SIDE, liquidity BELOW price
//   RED           #7F3613   7 bands    -> BUY_SIDE,  liquidity ABOVE price
//   line thickness 1px, 2px where doubled
//
// The LuxAlgo three each drew their OWN primitive (box / dotted line / 13-slice
// stack), so three different render styles collided at one level. This emitter is
// the ONLY place a liquidity level becomes a pixel — that is the defect removed.

lqzColorB = input.color(#3E8A46, "Demand zone (below price)", group = "LQZ render")
lqzColorS = input.color(#7F3613, "Supply zone (above price)", group = "LQZ render")
lqzLineW   = input.int(1, "Line width (px)", minval = 1, maxval = 4, group = "LQZ render")
lqzLineTol = input.float(0.0, "Rails separate above (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = "LQZ render")
lqzFill3   = input.bool(true, "Fill bands with 3+ sources", group = "LQZ render")
lqzFillA   = input.int(10, "Fill alpha (3+ sources)", minval = 0, maxval = 60, group = "LQZ render")
lqzLeftB  = input.int(500, "Left margin (bars)", minval = 1, maxval = 500, group = "LQZ render")
lqzRightB = input.int(20,  "Right margin (bars)", minval = 1, maxval = 300, group = "LQZ render")
lqzThickE = input.float(0.35, "Thinnest band (x ATR)", minval = 0.0, maxval = 2.0, step = 0.1, group = "LQZ render")
lqzLabel  = input.bool(true, "Label the band", group = "LQZ render")

// BAND FLOOR. A band thinner than the renderer's own resolution collapses to
// nothing on screen and reads as "missing liquidity". Floor it on ATR, NOT on
// syminfo.mintick: this engine reports mintick = 1e-16, which made every
// degenerate band invisible (measured: band height min 0.00000 over 50 boxes).
// mintick stays only as a secondary guard when ATR is unavailable.
lqzMinTick = math.max(syminfo.mintick, 0.0)
lqzThick   = math.max(lqzThickE * nz(ta.atr(14), 0.0), nz(lqzMinTick, 0.0))

f_lqzRender() =>
    // THE PRIMITIVE IS A LINE, NOT A FILLED BOX.
    // Measured from WINNING_TRADE_LIBARARY: 33 green bands, thickness 1px (2px where
    // doubled), row coverage 99-100 %. The first cut emitted filled boxes at 0.35xATR —
    // the count said "39 boxes PASS" and the chart was a barcode: thick translucent slabs
    // stacked wall to wall, candles unreadable. The look is the only thing that caught it.
    _n = array.size(lqzZLevel)
    if _n > 0
        for i = 0 to _n - 1
            if i >= _n
                break
            _sd = array.get(lqzZSide, i)
            _lo = array.get(lqzZBottom, i)
            _hi = array.get(lqzZTop, i)
            _cf = array.get(lqzZConf, i)
            _mid = (_hi + _lo) / 2
            _col = na(_sd) ? lqzColorB : (_sd == 1 ? lqzColorS : lqzColorB)
            // ^ THE NA GUARD. Measured: ALL ladder lines carried colours ['None'] in the
            //   payload, which means _sd was NA and the ternary yielded NA -- and an NA colour
            //   falls through to vision.mjs's BRASS default, rendering the ladder as faint
            //   brass dots at 1px. Same class as the box FILL bug: an NA reaching a renderer
            //   fallback. A zone whose side is unknown is still a zone and must be visible.
            _lx = math.max(0, bar_index - lqzLeftB)
            // a thin zone collapses onto one line; a real one keeps its two rails
            _span = _hi - _lo
            if _span > lqzLineTol
                line.new(_lx, _hi, bar_index + lqzRightB, _hi, color = _col, width = lqzLineW)
                line.new(_lx, _lo, bar_index + lqzRightB, _lo, color = _col, width = lqzLineW)
                line.new(_lx, _mid, bar_index + lqzRightB, _mid,
                         color = _col, style = line.style_dashed, width = 1)
            else
                line.new(_lx, _mid, bar_index + lqzRightB, _mid, color = _col, width = lqzLineW)
            // THE LABEL — the emission `lqzLabel` was declared for and never got. Measured:
            //   the input read "declared: 1, referenced: 1" (its own declaration only) and the
            //   whole file carried ZERO label.new calls, so the run's `labels` count was 0 at
            //   every timeframe. THE CONSEQUENCE: the gate's MECH_VETO (gate.mjs:157) reads a
            //   drawn-but-unlabelled chart as "the indicator is not on this chart" and returns
            //   deltas ['MECH_VETO:boxes=117:labels=0'] -> FAIL, and the LIBRARY's own look is
            //   labelled ("30m LQ Sellside Liquidity", "Liquidity Void") -- so a zone without
            //   its tag is the defect, not a style choice. textcolor carries the side colour;
            //   color(na) draws no plate, matching the library's bare tag-on-chart look.
            if lqzLabel
                label.new(bar_index + lqzRightB, _mid, _sd == 1 ? "Sellside Liquidity" : "Buyside Liquidity",
                          xloc = xloc.bar_index, style = label.style_label_left, size = size.tiny,
                          color = color(na), textcolor = _col)
            // 3+ agreeing sources get a whisper of fill so the dense bands read as one zone
            if lqzFill3 and _cf >= 3 and _span > lqzLineTol
                box.new(_lx, _hi, bar_index + lqzRightB, _lo,
                     border_color = na, bgcolor = color.new(_col, lqzFillA))
        0

if barstate.islast
    f_lqzRender()

indicator("PLUTUS VISION GBPUSD 2026-03-23", overlay=true, max_boxes_count=2000, max_labels_count=2000, max_lines_count=2000)
// week of 2026-03-23 (GBPUSD); every number computed by e1_tool from data closed before the anchor 2026-03-23 06:00 UTC (Monday London open)
show_ip = input.bool(true, "E1 IP Zones")

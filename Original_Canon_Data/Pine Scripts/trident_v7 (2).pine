//@version=6
indicator("TRIDENT v7", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════
// TRIDENT v7 — CLEAN, CORRECT, LOCKED
//
// CHART CONTENTS:
//   ✅ IP Zones only (5): Resistance=RED, Equilibrium=GOLD, Support=TEAL
//   ✅ LSZ Zones (6): GREEN filled boxes, NO LABELS, SAME width as IP zones
//   ✅ Option Strike Targets (7): amber lines + labels
//   ❌ 4H Supply/Demand: REMOVED (data unreliable)
//   ❌ Pivots: removed (clutter)
//   ❌ Trade setups: table only (no chart drawings)
//
// ZONE DATE RANGE: Locked Apr 20 → May 1 (2 weeks only)
// ALL LABELS: Centered at (midB, midY) inside each zone
// TABLE: 2×17, trades section = 3 rows per trade (Entries / SL|TP / Days+RRR)
// COLORS:
//   IP Resistance = RED
//   IP Equilibrium = GOLD (not green!)
//   IP Support = TEAL (not blue!)
//   LSZ = GREEN (ACTIVE=bright, STANDARD=normal) — NO LABELS
//   Option strikes = AMBER
// ═══════════════════════════════════════════════════════════════

string GRP_VIS = "Visibility"

show_zones   = input.bool(true, "IP Zones",        group=GRP_VIS)
show_lsz     = input.bool(true, "LSZ",              group=GRP_VIS)
show_options = input.bool(true, "Option Strikes",    group=GRP_VIS)
show_table   = input.bool(true, "Info Table",        group=GRP_VIS)

// ── ZONE DATE RANGE: 6 weeks — 2 weeks back + data week + 3 weeks forward ──
// Data week Apr 20-24 is the center; extends back to Apr 6, forward to May 15
// Using xloc.bar_time so timestamps work regardless of bar distance
int tsL   = timestamp(2026, 4, 6, 0, 0, 0)
int tsR   = timestamp(2026, 5, 15, 23, 59, 59)
int tsMid = (tsL + tsR) / 2

// ═══════════════════════════════════════════════════════════════
// COLORS
// ═══════════════════════════════════════════════════════════════

// IP Resistance (RED)
R_F1 = color.new(color.rgb(180,40,30), 70),  R_B1 = color.rgb(180,40,30)
R_F2 = color.new(color.rgb(200,60,35), 70),  R_B2 = color.rgb(200,60,35)
R_F3 = color.new(color.rgb(210,80,40), 70),  R_B3 = color.rgb(210,80,40)
R_F4 = color.new(color.rgb(220,100,50), 70), R_B4 = color.rgb(220,100,50)
R_F5 = color.new(color.rgb(230,130,60), 70), R_B5 = color.rgb(230,130,60)
R_F6 = color.new(color.rgb(240,160,90), 70), R_B6 = color.rgb(240,160,90)

// IP Equilibrium (ORANGE #FF9800)
G_F1 = color.new(color.rgb(255,152,0), 70),   G_B1 = color.rgb(255,152,0)
G_F2 = color.new(color.rgb(245,145,10), 70),  G_B2 = color.rgb(245,145,10)
G_F3 = color.new(color.rgb(235,138,20), 70),  G_B3 = color.rgb(235,138,20)
G_F4 = color.new(color.rgb(225,131,30), 70),  G_B4 = color.rgb(225,131,30)
G_F5 = color.new(color.rgb(215,124,40), 70),  G_B5 = color.rgb(215,124,40)
G_F6 = color.new(color.rgb(205,117,50), 70),  G_B6 = color.rgb(205,117,50)

// IP Support (TEAL — not blue!)
T_F1 = color.new(color.rgb(0,150,150), 70),  T_B1 = color.rgb(0,150,150)
T_F2 = color.new(color.rgb(0,170,160), 70),  T_B2 = color.rgb(0,170,160)
T_F3 = color.new(color.rgb(20,180,170), 70), T_B3 = color.rgb(20,180,170)
T_F4 = color.new(color.rgb(40,190,180), 70), T_B4 = color.rgb(40,190,180)
T_F5 = color.new(color.rgb(60,200,190), 70), T_B5 = color.rgb(60,200,190)
T_F6 = color.new(color.rgb(80,210,200), 70), T_B6 = color.rgb(80,210,200)

zfill(string cat, string deg) =>
    color result = color.gray
    if cat == "RES"
        if deg == "EXTREME"
            result := R_F1
        else if deg == "HEAVY"
            result := R_F2
        else if deg == "MODERATE-HEAVY"
            result := R_F3
        else if deg == "MODERATE"
            result := R_F4
        else if deg == "LIGHT"
            result := R_F5
        else
            result := R_F6
    else if cat == "MID"
        if deg == "EXTREME"
            result := G_F1
        else if deg == "HEAVY"
            result := G_F2
        else if deg == "MODERATE-HEAVY"
            result := G_F3
        else if deg == "MODERATE"
            result := G_F4
        else if deg == "LIGHT"
            result := G_F5
        else
            result := G_F6
    else if cat == "SUP"
        if deg == "EXTREME"
            result := T_F1
        else if deg == "HEAVY"
            result := T_F2
        else if deg == "MODERATE-HEAVY"
            result := T_F3
        else if deg == "MODERATE"
            result := T_F4
        else if deg == "LIGHT"
            result := T_F5
        else
            result := T_F6
    else
        result := T_F4
    result

zbord(string cat, string deg) =>
    color result = color.gray
    if cat == "RES"
        if deg == "EXTREME"
            result := R_B1
        else if deg == "HEAVY"
            result := R_B2
        else if deg == "MODERATE-HEAVY"
            result := R_B3
        else if deg == "MODERATE"
            result := R_B4
        else if deg == "LIGHT"
            result := R_B5
        else
            result := R_B6
    else if cat == "MID"
        if deg == "EXTREME"
            result := G_B1
        else if deg == "HEAVY"
            result := G_B2
        else if deg == "MODERATE-HEAVY"
            result := G_B3
        else if deg == "MODERATE"
            result := G_B4
        else if deg == "LIGHT"
            result := G_B5
        else
            result := G_B6
    else if cat == "SUP"
        if deg == "EXTREME"
            result := T_B1
        else if deg == "HEAVY"
            result := T_B2
        else if deg == "MODERATE-HEAVY"
            result := T_B3
        else if deg == "MODERATE"
            result := T_B4
        else if deg == "LIGHT"
            result := T_B5
        else
            result := T_B6
    else
        result := T_B4
    result

pressureLbl(string deg) =>
    deg == "EXTREME" ? "Extreme" : deg == "HEAVY" ? "Heavy" : deg == "MODERATE-HEAVY" ? "Moderate-Heavy" : deg == "MODERATE" ? "Moderate" : deg == "LIGHT" ? "Light" : "Minimal"

// LSZ — ALL GREEN, FILLED ZONES (same width as IP), NO LABELS
LSZ_STD_F = color.new(color.rgb(40,180,80), 70),  LSZ_STD_B = color.rgb(40,180,80)
LSZ_ACT_F = color.new(color.rgb(80,230,100), 60), LSZ_ACT_B = color.rgb(80,230,100)

// ═══════════════════════════════════════════════════════════════
// DATA
// ═══════════════════════════════════════════════════════════════

// ── IP Zones (5) ──
var array<float>  zTp   = array.from(99.23, 98.99, 98.41, 98.12, 97.97)
var array<float>  zBt   = array.from(99.16, 98.77, 98.29, 98.00, 97.63)
var array<string> zCat  = array.from("RES", "RES", "MID", "SUP", "SUP")
var array<string> zDeg  = array.from("HEAVY", "MODERATE-HEAVY", "MODERATE-HEAVY", "MODERATE", "HEAVY")
var array<string> zTir  = array.from("T2", "T1", "T2", "T2", "T1")
var array<string> zNm   = array.from("IP Resistance Ceiling", "Upper IP Resistance", "Equilibrium Zone", "Mid-Range Support", "Key IP Support")

// ── LSZ Zones (6) — GREEN FILLED BOXES, SAME WIDTH AS IP, NO LABELS ──
var array<float>  xTp   = array.from(97.68, 97.88, 98.02, 98.58, 98.34, 99.23)
var array<float>  xBt   = array.from(97.63, 97.83, 97.97, 98.53, 98.29, 99.18)
var array<string> xPri  = array.from("ACTIVE", "STANDARD", "STANDARD", "STANDARD", "STANDARD", "STANDARD")

// ── Option Strikes — DXY levels, >=1B only ──
var array<float>  oPr   = array.from(99.22, 98.49, 98.32, 97.78, 98.86, 98.44, 98.25)
var array<string> oVol  = array.from("1.9bn", "2.6bn", "1.1bn", "1.0bn", "1.8bn", "1.1bn", "1.8bn")

// ── Trade Setups (2) — TABLE ONLY ──
var array<float>  tEn1  = array.from(98.29, 97.85)
var array<float>  tEn3  = array.from(98.05, 97.68)
var array<float>  tSl   = array.from(98.50, 97.55)
var array<float>  tTp   = array.from(97.70, 98.65)
var array<float>  tRr   = array.from(2.8, 4.0)
var array<string> tTir  = array.from("T2", "T1")
var array<string> tDE   = array.from("Wed", "Thu")
var array<string> tDT   = array.from("Thu-Fri", "Fri")

// ── Macro Shape ──
var array<string> sCh   = array.from("SS>BS>R>WL")
var array<float>  sCf   = array.from(52.0)
var array<string> sAlt  = array.from("SS>WLS>BS")
var array<float>  sAc   = array.from(35.0)

// ── TABLE 2×17 — trades = 3 rows each (Entries / SL|TP / Days+RRR) ──
// Row 0:  Header
// Row 1:  Chain
// Row 2:  Alt
// Row 3:  Days
// Row 4:  ZONES header
// Row 5-9: IP Zones (5)
// Row 10: TRADES header
// Row 11: Short T2 — Entries
// Row 12: Short T2 — SL | TP
// Row 13: Short T2 — Days + RRR
// Row 14: Long T1 — Entries
// Row 15: Long T1 — SL | TP
// Row 16: Long T1 — Days + RRR
var table tbl = table.new(position.top_right, 2, 17, bgcolor=color.new(color.black, 10), border_color=color.rgb(40,40,45), border_width=1)

// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════

volLbl(string vol) =>
    string result = "$"
    if str.contains(vol, "bn")
        string num = str.replace(vol, "bn", "")
        float val = str.tonumber(num)
        result := "$" + str.tostring(val, "#.#") + "B"
    else
        result := "$" + vol
    result

calcZFP(float tp, float bt) =>
    float zoneW = tp - bt
    int pct = math.round(zoneW / 1.60 * 100.0)
    pct

// ═══════════════════════════════════════════════════════════════
// DRAW ON LAST BAR
// ═══════════════════════════════════════════════════════════════

if barstate.islast
    int nZ = array.size(zTp)
    int nX = array.size(xTp)
    int nO = array.size(oPr)

    // ═══════════════════════════════════════════════════════════
    // LAYER 1: IP ZONES — full width, Apr 20 → May 1
    //   RES = RED, MID = GOLD, SUP = TEAL
    //   Label: "Zone Name | Pressure | XX% ZFP" centered
    // ═══════════════════════════════════════════════════════════

    if show_zones and nZ > 0
        for i = 0 to nZ - 1
            string c   = array.get(zCat, i)
            string d   = array.get(zDeg, i)
            float  tp  = array.get(zTp, i)
            float  bt  = array.get(zBt, i)
            string nm  = array.get(zNm, i)
            box.new(tsL, tp, tsR, bt, bgcolor=zfill(c, d), border_color=zbord(c, d), border_width=2, border_style=line.style_solid, xloc=xloc.bar_time)

            float midY = (tp + bt) / 2.0
            string prs = pressureLbl(d)
            int zfp = calcZFP(tp, bt)
            string lbl = nm + " | " + prs + " | " + str.tostring(zfp) + "% ZFP"

            label.new(tsMid, midY, lbl, xloc=xloc.bar_time, style=label.style_none, textcolor=color.white, size=size.normal)

    // ═══════════════════════════════════════════════════════════
    // LAYER 2: LSZ — GREEN FILLED ZONES, SAME WIDTH AS IP
    //   NO LABELS — just green boxes
    // ═══════════════════════════════════════════════════════════

    if show_lsz and nX > 0
        for i = 0 to nX - 1
            float  tp    = array.get(xTp, i)
            float  bt    = array.get(xBt, i)
            string pri   = array.get(xPri, i)
            bool   isAct = pri == "ACTIVE"

            color x_bg = isAct ? LSZ_ACT_F : LSZ_STD_F
            color x_bd = isAct ? LSZ_ACT_B : LSZ_STD_B
            int   x_w  = isAct ? 2 : 1

            box.new(tsL, tp, tsR, bt, bgcolor=x_bg, border_color=x_bd, border_width=x_w, border_style=line.style_solid, xloc=xloc.bar_time)

    // ═══════════════════════════════════════════════════════════
    // LAYER 3: OPTION STRIKES — amber lines + centered labels
    //   Label: "$X.XB Option Strike Target"
    // ═══════════════════════════════════════════════════════════

    if show_options and nO > 0
        for i = 0 to nO - 1
            float  op  = array.get(oPr, i)
            string vol = array.get(oVol, i)
            int    ow  = str.contains(vol, "bn") ? 2 : 1

            line.new(tsL, op, tsR, op, xloc=xloc.bar_time, color=color.rgb(255,200,60), width=ow, style=line.style_solid)

            string oLbl = volLbl(vol) + " Option Strike Target"
            label.new(tsMid, op, oLbl, xloc=xloc.bar_time, style=label.style_none, textcolor=color.rgb(255,200,60), size=size.normal)

    // ═══════════════════════════════════════════════════════════
    // TABLE — 2×17, trades = 3 rows each
    // ═══════════════════════════════════════════════════════════

    if show_table
        // ── Header ──
        table.cell(tbl, 0, 0, "TRIDENT v7", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl, 1, 0, "DXY Apr20-24", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))

        // ── Macro ──
        table.cell(tbl, 0, 1, "Chain", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 1, 1, array.get(sCh,0) + " " + str.tostring(array.get(sCf,0), "#") + "%", text_color=color.white, text_size=size.small)

        table.cell(tbl, 0, 2, "Alt", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 1, 2, array.get(sAlt,0) + " " + str.tostring(array.get(sAc,0), "#") + "%", text_color=color.gray, text_size=size.small)

        table.cell(tbl, 0, 3, "Days", text_color=color.gray, text_size=size.small)
        table.cell(tbl, 1, 3, "M:SS/H T:SS-BS W:BS-R Th:R-SS F:SS-WL", text_color=color.white, text_size=size.small)

        // ── ZONES section ──
        table.cell(tbl, 0, 4, "ZONES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl, 1, 4, "", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))

        for i = 0 to nZ - 1
            string c = array.get(zCat, i)
            string tag = c == "RES" ? "RES" : c == "MID" ? "EQ" : "SUP"
            color bg = c == "RES" ? color.rgb(60,12,8) : c == "MID" ? color.rgb(50,38,8) : color.rgb(0,40,40)
            string pr = str.tostring(array.get(zTp,i), "#.##") + "-" + str.tostring(array.get(zBt,i), "#.##")
            string prs = pressureLbl(array.get(zDeg, i))
            int zfp = calcZFP(array.get(zTp, i), array.get(zBt, i))
            table.cell(tbl, 0, i+5, tag, text_color=color.white, text_size=size.small, bgcolor=bg)
            table.cell(tbl, 1, i+5, pr + " " + prs + " " + str.tostring(zfp) + "%ZFP " + array.get(zTir,i), text_color=color.white, text_size=size.small, bgcolor=bg)

        // ── TRADES section — 3 rows per trade ──
        table.cell(tbl, 0, 10, "TRADES", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))
        table.cell(tbl, 1, 10, "", text_color=color.gray, text_size=size.small, bgcolor=color.rgb(8,8,12))

        // ── Short Trade (T2) ──
        color sBg = color.rgb(60,12,8)
        // Row 11: Entries
        table.cell(tbl, 0, 11, "S " + array.get(tTir,0), text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 1, 11, "Entry: " + str.tostring(array.get(tEn1,0), "#.##") + " - " + str.tostring(array.get(tEn3,0), "#.##"), text_color=color.white, text_size=size.small, bgcolor=sBg)

        // Row 12: SL | TP
        table.cell(tbl, 0, 12, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 1, 12, "SL: " + str.tostring(array.get(tSl,0), "#.##") + "  |  TP: " + str.tostring(array.get(tTp,0), "#.##"), text_color=color.white, text_size=size.small, bgcolor=sBg)

        // Row 13: Days + RRR
        table.cell(tbl, 0, 13, "", text_color=color.white, text_size=size.small, bgcolor=sBg)
        table.cell(tbl, 1, 13, array.get(tDE,0) + " > " + array.get(tDT,0) + "  |  R:R " + str.tostring(array.get(tRr,0), "#.#"), text_color=color.white, text_size=size.small, bgcolor=sBg)

        // ── Long Trade (T1) ──
        color lBg = color.rgb(0,40,40)
        // Row 14: Entries
        table.cell(tbl, 0, 14, "L " + array.get(tTir,1), text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 1, 14, "Entry: " + str.tostring(array.get(tEn1,1), "#.##") + " - " + str.tostring(array.get(tEn3,1), "#.##"), text_color=color.white, text_size=size.small, bgcolor=lBg)

        // Row 15: SL | TP
        table.cell(tbl, 0, 15, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 1, 15, "SL: " + str.tostring(array.get(tSl,1), "#.##") + "  |  TP: " + str.tostring(array.get(tTp,1), "#.##"), text_color=color.white, text_size=size.small, bgcolor=lBg)

        // Row 16: Days + RRR
        table.cell(tbl, 0, 16, "", text_color=color.white, text_size=size.small, bgcolor=lBg)
        table.cell(tbl, 1, 16, array.get(tDE,1) + " > " + array.get(tDT,1) + "  |  R:R " + str.tostring(array.get(tRr,1), "#.#"), text_color=color.white, text_size=size.small, bgcolor=lBg)

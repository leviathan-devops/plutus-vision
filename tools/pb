#!/usr/bin/env bash
# pb - thin helpers over the pinebox CLI for this build (session plutus-main).
#   pb shot NAME [chart|plot]        capture -> evidence/NAME.png (prints the path)
#   pb goto FROM TO [bt]             frame the IDE (or, with bt, the Backtest) chart on [FROM,TO] (ISO dates/times, UTC) through the page's own renderer
#   pb eval 'JS'                     evaluate JS in the page (returns JSON)
#   pb load FILE [PAIR] [TF]         load + run a .pine in the IDE
#   pb x ...                         raw pinebox verb with the session filled in
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH" XDG_RUNTIME_DIR=/run/user/0
S=plutus-main; ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CDP_PORT="$(pinebox list --session $S | jq -r '.instances[0].ports.cdp')"
CORE="$HOME/.omp/agent/extensions/computer-use-v2/core"
ev() { node "$CORE/cdp.mjs" "$CDP_PORT" evaluate "$1" | jq -c 'select(has("value")) | .value'; }
station_idle() { local p; p="$(ss -ltnp 2>/dev/null | grep ':9741 ' | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"; [ -n "$p" ] || return 0; [ "$(top -bn1 -p "$p" | tail -1 | awk '{print int($9)}')" -lt 25 ]; }
case "${1:-}" in
  shot) n="$2"; sec="${3:-chart}"; mkdir -p "$ROOT/evidence"; if [ "$sec" = full ]; then secarg=(); else secarg=(--section "$sec"); fi; pinebox shot --session $S --out "$ROOT/evidence/$n.png" "${secarg[@]}" | jq -r '.path' ;;
  eval) ev "$2" ;;
  load) pinebox load --session $S --pine "$2" ${3:+--pair "$3"} ${4:+--tf "$4"} 2>&1 | tail -1 | jq -c '{ok, status:.load.status_row, counts:.load.result.counts, bars:.load.result.bars, err:(.error // null)}' 2>/dev/null || pinebox load --session $S --pine "$2" ${3:+--pair "$3"} ${4:+--tf "$4"} 2>&1 | tail -3 ;;
  goto)
    f="$(date -u -d "$2" +%s)000"; t="$(date -u -d "$3" +%s)000"
    CH="window.PlutusPineShell?.chart"; [ "${4:-ide}" = bt ] && CH="window.PlutusBacktestChart?.api?.chart"
    ev "(function(){const P={chart:$CH}; const r=P?.chart?.rendererControl?.renderer; if(!r) return {absent:true};
      const b=r.bars, n=b.length; let i0=0,i1=n-1; for(let i=0;i<n;i++){ if(b[i].time<$f) i0=i; if(b[i].time<=$t) i1=i; }
      i0=Math.min(i0+1,n-1); const span=Math.max(i1-i0+1,5); const pad=Math.max(2,Math.round(span*0.04));
      r.animator?.stop(); r.panVelocity=0;
      const rt=-(n-1-i1)+pad; const bs=r.coords.width/((span+2*pad)*r.coords.spacingScale);
      let v; try{ v=r.clampViewport(bs, rt); }catch(e){ return {err:String(e)}; }
      r.coords.setViewport(v); r.targetBarSpacing=v.barSpacing; if(r.applyViewport) r.applyViewport(v); else r.requestRender?.();
      const vr=P.chart.getVisibleRange(); return {n,i0,i1,want:{from:$f,to:$t},got:vr,fromISO:new Date(vr.from).toISOString(),toISO:new Date(vr.to).toISOString(),v};})()" ;;
  export)   # pb export FILE [PAIR] [TF]: load in the IDE, press EXPORT TO BACKTEST, wait for the EXPORTED status
    pinebox tab --session $S --to pine >/dev/null; sleep 2
    pinebox load --session $S --pine "$2" --pair "${3:-DXY}" --tf "${4:-1H}" 2>&1 | grep -E "REFUSED|load  " | cut -c1-260
    ev "(function(){const b=document.querySelector('[data-act=export]'); b.click(); return 'clicked';})()" >/dev/null
    for i in $(seq 1 60); do
      st="$(ev "(function(){return [...document.querySelectorAll('.pine-shell *')].filter(e=>e.children.length==0 && /EXPORTED|EXPORT_/.test(e.textContent)).map(e=>e.textContent.slice(0,140)).join(' | ')})()")"
      case "$st" in *EXPORTED*|*EXPORT_*) echo "$st"; break ;; esac; sleep 2
    done ;;
  bt-keep) # pb bt-keep "Indicator Title": Backtest chart - after an export the script is already on the chart; remove every OTHER on-chart script (V1 stalls the engine here)
    pinebox tab --session $S --to backtest >/dev/null; sleep 1
    ev "(async function(){ const sl=ms=>new Promise(r=>setTimeout(r,ms)); const vis=e=>{const r=e.getBoundingClientRect(); return r.width>0&&r.height>0;}; const N=$(printf '%s' "$2" | jq -Rs .);
      const dlgOpen=()=>[...document.querySelectorAll('.vela-dialog-title')].some(e=>e.textContent.trim()==='Indicators'&&vis(e));
      if(!dlgOpen()){ const b=[...document.querySelectorAll('button')].find(b=>/Indicators/.test(b.textContent)&&vis(b)&&b.getBoundingClientRect().y<140&&b.getBoundingClientRect().y>90); if(!b) return {err:'no Indicators button'}; b.click(); await sl(900); }
      let removed=0, kept=0;
      for(let k=0;k<10;k++){ const rows=[...document.querySelectorAll('.vela-ip-trash')].filter(vis).map(t=>({t, name:(t.parentElement.querySelector('.vela-ip-name')||t.parentElement.parentElement.querySelector('.vela-ip-name')||{}).textContent}));
        const victim=rows.find((r,i)=>(r.name||'').trim()!==N || rows.findIndex(x=>(x.name||'').trim()===N)!==i); if(!victim) { kept=rows.length; break; } victim.t.click(); removed++; await sl(700); }
      const c=[...document.querySelectorAll('.vela-dialog-close')].find(vis); if(c) c.click(); return {removed,kept}; })()" ;;
  bt-apply) # pb bt-apply "Indicator Title": on the Backtest chart remove every on-chart script, then add the named one from My Scripts (verified)
    pinebox tab --session $S --to backtest >/dev/null; sleep 1
    JS_COMMON="const sl=ms=>new Promise(r=>setTimeout(r,ms)); const vis=e=>{const r=e.getBoundingClientRect(); return r.width>0&&r.height>0;}; const dlgOpen=()=>[...document.querySelectorAll('.vela-dialog-title')].some(e=>e.textContent.trim()==='Indicators'&&vis(e)); const openDlg=async()=>{ if(dlgOpen()) return true; const b=[...document.querySelectorAll('button')].find(b=>/Indicators/.test(b.textContent)&&vis(b)&&b.getBoundingClientRect().y<140&&b.getBoundingClientRect().y>90); if(!b) return false; b.click(); await sl(800); return dlgOpen(); }; const closeDlg=async()=>{ const c=[...document.querySelectorAll('.vela-dialog-close')].find(vis); if(c){ c.click(); await sl(400);} };"
    ev "(async function(){ $JS_COMMON if(!(await openDlg())) return {err:'no Indicators dialog'}; let removed=0; for(let k=0;k<10;k++){ const t=[...document.querySelectorAll('.vela-ip-trash')].find(vis); if(!t) break; t.click(); removed++; await sl(700); } await closeDlg(); return {removed}; })()"
    sleep 1
    ev "(async function(){ $JS_COMMON if(!(await openDlg())) return {err:'no Indicators dialog'}; const N=$(printf '%s' "$2" | jq -Rs .);
      const inp=[...document.querySelectorAll('input')].find(i=>vis(i)&&/Search/.test(i.placeholder||'')); if(inp){ inp.focus(); const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set; set.call(inp,N); inp.dispatchEvent(new Event('input',{bubbles:true})); await sl(800); }
      const row=[...document.querySelectorAll('.vela-ip-name')].find(e=>vis(e)&&e.textContent.trim()===N); if(!row) { await closeDlg(); return {err:'script not in list'}; }
      (row.closest('button,[role=button],.vela-ip-row')||row.parentElement).click(); await sl(900);
      const onchart=[...document.querySelectorAll('.vela-ip-trash')].filter(vis).length; await closeDlg(); await sl(500);
      const legend=[...document.querySelectorAll('*')].filter(e=>e.children.length==0&&e.textContent.trim()===N&&vis(e)).length;
      return {onchart,legend}; })()" ;;
  ide) # pb ide FILE [PAIR] [TF] [KEY=VALUE ...] : Pine IDE tab - load FILE, apply input overrides the way the IDE's own panel does (rewrite defaults in the editor), run on the IDE's FULL bar set (not the default newest 400)
    f="$2"; pair="${3:-DXY}"; tf="${4:-1H}"; shift 4 2>/dev/null || shift $#
    tmp="$(mktemp --suffix=.pine)"; cp "$f" "$tmp"
    for kv in "$@"; do k="${kv%%=*}"; v="${kv#*=}"; sed -i -E "s/^($k[[:space:]]*=[[:space:]]*input\.[a-z]+\()[^,]+,/\1$v,/" "$tmp"; done
    pinebox tab --session $S --to pine >/dev/null; sleep 1
    ev "(async function(){const P=window.PlutusPineShell; if(!P) return {err:'no shell'}; const sl=ms=>new Promise(r=>setTimeout(r,ms));
      P.editor.setSource($(jq -Rs . < "$tmp")); P.editor.flush(); await sl(2500);
      let rr=null;
      for(let k=0;k<4;k++){ await P.loadBars({pair:'$pair', timeframe:'$tf', limit:20000}); await sl(2500); rr=await P.run({silent:false}); if(!rr.ok) return {err:'RUN_FAILED', code:rr.code, detail:String(rr.error||'').slice(0,300)}; await sl(2000); if(rr.run.bars>400) break; }
      const d=P.chart.drawings.toJSON().drawings; const wk=[...new Set(d.filter(x=>x.type==='box').map(x=>x.anchors[0].time))].sort().map(t=>new Date(t).toISOString().slice(0,10));
      return {title:rr.run.title, counts:rr.run.counts, runBars:rr.run.bars, onChart:d.length, weeks:wk};})()"
    rm -f "$tmp" ;;
  ide-input) # pb ide-input KEY VALUE [KEY VALUE ...] : Pine IDE tab - open the script's inputs panel (legend gear), set inputs by variable name, Apply
    shift
    if [ "$(ev "(function(){return document.querySelector('.pv-dlg')?1:0})()")" != 1 ]; then
      R="$(ev "(function(){const vis=e=>{const r=e.getBoundingClientRect(); return r.width>0&&r.height>0;}; const el=[...document.querySelectorAll('.pine-shell *, .vela-workspace *')].filter(e=>e.children.length==0&&vis(e)&&e.getBoundingClientRect().y<140&&e.getBoundingClientRect().y>100&&e.getBoundingClientRect().x>600&&/^Plutus Vision/.test(e.textContent.trim())); const name=el[0]; if(!name) return {err:1}; const r=name.getBoundingClientRect(); return {r:Math.round(r.right),y:Math.round(r.y+r.height/2),t:name.textContent.trim()};})()")"
      pinebox drive --session $S --action click --x "$(jq '.r+38' <<<"$R")" --y "$(jq '.y' <<<"$R")" >/dev/null; sleep 1
    fi
    while [ $# -ge 2 ]; do
      ev "(function(){const i=document.querySelector('.pv-dlg [data-pv-input=\"$1\"]'); if(!i) return {err:'no input $1'}; if(i.type==='checkbox'){ const want=('$2'==='true'); if(i.checked!==want) i.click(); } else { const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set; set.call(i,'$2'); i.dispatchEvent(new Event('input',{bubbles:true})); i.dispatchEvent(new Event('change',{bubbles:true})); } return {set:'$1',to:i.type==='checkbox'?i.checked:i.value};})()"
      shift 2
    done
    ev "(function(){const b=[...document.querySelectorAll('.pv-dlg button')].find(b=>b.textContent.trim()==='Apply'); if(!b) return {err:'no Apply'}; b.click(); return {applied:true};})()" ;;
  set-input) # pb set-input "Indicator Title" "label regex" VALUE : open the script's Settings dialog on the visible chart, set one input, press Ok
    ev "(async function(){const vis=e=>{const r=e.getBoundingClientRect(); return r.width>0&&r.height>0;}; const sl=ms=>new Promise(r=>setTimeout(r,ms));
      const name=[...document.querySelectorAll('*')].find(e=>e.children.length==0&&e.textContent.trim()===$(printf '%s' "$2" | jq -Rs .)&&vis(e)&&!e.closest('.vela-dialog,[class*=dialog]')); if(!name) return {err:'legend not found'};
      const b=[...name.parentElement.parentElement.querySelectorAll('button,[role=button]')].find(b=>(b.getAttribute('aria-label')||b.title)==='Settings'); if(!b) return {err:'no settings button'}; b.click(); await sl(900);
      const dlg=[...document.querySelectorAll('.vela-dialog')].find(d=>vis(d)&&d.querySelector('.vela-dialog-title')&&d.querySelector('.vela-dialog-title').textContent.trim()===$(printf '%s' "$2" | jq -Rs .)); if(!dlg) return {err:'settings dialog not found'};
      const rx=new RegExp($(printf '%s' "$3" | jq -Rs .),'i'); let target=null;
      const seq=[...dlg.querySelectorAll('*')].filter(e=>e.tagName==='INPUT'||(e.children.length==0&&e.textContent.trim()));
      for(let i=0;i<seq.length&&!target;i++){ const e=seq[i]; if(e.tagName!=='INPUT') continue;
        const prev=seq.slice(0,i).reverse().find(x=>x.tagName!=='INPUT'); const next=seq.slice(i+1).find(x=>x.tagName!=='INPUT');
        const lab=e.type==='checkbox'?(next?next.textContent:''):(prev?prev.textContent:''); if(rx.test(lab)) target=e; }
      if(!target) return {err:'input not found'};
      const val=$(printf '%s' "$4" | jq -Rs .);
      if(target.type==='checkbox'){ const want=(val==='true'||val==='1'); if(target.checked!==want) target.click(); }
      else { const set=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set; set.call(target,val); target.dispatchEvent(new Event('input',{bubbles:true})); target.dispatchEvent(new Event('change',{bubbles:true})); }
      await sl(300); const ok=[...dlg.querySelectorAll('button')].find(b=>b.textContent.trim()==='Ok'); if(!ok) return {err:'no Ok'}; ok.click(); return {ok:true,type:target.type,val};})()" ;;
  shotc) # pb shotc NAME : capture and crop to the chart pane (smaller frame)
    n="$2"; mkdir -p "$ROOT/evidence"; pinebox shot --session $S --out "$ROOT/evidence/$n.full.png" >/dev/null && convert "$ROOT/evidence/$n.full.png" -crop 1262x622+26+88 +repage "$ROOT/evidence/$n.png" && rm -f "$ROOT/evidence/$n.full.png" && echo "$ROOT/evidence/$n.png" ;;
  wait-engine) # pb wait-engine: block until the station engine has been idle for 15 s in a row (bounded: 8 minutes)
    quiet=0
    for i in $(seq 1 160); do sleep 3; if station_idle; then quiet=$((quiet+1)); else quiet=0; fi; [ $quiet -ge 5 ] && { echo idle; exit 0; }; done; echo "still busy"; exit 1 ;;
  x) shift; v="$1"; shift; pinebox "$v" --session $S "$@" ;;
  *) sed -n 2,8p "$0" ;;
esac

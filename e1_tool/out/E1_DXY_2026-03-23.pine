//@version=6
indicator("PLUTUS VISION DXY 2026-03-23", overlay=true, max_boxes_count=2000, max_labels_count=2000, max_lines_count=2000)
// week of 2026-03-23 (DXY); every number computed by e1_tool from data closed before the anchor 2026-03-23 06:00 UTC (Monday London open)
show_ip = input.bool(true, "E1 IP Zones")
show_disc = input.bool(true, "E1 Discovery Zones (levels to watch)")
show_lv = input.bool(true, "E1 levels inside IP zones")
show_lsz = input.bool(true, "E1 LSZ")
show_opt = input.bool(true, "E1 Option Strikes")
show_sd = input.bool(true, "E1 Supply / Demand 4H + 1H")
show_ltf = input.bool(false, "E1 Supply / Demand 30m + 15m")
show_lq = input.bool(true, "E1 Liquidity ladder 1H (V1 data)")
show_lq4 = input.bool(true, "E1 Liquidity bands 4H (V1 data)")
show_ob = input.bool(false, "V1 order blocks (data)")
show_far = input.bool(false, "E1 zones beyond this week's reach")
show_v1s = input.bool(false, "V1 4H liquidity bands standing alone (the sealed V1 draws them)")
show_e2 = input.bool(true, "E2 Shape chain")
show_e3 = input.bool(true, "E3 Trade setups")
show_tbl = input.bool(true, "Info Table")
isPair = str.contains(syminfo.ticker, "DXY")
// E3 trade spans (D-146): the bar each order fills and the bar it exits, tracked on the chart's own candles
e3bw = nz(time - time[1], 3600000)
var int e3E0 = na
var int e3X0 = na
var int e3R0 = 0
var int e3E1 = na
var int e3X1 = na
var int e3R1 = 0
var int e3E2 = na
var int e3X2 = na
var int e3R2 = 0
var int e3E3 = na
var int e3X3 = na
var int e3R3 = 0
var bool e3V0 = false
if isPair and na(e3E0) and not e3V0 and time >= 1774245600000 and time < 1774299600000 and high >= 100.067
    if (not na(e3E1) and na(e3X1)) or (not na(e3E2) and na(e3X2))
        e3V0 := true
    else
        e3E0 := time
if isPair and not na(e3E0) and na(e3X0)
    if high >= 100.214
        e3X0 := time
        e3R0 := -1
    else if low <= 99.577
        e3X0 := time
        e3R0 := 1
var bool e3V1 = false
if isPair and na(e3E1) and not e3V1 and time >= 1774299600000 and time < 1774386000000 and high >= 100.067
    if (not na(e3E0) and na(e3X0)) or (not na(e3E2) and na(e3X2))

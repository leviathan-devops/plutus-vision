// ═════════════════════════════════════════════════════════════════════════════
//  E1 RENDER — the INSTITUTIONAL PRESSURE MAP.  W4: the trident_v8 port.
//
//  This is the v8 renderer, PORTED VERBATIM (trident_v8.pine:43-65, :67-155,
//  :112-155, :157-158, :352-365) and re-anchored to the chart's own week. The
//  colour is v8's exact ladder — RES=RED, MID=ORANGE, SUP=TEAL, each with six
//  pressure-tier shades — so the operator reads the SAME colours as the reference.
//
//  THE THREE MOVES (blueprint §4):
//    PORT   the colour ladder + zfill/zbord + the IP block, byte-for-byte
//    ANCHOR to the chart (`e1_injected_anchor_ms` derived from the chart), not now()
//    INJECT the live payload (top/bottom/cat/confluence), one derived field = zCat
//
//  It consumes ONLY the injected payload; it never reads the v1 liquidity arrays.
// ═════════════════════════════════════════════════════════════════════════════

// ── INPUTS ──────────────────────────────────────────────────────────────────
e1Enabled   = input.bool(true, "Show the E1 institutional pressure map", group = "E1 zones")
e1MaxZones  = input.int(6, "MAX zones", minval = 1, maxval = 6, group = "E1 zones")
e1BackWeeks = input.int(2, "Hindsight: weeks before the anchor", minval = 0, maxval = 8, group = "E1 zones")
e1FwdWeeks  = input.int(3, "Foresight: weeks after the anchor", minval = 0, maxval = 8, group = "E1 zones")
e1ShowFill  = input.bool(true, "Fill the zones", group = "E1 zones")

// ── THE COLOUR LADDER — trident_v8.pine:43-65, VERBATIM ─────────────────────
// IP Resistance (RED) — 6 pressure tiers
R_F1 = color.new(color.rgb(180,40,30), 70),  R_B1 = color.rgb(180,40,30)
R_F2 = color.new(color.rgb(200,60,35), 70),  R_B2 = color.rgb(200,60,35)
R_F3 = color.new(color.rgb(210,80,40), 70),  R_B3 = color.rgb(210,80,40)
R_F4 = color.new(color.rgb(220,100,50), 70), R_B4 = color.rgb(220,100,50)
R_F5 = color.new(color.rgb(230,130,60), 70), R_B5 = color.rgb(230,130,60)
R_F6 = color.new(color.rgb(240,160,90), 70), R_B6 = color.rgb(240,160,90)
// IP Equilibrium (ORANGE #FF9800) — 6 pressure tiers
G_F1 = color.new(color.rgb(255,152,0), 70),   G_B1 = color.rgb(255,152,0)
G_F2 = color.new(color.rgb(245,145,10), 70),  G_B2 = color.rgb(245,145,10)
G_F3 = color.new(color.rgb(235,138,20), 70),  G_B3 = color.rgb(235,138,20)
G_F4 = color.new(color.rgb(225,131,30), 70),  G_B4 = color.rgb(225,131,30)
G_F5 = color.new(color.rgb(215,124,40), 70),  G_B5 = color.rgb(215,124,40)
G_F6 = color.new(color.rgb(205,117,50), 70),  G_B6 = color.rgb(205,117,50)
// IP Support (TEAL) — 6 pressure tiers
T_F1 = color.new(color.rgb(0,150,150), 70),  T_B1 = color.rgb(0,150,150)
T_F2 = color.new(color.rgb(0,170,160), 70),  T_B2 = color.rgb(0,170,160)
T_F3 = color.new(color.rgb(20,180,170), 70), T_B3 = color.rgb(20,180,170)
T_F4 = color.new(color.rgb(40,190,180), 70), T_B4 = color.rgb(40,190,180)
T_F5 = color.new(color.rgb(60,200,190), 70), T_B5 = color.rgb(60,200,190)
T_F6 = color.new(color.rgb(80,210,200), 70), T_B6 = color.rgb(80,210,200)

// ── zfill(cat, deg) — trident_v8.pine:67-155, VERBATIM (the FILL) ───────────
f_e1Zfill(string cat, string deg) =>
    color result = color.gray
    if cat == "RES"
        if deg == "EXTREME"
            result := R_F1
        else if deg == "HEAVY"
            result := R_F2
        else if deg == "MODERATE-HEAVY"
            result := R_F3
        else if deg == "MODERATE"
            result := R_F4
        else if deg == "LIGHT"
            result := R_F5
        else
            result := R_F6
    else if cat == "MID"
        if deg == "EXTREME"
            result := G_F1
        else if deg == "HEAVY"
            result := G_F2
        else if deg == "MODERATE-HEAVY"
            result := G_F3
        else if deg == "MODERATE"
            result := G_F4
        else if deg == "LIGHT"
            result := G_F5
        else
            result := G_F6
    else if cat == "SUP"
        if deg == "EXTREME"
            result := T_F1
        else if deg == "HEAVY"
            result := T_F2
        else if deg == "MODERATE-HEAVY"
            result := T_F3
        else if deg == "MODERATE"
            result := T_F4
        else if deg == "LIGHT"
            result := T_F5
        else
            result := T_F6
    else
        result := T_F4
    result

// ── zbord(cat, deg) — trident_v8.pine:112-155, VERBATIM (the BORDER) ────────
f_e1Zbord(string cat, string deg) =>
    color result = color.gray
    if cat == "RES"
        if deg == "EXTREME"
            result := R_B1
        else if deg == "HEAVY"
            result := R_B2
        else if deg == "MODERATE-HEAVY"
            result := R_B3
        else if deg == "MODERATE"
            result := R_B4
        else if deg == "LIGHT"
            result := R_B5
        else
            result := R_B6
    else if cat == "MID"
        if deg == "EXTREME"
            result := G_B1
        else if deg == "HEAVY"
            result := G_B2
        else if deg == "MODERATE-HEAVY"
            result := G_B3
        else if deg == "MODERATE"
            result := G_B4
        else if deg == "LIGHT"
            result := G_B5
        else
            result := G_B6
    else if cat == "SUP"
        if deg == "EXTREME"
            result := T_B1
        else if deg == "HEAVY"
            result := T_B2
        else if deg == "MODERATE-HEAVY"
            result := T_B3
        else if deg == "MODERATE"
            result := T_B4
        else if deg == "LIGHT"
            result := T_B5
        else
            result := T_B6
    else
        result := T_B4
    result

// ── pressureLbl(deg) — trident_v8.pine:157-158, VERBATIM ────────────────────
f_e1PressureLbl(string deg) =>
    deg == "EXTREME" ? "Extreme" : deg == "HEAVY" ? "Heavy" : (deg == "MODERATE_HEAVY" or deg == "MODERATE-HEAVY") ? "Moderate-Heavy" : deg == "MODERATE" ? "Moderate" : deg == "LIGHT" ? "Light" : "Minimal"

// ── THE DEGREE — confluence → v8's literal vocabulary (hyphen, the tower's branch) ──
f_e1Degree(int c) =>
    c >= 12 ? "EXTREME" :
     c >= 10 ? "HEAVY" :
     c >=  8 ? "MODERATE_HEAVY" :
     c >=  6 ? "MODERATE" :
     c >=  4 ? "LIGHT" : "MINIMAL"

// ── calcZFP(tp, bt, pair) — trident_v8.pine:334-338, VERBATIM ────────────────
// zone width as a percentage of the pair's typical weekly range.
f_e1CalcZFP(float tp, float bt, string pair) =>
    float refR = pair == "DXY" ? 1.60 : (pair == "EUR/USD" or pair == "GBP/USD") ? 0.0200 : 0.0150
    math.round((tp - bt) / refR * 100.0)

// ── THE PAIR — the chart's own (trident_v8.pine:120-126 pair detection) ──────
// The ZFP reference range is pair-specific; the chart tells us which pair.
_e1Ticker = str.upper(str.replace(syminfo.ticker, "/", ""))
_e1Pair = str.contains(_e1Ticker, "DXY") ? "DXY" :
          str.contains(_e1Ticker, "EURUSD") ? "EUR/USD" :
          str.contains(_e1Ticker, "GBPUSD") ? "GBP/USD" :
          str.contains(_e1Ticker, "AUDUSD") ? "AUD/USD" : "DXY"

// ── THE PAYLOAD (injected typed arrays; the builder emits these) ────────────
e1PayloadTop  = e1_injected_top
e1PayloadBot  = e1_injected_bottom
e1PayloadConf = e1_injected_confluence
e1PayloadCat  = e1_injected_cat
e1PayloadDeg  = e1_injected_degree
e1PayloadZfp  = e1_injected_zfp
e1PayloadId   = e1_injected_id
e1_anchor_ms  = e1_injected_anchor_ms
e1WeekTag     = e1_injected_week_tag

// ── THE 2×17 INFO TABLE (trident_v8.pine:178, :390-427) — the E1+E2 summary block. ──────
// Declared once at the global scope (Pine v6 requires the `var table` outside the render fn).
var table e1_tbl = table.new(position.top_right, 2, 17, bgcolor = color.new(color.black, 10), border_color = color.rgb(40,40,45), border_width = 1)

// ── THE PRICE SCALE — THE ZONES MUST FIT ────────────────────────────────────
// The chart autoscales to the BARS. The zones extend above/below the recent bars, so the
// upper zones (the resistance levels) fell OFF the top edge (the operator: "cut off"). Two
// invisible plots (fully transparent) pull the price scale to include the whole zone range,
// so every zone renders. The zones are price-ASCENDING, so [0] is the floor and the LAST is
// the ceiling.
_e1ZHi = array.size(e1PayloadTop) > 0 ? array.get(e1PayloadTop, array.size(e1PayloadTop) - 1) : na
_e1ZLo = array.size(e1PayloadBot) > 0 ? array.get(e1PayloadBot, 0) : na
plot(_e1ZHi, "E1 ceiling (scale)", color = color.new(color.white, 100))
plot(_e1ZLo, "E1 floor (scale)", color = color.new(color.white, 100))

// ── THE RENDER ──────────────────────────────────────────────────────────────
f_e1Render() =>
    _n = array.size(e1PayloadTop)
    // THE ANCHOR — THE TARGET WEEK'S MONDAY, in TIME (`e1_anchor_ms`). The canon Part X
    // Principle 5: "All Drawings Use xloc=xloc.bar_time. Bar index coordinates are
    // PROHIBITED." The zones extend PAST the chart's last bar (the target week is the
    // FUTURE); a bar_index right edge beyond the last bar is DROPPED by the renderer, so
    // every E1 box vanished on a real-time chart (measured 2026-10-08). TIME coordinates
    // draw into the future span exactly as the E2 path does.
    // THE OPERATOR'S APPROVED WIDTH (2026-10-06): ~2 weeks BACK to the left of the target
    // Monday and ~1 week forward — the wide band the operator approved ("wide to the left
    // side … you could see back like an extra week or two. Perfect.").
    _lx = e1_anchor_ms - 2 * 604800000        // 2 weeks before the anchor Monday (ms)
    _rx = e1_anchor_ms + 604800000            // 1 week after the anchor Monday (ms)

    // THE IP ZONES — trident_v8.pine:352-365, the loop, re-anchored to bar_index bounds.
    // Colour by zCat (RES|MID|SUP) × degree — the v8 ladder. The band height is inflated so
    // a zero-height zone (one confluent level) reads as a band, not a vanished hairline.
    if _n > 0
        for i = 0 to _n - 1
            if i >= _n
                break
            if i >= e1MaxZones
                break
            _cat = array.get(e1PayloadCat, i)
            _c   = array.get(e1PayloadConf, i)
            // THE DEGREE — the synthesized role degree (HEAVY|MODERATE-HEAVY|MODERATE|...) when
            // the payload carries it; else the confluence-derived fallback.
            _deg = array.size(e1PayloadDeg) > i ? array.get(e1PayloadDeg, i) : f_e1Degree(_c)
            if _deg != "MINIMAL"
                _top = array.get(e1PayloadTop, i)
                _bot = array.get(e1PayloadBot, i)
                _mid = (_top + _bot) / 2
                // THE RENDERED BAND — the FULL [top, bottom] range (the v8 draws each IP zone at
                // its whole range). A NARROW band left the RES/SUP boxes buried under the LSZ
                // green behind them (the reviewers' B1: "the Upper IP Resistance box is GREEN").
                // Pair-relative floor so a near-zero-width zone still reads as a band.
                _hw = math.max((_top - _bot) * 0.5, _mid * 0.0004)
                box.new(_lx, _mid + _hw, _rx, _mid - _hw,
                     xloc = xloc.bar_time,
                     bgcolor = f_e1Zfill(_cat, _deg),
                     border_color = f_e1Zbord(_cat, _deg),
                     border_width = 2,
                     border_style = line.style_solid)
                // THE LABEL — the reference idiom: at the MID, style_none, white, size.normal.
                // A subtle dark backing keeps the white text legible on the zone fill.
                _lbl = array.get(e1PayloadId, i) + " | " + f_e1PressureLbl(_deg) + " | " + str.tostring(array.get(e1PayloadZfp, i)) + "% ZFP"
                label.new((_lx + _rx) / 2, _mid, _lbl, xloc = xloc.bar_time, style = label.style_none, textcolor = color.white, size = size.normal)
    0

if e1Enabled and barstate.islast
    // ── THE LSZ (trident_v8.pine:368-377): GREEN filled boxes, NO LABELS, the same x-span as
    // the IP zones. DRAWN FIRST so the IP zones render ON TOP — the reference draws the LSZ
    // behind the IP boxes; drawing them after buried the RES zones under green (the reviewers'
    // B1: "the Upper IP Resistance box is GREEN"). ACTIVE = a brighter/thicker green. ────────
    _nl = array.size(e1_injected_lsz_top)
    if _nl > 0
        for i = 0 to _nl - 1
            if i >= _nl
                break
            _lt = array.get(e1_injected_lsz_top, i)
            _lb = array.get(e1_injected_lsz_bottom, i)
            _lp = array.get(e1_injected_lsz_pri, i)
            _lact = _lp == "ACTIVE"
            box.new(e1_anchor_ms - 2 * 604800000, _lt, e1_anchor_ms + 604800000, _lb,
                 xloc = xloc.bar_time,
                 bgcolor = _lact ? color.new(color.rgb(80,230,100), 60) : color.new(color.rgb(40,180,80), 70),
                 border_color = _lact ? color.rgb(80,230,100) : color.rgb(40,180,80),
                 border_width = 1)
    // ── THE IP ZONES (on top of the LSZ). ──────────────────────────────────────────────────
    f_e1Render()
    // ── THE TABLE (the v8's 2×17 block). Rows: 0 header · 1 Chain · 2 Days · 3 ZONES · 4-8 the
    // five zone rows. The TRADES rows (Engine 3) are out of scope and left blank. ────────────
    if array.size(e1_injected_tbl_row) > 0
        table.cell(e1_tbl, 0, 0, "PLUTUS VISION", text_color = color.gray, text_size = size.small, bgcolor = color.rgb(8,8,12))
        table.cell(e1_tbl, 1, 0, array.get(e1_injected_tbl_pair, 0) + " " + array.get(e1_injected_tbl_week, 0), text_color = color.rgb(100,150,255), text_size = size.small, bgcolor = color.rgb(20,20,40))
        table.cell(e1_tbl, 0, 1, "Chain", text_color = color.gray, text_size = size.small)
        table.cell(e1_tbl, 1, 1, array.get(e1_injected_chain, 0), text_color = color.white, text_size = size.small)
        table.cell(e1_tbl, 0, 2, "Days", text_color = color.gray, text_size = size.small)
        table.cell(e1_tbl, 1, 2, array.get(e1_injected_days, 0), text_color = color.white, text_size = size.small)
        table.cell(e1_tbl, 0, 3, "ZONES", text_color = color.gray, text_size = size.small, bgcolor = color.rgb(8,8,12))
        table.cell(e1_tbl, 1, 3, "", text_color = color.gray, text_size = size.small, bgcolor = color.rgb(8,8,12))
        for i = 0 to array.size(e1_injected_tbl_row) - 1
            if i >= array.size(e1_injected_tbl_row)
                break
            // THE V8 TAG + BG (trident_v8.pine:403-404): the middle zone's tag is "EQ" (not
            // "MID"), and the cell bg is category-tinted.
            _tc = array.get(e1PayloadCat, i)
            _tag = _tc == "RES" ? "RES" : _tc == "MID" ? "EQ" : "SUP"
            _bg = _tc == "RES" ? color.rgb(60,12,8) : _tc == "MID" ? color.rgb(50,38,8) : color.rgb(0,40,40)
            table.cell(e1_tbl, 0, 4 + i, _tag, text_color = color.white, text_size = size.small, bgcolor = _bg)
            table.cell(e1_tbl, 1, 4 + i, array.get(e1_injected_tbl_row, i), text_color = color.white, text_size = size.small, bgcolor = _bg)

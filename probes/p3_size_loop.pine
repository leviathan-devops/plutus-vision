//@version=6
indicator("p3", overlay=true, max_boxes_count=500)
type br_t
    box bx
    bool br
var array<br_t> arr = array.new<br_t>(1, br_t.new())
if bar_index == 10
    arr.unshift(br_t.new(box.new(bar_index-1, high, bar_index+1, low), false))
n = arr.size()
if n > 1
    for i = 1 to n - 1
        x = arr.get(i)
        if not na(x.bx)
            x.bx.set_right(bar_index)
plot(close, "c")

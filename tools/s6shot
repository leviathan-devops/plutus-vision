#!/usr/bin/env bash
# s6shot PAIR MONDAY [OUT.png] : S6 evidence - the generated Pine on the SAME Backtest chart as the unedited sealed V1 (two-week view ending on the forecast week's Friday).
# Steps: one command -> one Pine; export it to the Backtest room; PUT the sealed V1's bytes into the room store; new replay session (every store script is added to its chart);
# wait for the engine (V1 needs 1-2 minutes); frame; capture; then take V1 out of the store again and restart Pinebox (V1 starves later sessions, LS-15).
set -u; R="$(cd "$(dirname "$0")/.." && pwd)"; p="$1"; m="$2"; out="${3:-$R/evidence/s6_${p}_1H_${m}_with_v1.png}"
export PATH=$HOME/.local/bin:$PATH XDG_RUNTIME_DIR=/run/user/0
(cd "$R/e1_tool" && python3 plutus.py "$m" "$p" >/dev/null)
"$R/tools/pb" export "$R/e1_tool/out/PLUTUS_${p}_${m}.pine" "$p" 1H | tail -1
python3 - "$R" <<'PY'
import json, sys, urllib.request
src = open(sys.argv[1] + '/indicator/plutus-vision-v1.sealed.pine').read()
req = urllib.request.Request('http://127.0.0.1:9443/indicators', data=json.dumps({'name': 'Plutus Vision v1', 'script': src}).encode(), headers={'content-type': 'application/json'}, method='PUT')
print('sealed V1 in the room store:', json.loads(urllib.request.urlopen(req, timeout=30).read()).get('ok'))
PY
fri="$(date -u -d "$m + 4 days" +%F)"
pinebox tab --session plutus-main --to backtest >/dev/null; sleep 2
pinebox backtest --session plutus-main --op create --name "s6-$p-$m-$$" --symbol "$p" --start "${fri}T20:00" --end "$(date -u -d "$fri + 7 days" +%F)T20:00" --tf 1h | tail -1 | cut -c1-80
sleep 20; "$R/tools/pb" wait-engine | tail -1
"$R/tools/pb" goto "$(date -u -d "$m - 8 days" +%F)T00:00" "$(date -u -d "$m + 5 days" +%F)" bt >/dev/null; sleep 3
pinebox shot --session plutus-main --out "$out" | tail -1 | cut -c1-120
curl -s -X DELETE -H 'content-type: application/json' -d '{"name":"Plutus Vision v1"}' http://127.0.0.1:9443/indicators >/dev/null
pinebox down --session plutus-main >/dev/null 2>&1; pinebox up --session plutus-main --adapter xvfb >/dev/null 2>&1; echo "$out"

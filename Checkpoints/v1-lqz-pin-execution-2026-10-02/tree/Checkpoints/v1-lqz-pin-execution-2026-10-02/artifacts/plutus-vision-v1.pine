indicator("Plutus Vision v1", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
lqzV1PoolMid()  => float(na)
lqzV1PoolRail() => 0.0
lqzV1SweepPrc() => float(na)
lqzV1VoidLo()   => float(na)
lqzV1VoidHi()   => float(na)



